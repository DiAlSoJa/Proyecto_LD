<Window x:Class="LD.FormsX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMS 2.0"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Login: Botón primario (#1D4B9F) con hover/pressed -->
            <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1D4B9F"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#163D8A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F2D6E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Login: Botón cerrar con hover -->
            <Style x:Key="LoginCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="#1D4B9F"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#D0D0D0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Margin="16"
                Background="#F7F7F7"
                CornerRadius="12"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Direction="270"/>
            </Border.Effect>
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel izquierdo -->
                <Grid Grid.Column="0" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Width="28" Height="18" CornerRadius="3" Background="#1D4B9F"/>
                            <TextBlock Text="LMS 2.0"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#111111"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="BtnClose"
                                Style="{StaticResource LoginCloseButtonStyle}"
                                Click="BtnClose_Click"/>
                    </Grid>

                    <!-- Formulario -->
                    <Border x:Name="LoginPanel"
                            Grid.Row="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,10,0,20">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Width="250">

                                <TextBlock Text="Usuario"
                                           FontSize="13"
                                           Foreground="#222222"
                                           Margin="0,0,0,6"/>

                                <TextBox x:Name="txtUsuario"
                                         Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Ingrese su usuario"
                                         Style="{StaticResource RoundedTextBoxStyle}"
                                         KeyDown="txtUsuario_KeyDown"/>

                                <TextBlock Text="Contraseña"
                                           FontSize="13"
                                           Foreground="#222222"
                                           Margin="0,18,0,6"
                                            Tag="Ingrese su contraseña"/>

                                <Grid>
                                    <PasswordBox x:Name="txtPassword"
                                                 PasswordChanged="txtPassword_PasswordChanged">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource RoundedPasswordBoxStyle}">
                                                <Setter Property="Padding" Value="10,0,34,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                        <PasswordBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                                        </PasswordBox.InputBindings>
                                    </PasswordBox>

                                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                            >
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
                                                <Setter Property="Padding" Value="10,0,34,0"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Width="28" Height="28"
                                            Margin="0,0,5,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Command="{Binding TogglePasswordVisibilityCommand}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#888888">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE7B3;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                            <Setter Property="Text" Value="&#xED1A;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>

                                <Button Content="Iniciar sesión"
                                        Margin="0,24,0,0"
                                        Command="{Binding LoginCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LoginPrimaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                </StackPanel>

                                <!-- Overlay de carga -->
                                <Border Background="#AAFFFFFF"
                                        CornerRadius="12"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <ProgressBar Width="180"
                                                 Height="8"
                                                 IsIndeterminate="True"/>
                                    <TextBlock Text="Validando credenciales..."
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="#1D4B9F"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding Version}"
                               FontSize="12"
                               Foreground="#666666"
                               HorizontalAlignment="Left"/>
                </Grid>

                <!-- Panel derecho -->
                <Border Grid.Column="1"
                        Background="#1D4B9F"
                        CornerRadius="12"
                        Margin="10,0,0,0">
                    <Grid>
                        <Rectangle Opacity="0.08">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Resources/Images/logo.png"
                                            Stretch="Uniform"
                                            AlignmentX="Center"
                                            AlignmentY="Center"/>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Image Source="/Resources/Images/logo.png"
                                   Width="220"
                                   Margin="0,0,0,20"
                                   Opacity="0.95">
                                <Image.Effect>
                                    <DropShadowEffect Color="#1D4B9F"
                              BlurRadius="35"
                              ShadowDepth="0"/>
                                </Image.Effect>
                            </Image>

                            <TextBlock Text="LMS 2.0"
                                       Foreground="White"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Warehouse System"
                                       Foreground="#D6D6D6"
                                       FontSize="13"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>