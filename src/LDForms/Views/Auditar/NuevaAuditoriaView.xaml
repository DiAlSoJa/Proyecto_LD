<Window x:Class="LD.FormsX.Views.Auditar.NuevaAuditoriaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nueva auditoría"
        Height="760"
        Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#F3F4F6"
            CornerRadius="14"
            BorderBrush="#D1D5DB"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#0B8E00"
                    CornerRadius="14,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Nueva auditoría"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            x:Name="BtnCloseHeader"
                            Content="✕"
                            Click="BtnCerrar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1"
                  Margin="18,16,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Fila 1 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Requisición:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#111827"/>

                    <TextBox x:Name="txtRequisicion"
                             Grid.Column="1"
                             Height="30"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             BorderBrush="#9CA3AF"
                             BorderThickness="1"
                             Background="White"/>

                    <TextBlock Grid.Column="3"
                               Text="Kitting:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#111827"/>

                    <TextBox x:Name="txtKitting"
                             Grid.Column="4"
                             Height="30"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             BorderBrush="#9CA3AF"
                             BorderThickness="1"
                             Background="White"
                             Margin="0,0,40,0"/>
                </Grid>

                <!-- Fila 2 -->
                <Grid Grid.Row="2"
                      HorizontalAlignment="Left"
                      Margin="165,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="rbIzquierda"
                                 Grid.Column="0"
                                 Content="Izquierda"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 GroupName="Lado"/>

                    <RadioButton x:Name="rbDerecha"
                                 Grid.Column="2"
                                 Grid.ColumnSpan="2"
                                 Content="Derecha"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 GroupName="Lado"/>
                </Grid>

                <!-- Fila 3 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Identificador:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#111827"/>

                    <TextBox x:Name="txtIdentificador"
                             Grid.Column="1"
                             Height="30"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             BorderBrush="#9CA3AF"
                             BorderThickness="1"
                             Background="White"/>
                </Grid>

                <!-- Vista -->
                <Border Grid.Row="6"
                        Margin="155,0,155,0"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="470"
                              Height="580">

                            <!-- Fondo -->
                            <Border Background="#F3F4F6"
                                    CornerRadius="8"/>

                            <!-- Tarima -->
                            <Grid Width="360"
                                  Height="540"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">

                                <!-- Cabecera -->
                                <Grid VerticalAlignment="Top"
                                      Height="85">
                                    <Border Background="#65B51D"
                                            CornerRadius="16,16,6,6"
                                            Height="70"
                                            Margin="26,0,26,0"/>

                                    <Border Background="#13294B"
                                            CornerRadius="8"
                                            Height="24"
                                            Margin="54,0,54,0"
                                            VerticalAlignment="Top"/>

                                    <Rectangle Fill="#13294B"
                                               Width="18"
                                               Height="46"
                                               HorizontalAlignment="Left"
                                               Margin="42,12,0,0"
                                               RadiusX="3"
                                               RadiusY="3"/>

                                    <Rectangle Fill="#13294B"
                                               Width="18"
                                               Height="46"
                                               HorizontalAlignment="Right"
                                               Margin="0,12,42,0"
                                               RadiusX="3"
                                               RadiusY="3"/>
                                </Grid>

                                <!-- Base -->
                                <Border Background="#E67E22"
                                        CornerRadius="14"
                                        Margin="0,45,0,0"
                                        BorderBrush="#D97706"
                                        BorderThickness="1"/>

                                <!-- Rayas verticales -->
                                <UniformGrid Rows="1"
                                             Columns="10"
                                             Width="300"
                                             Height="460"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,10">
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                    <Rectangle Fill="#9A4A12" RadiusX="3" RadiusY="3" Margin="8,0"/>
                                </UniformGrid>

                                <!-- Etiquetas -->
                                <UniformGrid Rows="2"
                                             Columns="2"
                                             Width="260"
                                             Height="120"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             Margin="0,65,0,0">

                                    <Border Margin="8"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderBrush="#9CA3AF"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Margin="8"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderBrush="#9CA3AF"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Margin="8"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderBrush="#9CA3AF"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Margin="8"
                                            CornerRadius="16"
                                            Background="White"
                                            BorderBrush="#9CA3AF"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  Margin="18,0,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnTerminar"
                        Grid.Column="1"
                        Height="32"
                        Content="Terminar"
                        Click="BtnTerminar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="BtnCerrar"
                        Grid.Column="3"
                        Height="32"
                        Content="Cerrar"
                        Click="BtnCerrar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>