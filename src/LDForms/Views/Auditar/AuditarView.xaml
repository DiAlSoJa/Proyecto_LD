<UserControl x:Class="LD.FormsX.Views.Auditar.AuditarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock Text="Auditoría"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta y control de auditorías"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="BtnActualizar"
                        Grid.Column="1"
                        Height="38"
                        Content="Actualizar"
                        Click="BtnActualizar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="BtnNuevaAuditoria"
                        Grid.Column="3"
                        Content="Nueva auditoría"
                        Click="BtnNuevo_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Margin="0,8,0,7"/>

                <Button x:Name="BtnEnviar"
                        Grid.Column="5"
                        Height="38"
                        Content="Enviar"
                       
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="BtnEditar"
                        Grid.Column="7"
                        Height="38"
                        Content="Editar"
                        Click="BtnEditar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Lado izquierdo -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2.1*"/>
                </Grid.RowDefinitions>

                <!-- Grid principal -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatusAuditoria"
                                   Grid.Row="0"
                                   Text="Sin auditorías para mostrar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid>
                                <DataGrid x:Name="dgAuditorias"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="40"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionChanged="dgAuditorias_SelectionChanged">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Requisición" Binding="{Binding Requisicion}" Width="110"/>
                                        <DataGridTextColumn Header="Picking" Binding="{Binding Picking}" Width="110"/>
                                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="150"/>
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="150"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="80"/>
                                        <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="70"/>
                                    </DataGrid.Columns>

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#EEF1F5"/>
                                            <Setter Property="Foreground" Value="#16263D"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>

                                <Border x:Name="LoadingOverlayAuditoria"
                                        Background="#80FFFFFF"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="18"/>
                                        <TextBlock x:Name="TxtLoadingAuditoria"
                                                   Text="Cargando auditorías..."
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#24344D"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid detalle -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatusDetalle"
                                   Grid.Row="0"
                                   Text="Sin detalle para mostrar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid>
                                <DataGrid x:Name="dgDetalleAuditoria"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="40"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionChanged="dgDetalleAuditoria_SelectionChanged">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No Parte" Binding="{Binding NoParte}" Width="130"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="150"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="95"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                        <DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="110"/>
                                        <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="120"/>
                                    </DataGrid.Columns>

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#EEF1F5"/>
                                            <Setter Property="Foreground" Value="#16263D"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>

                                <Border x:Name="LoadingOverlayDetalle"
                                        Background="#80FFFFFF"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="18"/>
                                        <TextBlock x:Name="TxtLoadingDetalle"
                                                   Text="Cargando detalle..."
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#24344D"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel derecho -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Vista de ubicación"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>
                        <TextBlock Text="Representación visual de la tarima o rack"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="360"
                                  Height="620">

                                <!-- sombra -->
                                <Border Width="300"
                                        Height="560"
                                        CornerRadius="12"
                                        Background="#11000000"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="10,12,0,0"/>

                                <!-- base rack -->
                                <Border Width="300"
                                        Height="560"
                                        CornerRadius="12"
                                        Background="#E67E22"
                                        BorderBrush="#C96A16"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                <!-- cabecera -->
                                <Grid VerticalAlignment="Top"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,0"
                                      Width="300"
                                      Height="120">
                                    <Border Background="#65B51D"
                                            Height="90"
                                            CornerRadius="18,18,8,8"
                                            Margin="18,0,18,0"
                                            VerticalAlignment="Top"/>

                                    <Border Background="#102A54"
                                            Height="44"
                                            CornerRadius="10"
                                            Margin="36,6,36,0"
                                            VerticalAlignment="Top"/>

                                    <Rectangle Fill="#102A54"
                                               Width="18"
                                               Height="70"
                                               HorizontalAlignment="Left"
                                               Margin="34,20,0,0"
                                               RadiusX="4"
                                               RadiusY="4"/>

                                    <Rectangle Fill="#102A54"
                                               Width="18"
                                               Height="70"
                                               HorizontalAlignment="Right"
                                               Margin="0,20,34,0"
                                               RadiusX="4"
                                               RadiusY="4"/>
                                </Grid>

                                <!-- barrotes -->
                                <UniformGrid Rows="1"
                                             Columns="10"
                                             Width="250"
                                             Height="430"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             Margin="0,0,0,14">
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                    <Rectangle Fill="#8F4310" RadiusX="4" RadiusY="4" Margin="7,0"/>
                                </UniformGrid>

                                <!-- tarjetas -->
                                <UniformGrid Rows="2"
                                             Columns="2"
                                             Width="250"
                                             Height="110"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             Margin="0,120,0,0">

                                    <Border Margin="8"
                                            CornerRadius="14"
                                            Background="White"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Margin="8"
                                            CornerRadius="14"
                                            Background="White"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Margin="8"
                                            CornerRadius="14"
                                            Background="White"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Margin="8"
                                            CornerRadius="14"
                                            Background="White"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            Padding="8">
                                        <TextBlock Text="20260101-2000&#10;# 5226200222520"
                                                   TextAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>