<Window x:Class="LD.FormsX.Views.Usuarios.NuevoUsuarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LD.FormsX.Views.Usuarios"
        mc:Ignorable="d"
        Title="NuevoUsuarioView" 
         Width="900"
         Height="600"
         WindowStartupLocation="CenterOwner"
         WindowStyle="None"
         ResizeMode="NoResize"
         AllowsTransparency="True"
         Background="Transparent">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>



        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadOnlyInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="870"
                MinHeight="580"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#16A34A"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Nuevo usuario"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnClose_Click"
                                Content="×"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="24,20,24,18">
                    <TabControl x:Name="tabControl1">

                        <TabItem Header="Información Comercial" Margin="0,0,-4,0">
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10,12,12,12"
                                    Padding="22">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="383">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Id:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtId"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Width="120"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource ReadOnlyInputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Nombre comercial:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtComercialName"
                                                 Grid.Row="2" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Domicilio comercial:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtDomicilioComercial"
                                                 Grid.Row="4" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Colonia:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtColoniaComercial"
                                                 Grid.Row="6" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Ciudad:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtCiudadComercial"
                                                 Grid.Row="8" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="CP:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtCPComercial"
                                                 Grid.Row="10" Grid.Column="1"
                                                 Width="140"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Teléfono:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtTelefonoComercial"
                                                 Grid.Row="12" Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <CheckBox x:Name="checkIsActive"
                                                  Grid.Row="14" Grid.Column="1"
                                                  Content="Activo"
                                                  Style="{StaticResource CheckStyle}"/>

                                        <CheckBox x:Name="checkIsProvider"
                                                  Grid.Row="16" Grid.Column="1"
                                                  Content="Proveedor VMI"
                                                  Style="{StaticResource CheckStyle}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <TabItem Header="Información Fiscal" Margin="0,0,-10,0">
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="0,12,12,12"
                                    Padding="22">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Razón social:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtRazonSocial"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="RFC:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtRFC"
                                                 Grid.Row="2" Grid.Column="1"
                                                 Width="260"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Domicilio fiscal:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtDomicilioFiscal"
                                                 Grid.Row="4" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Colonia:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtColonia"
                                                 Grid.Row="6" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Ciudad:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtCiudadFiscal"
                                                 Grid.Row="8" Grid.Column="1"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="CP:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtCPFiscal"
                                                 Grid.Row="10" Grid.Column="1"
                                                 Width="140"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Email:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtEmail"
                                                 Grid.Row="12" Grid.Column="1"
                                                 Width="420"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource InputTextBoxStyle}"/>

                                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Teléfono:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="txtTelefonoFiscal"
                                                 Grid.Row="14" Grid.Column="1"
                                                 Width="220"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button x:Name="btnSave"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="btnSave_Click"/>

                        <Button x:Name="button2"
                                Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
