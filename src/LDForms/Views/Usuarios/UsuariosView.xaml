<UserControl x:Class="LD.FormsX.Views.Usuarios.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LD.FormsX.Views.Usuarios"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1300"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Encabezado ── -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Usuarios"
                               FontSize="24" FontWeight="SemiBold" Foreground="#1F2937"/>
                    <TextBlock Text="Consulta, crea y administra usuarios del sistema"
                               FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox x:Name="txtBuscar"
                         Grid.Column="1"
                         Height="38" VerticalContentAlignment="Center"
                         Padding="10,0" FontSize="13"
                         ToolTip="Buscar usuario..."/>

                <!-- Nuevo -->
                <Button x:Name="btnNuevo" Grid.Column="3"
                        Height="38" Padding="12,0"
                        Click="BtnNuevo_Click"
                        Background="#F3F4F6" Foreground="#374151"
                        BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"
                                   Foreground="#2563EB" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Nuevo" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Editar -->
                <Button x:Name="btnEditar" Grid.Column="5"
                        Height="38" Padding="12,0"
                        Click="BtnEditar_Click"
                        Background="#F3F4F6" Foreground="#374151"
                        BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"
                                   Foreground="#D97706" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Editar" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Almacenes -->
                <Button x:Name="btnAlmacenes" Grid.Column="7"
                        Height="38" Padding="12,0"
                        Click="BtnAlmacenes_Click"
                        Background="#F3F4F6" Foreground="#374151"
                        BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                   Foreground="#7C3AED" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Almacenes" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Actualizar -->
                <Button x:Name="BtnActualizar" Grid.Column="9"
                        Height="38" Padding="12,0"
                        Click="BtnActualizar_Click"
                        Background="#F3F4F6" Foreground="#374151"
                        BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"
                                   Foreground="#16A34A" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Actualizar" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Contenido principal ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Grid de usuarios (izquierda) -->
            <Border Grid.Column="0"
                    Background="White" CornerRadius="12"
                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtStatus"
                               Text="Cargando usuarios..."
                               FontSize="12" Foreground="#6B7280" Margin="4,0,0,8"/>

                    <Border Grid.Row="1"
                            BorderBrush="#D9DEE7" BorderThickness="1"
                            CornerRadius="4" Background="White">
                        <Grid>
                            <DataGrid x:Name="dgUsuarios"
                                      AutoGenerateColumns="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      SelectionChanged="DgUsuarios_SelectionChanged"
                                      RowHeight="28" ColumnHeaderHeight="40"
                                      FontSize="12" VerticalGridLinesBrush="#D9D9D9">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>

                            <!-- Loader -->
                            <Border x:Name="LoadingOverlay"
                                    Background="#80FFFFFF" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="18"/>
                                    <TextBlock x:Name="TxtLoading"
                                               Text="Trayendo usuarios..."
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0" FontSize="14"
                                               FontWeight="SemiBold" Foreground="#24344D"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Paneles de detalle (derecha) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Permisos -->
                <Border Grid.Row="0"
                        Background="White" CornerRadius="12"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;"
                                       FontSize="14" Foreground="#6B7280"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Permisos del usuario"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4">
                            <DataGrid x:Name="dgPermisos"
                                      AutoGenerateColumns="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28" ColumnHeaderHeight="36"
                                      FontSize="12" VerticalGridLinesBrush="#D9D9D9">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Almacenes asignados -->
                <Border Grid.Row="2"
                        Background="White" CornerRadius="12"
                        BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                       FontSize="14" Foreground="#6B7280"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Almacenes asignados"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4">
                            <DataGrid x:Name="dgAlmacenes"
                                      AutoGenerateColumns="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28" ColumnHeaderHeight="36"
                                      FontSize="12" VerticalGridLinesBrush="#D9D9D9">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
