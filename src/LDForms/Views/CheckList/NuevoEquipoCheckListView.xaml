<Window x:Class="LD.FormsX.Views.CheckList.NuevoEquipoCheckListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nuevo Equipo"
        Height="430"
        Width="790"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#F3F4F6"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#233167"
                    CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Nuevo Equipo"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <Button x:Name="BtnCloseHeader"
                            Grid.Column="1"
                            Content="✕"
                            Click="BtnCerrar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1"
                  Margin="26,22,26,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tipo -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Tipo:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <ComboBox x:Name="cmbTipo"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="30"
                          FontSize="13"
                          Padding="8,0"
                          VerticalContentAlignment="Center"
                          BorderBrush="#9CA3AF"
                          Background="White"/>

                <!-- No. Equipo -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="No. Equipo:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <TextBox x:Name="txtNoEquipo"
                         Grid.Row="2"
                         Grid.Column="1"
                         Width="280"
                         Height="30"
                         HorizontalAlignment="Left"
                         FontSize="13"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#9CA3AF"
                         Background="White"/>

                <!-- Serie -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Serie:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <TextBox x:Name="txtSerie"
                         Grid.Row="4"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Width="394"
                         Height="30"
                         HorizontalAlignment="Left"
                         FontSize="13"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#9CA3AF"
                         Background="White"/>

                <!-- Marca -->
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Marca:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <TextBox x:Name="txtMarca"
                         Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Width="394"
                         Height="30"
                         HorizontalAlignment="Left"
                         FontSize="13"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#9CA3AF"
                         Background="White"/>

                <!-- Horometro -->
                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Horometro:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <TextBox x:Name="txtHorometro"
                         Grid.Row="8"
                         Grid.Column="1"
                         Width="280"
                         Height="30"
                         HorizontalAlignment="Left"
                         FontSize="13"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#9CA3AF"
                         Background="White"/>

                <!-- Operativo -->
                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Text="Operativo:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <StackPanel Grid.Row="10"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <RadioButton x:Name="rbSi"
                                 Content="Sí"
                                 GroupName="Operativo"
                                 FontSize="13"
                                 Margin="0,0,26,0"/>
                    <RadioButton x:Name="rbNo"
                                 Content="No"
                                 GroupName="Operativo"
                                 FontSize="13"/>
                </StackPanel>

                <!-- Proveedor -->
                <TextBlock Grid.Row="12"
                           Grid.Column="0"
                           Text="Proveedor:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#111827"/>

                <ComboBox x:Name="cmbProveedor"
                          Grid.Row="12"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Height="30"
                          FontSize="13"
                          Padding="8,0"
                          VerticalContentAlignment="Center"
                          BorderBrush="#9CA3AF"
                          Background="White"/>

                <Button x:Name="BtnNuevoProveedor"
                        Grid.Row="12"
                        Grid.Column="3"
                        Height="32"
                        Margin="8,0,0,0"
                        Content="Nuevo Proveedor"
                        Click="BtnNuevoProveedor_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  Margin="26,0,26,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnGuardar"
                        Grid.Column="1"
                        Height="34"
                        Content="Guardar"
                        Click="BtnGuardar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        Cursor="Hand"/>

                <Button x:Name="BtnCerrar"
                        Grid.Column="3"
                        Height="34"
                        Content="Cerrar"
                        Click="BtnCerrar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>