<Window x:Class="LD.FormsX.Views.Dialogs.NuevoASNView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ASN"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#15803D"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#FDFCD5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputTextBoxStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="InputComboBoxStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DatePicker" x:Key="InputDatePickerStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#D1D5DB" BorderThickness="1" Background="#F3F4F6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Border Grid.Row="0"
                    Background="{StaticResource PrimaryBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtTituloVentana"
                               Text="ASN"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>

                    <Button x:Name="btnCerrarVentana"
                            Grid.Column="1"
                            Content="✕"
                            Click="BtnCerrarVentana_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Encabezado de captura -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="20,18,20,8">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="500"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cliente:" Style="{StaticResource LabelStyle}" Margin="0,7,0,0"/>
                        <ComboBox x:Name="cmbCliente"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                        <Border x:Name="bdPreAsn"
                                Grid.Row="0"
                                Grid.Column="4"
                                Background="#FDE68A"
                                BorderBrush="#D4A017"
                                BorderThickness="1"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtPreAsn"
                                       Text="PREASN000001"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                        </Border>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Proyecto:" Style="{StaticResource LabelStyle}" Margin="0,11,0,0"/>
                        <ComboBox x:Name="cmbProyecto"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,4,0,0"
                                  Style="{StaticResource InputComboBoxStyle}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Grupo ASN -->
                        <GroupBox Grid.Column="0" Header="ASN">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="No. Factura:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtNumeroFactura" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="No. Guía:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtNumeroGuia" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ETA:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <DatePicker x:Name="dpEta" Grid.Row="2" Grid.Column="1" Style="{StaticResource InputDatePickerStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bultos:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtBultos" Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                                <CheckBox x:Name="chkEsDevolucion"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Content="Devolución"
                                          Margin="0,4,0,10"/>

                                <CheckBox x:Name="chkMovimientoRequeridoCliente"
                                          Grid.Row="5"
                                          Grid.Column="1"
                                          Content="Movimiento requerido por cliente"
                                          Margin="0,0,0,0"/>
                            </Grid>
                        </GroupBox>

                        <!-- Grupo Transporte -->
                        <GroupBox Grid.Column="2" Header="Transporte">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button x:Name="btnBuscarVehiculo"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Width="170"
                                        Content="Buscar vehículo"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnBuscarVehiculo_Click"
                                        Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Línea de Transporte:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtLineaTransporte" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tipo de vehículo:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtTipoVehiculo" Grid.Row="2" Grid.Column="1" Width="260" HorizontalAlignment="Left" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Nombre de chofer:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <ComboBox x:Name="cmbChofer" Grid.Row="3" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Placas:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtPlacasVehiculo" Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Sello:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                <TextBox x:Name="txtSelloTransporte" Grid.Row="5" Grid.Column="1" Width="300" HorizontalAlignment="Left" Style="{StaticResource InputTextBoxStyle}"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Grids -->
            <Grid Grid.Row="2" Margin="20,14,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.1*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="btnEscanear"
                            Content="Escanear"
                            Width="150"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnEscanear_Click"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <DataGrid x:Name="dgPartidasAsn"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              AlternatingRowBackground="{StaticResource AltRowBrush}"
                              RowBackground="White"
                              BorderThickness="0"
                              RowHeight="30"
                              ColumnHeaderHeight="38"
                              FontSize="12"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Número de Parte" Binding="{Binding NumeroParte}" Width="200"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="220"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="SD" Binding="{Binding Sd}" Width="100"/>
                            <DataGridTextColumn Header="Número de Lote" Binding="{Binding NumeroLote}" Width="140"/>
                            <DataGridTextColumn Header="Fecha de Caducidad" Binding="{Binding FechaCaducidad}" Width="150"/>
                            <DataGridTextColumn Header="Referencia de Cliente" Binding="{Binding ReferenciaCliente}" Width="160"/>
                            <DataGridTextColumn Header="Tipo de Cambio" Binding="{Binding TipoCambio}" Width="120"/>
                            <DataGridTextColumn Header="Orden de Compra" Binding="{Binding OrdenCompra}" Width="140"/>
                            <DataGridTextColumn Header="Pedimento" Binding="{Binding Pedimento}" Width="120"/>
                            <DataGridTextColumn Header="Split" Binding="{Binding Split}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <DataGrid x:Name="dgUbicacionesAsignadas"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              AlternatingRowBackground="{StaticResource AltRowBrush}"
                              RowBackground="White"
                              BorderThickness="0"
                              RowHeight="30"
                              ColumnHeaderHeight="38"
                              FontSize="12"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Borrar" Binding="{Binding Borrar}" Width="90"/>
                            <DataGridTextColumn Header="EstandarID" Binding="{Binding EstandarId}" Width="100"/>
                            <DataGridTextColumn Header="Número de Parte" Binding="{Binding NumeroParte}" Width="180"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="220"/>
                            <DataGridTextColumn Header="Estandar" Binding="{Binding Estandar}" Width="100"/>
                            <DataGridTextColumn Header="Máxima" Binding="{Binding Maxima}" Width="100"/>
                            <DataGridTextColumn Header="SD" Binding="{Binding Sd}" Width="90"/>
                            <DataGridTextColumn Header="Recibida" Binding="{Binding Recibida}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="120"/>
                            <DataGridTextColumn Header="Número de Lote" Binding="{Binding NumeroLote}" Width="140"/>
                            <DataGridTextColumn Header="Fecha de Caducidad" Binding="{Binding FechaCaducidad}" Width="150"/>
                            <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Botones inferiores -->
            <Border Grid.Row="3"
                    Background="#F3F4F6"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCrearAsn"
                            Content="Crear ASN"
                            Width="150"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnCrearAsn_Click"/>

                    <Button x:Name="btnCerrar"
                            Content="Cerrar"
                            Width="130"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0"
                            Click="BtnCerrar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>