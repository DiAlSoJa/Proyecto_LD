<UserControl x:Class="LD.FormsX.Views.ControlPatio.ControlPatioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="LinkButtonInGridStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- OPERACIONES PENDIENTES -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Operaciones Pendientes"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="4,0,0,0"/>

                    <Button x:Name="BtnActualizar"
                            Grid.Column="1"
                            Height="38"
                            Content="Actualizar"
                            Click="BtnActualizar_Click"
                            Background="White"
                            Foreground="#111827"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pendientes izquierda -->
                    <Border Grid.Column="0"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                        <DataGrid x:Name="dgPendientesOperaciones"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgPendientesOperaciones_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="FechaRegistro" Binding="{Binding FechaRegistro}" Width="130"/>
                                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="140"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130"/>
                                <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="130"/>
                                <DataGridTextColumn Header="Tipo caja" Binding="{Binding TipoCaja}" Width="130"/>
                                <DataGridTextColumn Header="No. de Caja" Binding="{Binding NumeroCaja}" Width="130"/>
                                <DataGridTextColumn Header="Instrucción" Binding="{Binding Instruccion}" Width="220"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>

                    <!-- Pendientes derecha -->
                    <Border Grid.Column="2"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                        <DataGrid x:Name="dgPendientesTransportes"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgPendientesTransportes_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Fecha de registro" Binding="{Binding FechaRegistro}" Width="140"/>
                                <DataGridTextColumn Header="Chofer" Binding="{Binding Chofer}" Width="130"/>
                                <DataGridTextColumn Header="No. de unidad" Binding="{Binding NumeroUnidad}" Width="130"/>
                                <DataGridTextColumn Header="Instrucción" Binding="{Binding Instruccion}" Width="220"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- OPERACIONES -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Operaciones"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Margin="4,0,0,0"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Operaciones izquierda -->
                    <Border Grid.Column="0"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                        <DataGrid x:Name="dgOperaciones"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgOperaciones_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="FechaRegistro" Binding="{Binding FechaRegistro}" Width="130"/>
                                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="140"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="130"/>
                                <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="130"/>
                                <DataGridTextColumn Header="Tipo caja" Binding="{Binding TipoCaja}" Width="130"/>
                                <DataGridTextColumn Header="No. de Caja" Binding="{Binding NumeroCaja}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="Cortina" Binding="{Binding Cortina}" Width="100"/>
                                <DataGridTextColumn Header="Inicio operación" Binding="{Binding InicioOperacion}" Width="140"/>
                                <DataGridTextColumn Header="Fin operación" Binding="{Binding FinOperacion}" Width="140"/>

                                <DataGridTemplateColumn Header="Editar" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Editar"
                                                    Style="{StaticResource LinkButtonInGridStyle}"
                                                    Click="BtnEditarOperacion_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cancelar" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Cancelar"
                                                    Style="{StaticResource LinkButtonInGridStyle}"
                                                    Foreground="#DC2626"
                                                    Click="BtnCancelarOperacion_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>

                    <!-- Operaciones derecha -->
                    <Border Grid.Column="2"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                        <DataGrid x:Name="dgTransportes"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgTransportes_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Fecha de registro" Binding="{Binding FechaRegistro}" Width="140"/>
                                <DataGridTextColumn Header="Chofer" Binding="{Binding Chofer}" Width="130"/>
                                <DataGridTextColumn Header="No. de unidad" Binding="{Binding NumeroUnidad}" Width="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>

                                <DataGridTemplateColumn Header="Editar" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Editar"
                                                    Style="{StaticResource LinkButtonInGridStyle}"
                                                    Click="BtnEditarTransporte_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Cancelar" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Cancelar"
                                                    Style="{StaticResource LinkButtonInGridStyle}"
                                                    Foreground="#DC2626"
                                                    Click="BtnCancelarTransporte_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRowStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>