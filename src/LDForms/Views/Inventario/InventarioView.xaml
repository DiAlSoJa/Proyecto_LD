<UserControl x:Class="LD.FormsX.Views.Inventario.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock Text="Inventario"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta de inventario"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <TextBox x:Name="txtBuscar"
                         Grid.Column="1"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="13"
                         ToolTip="Buscar..." />

                <Button x:Name="BtnActualizar"
		                    Grid.Column="7"
		                    Height="38"
		                    Padding="12,0"
		                   
		                    Background="#F3F4F6"
		                    Foreground="#374151"
		                    BorderBrush="#D1D5DB"
		                    BorderThickness="1"
		                    Cursor="Hand">

	                    <Button.Resources>
		                    <Style TargetType="Border">
			                    <Setter Property="CornerRadius" Value="6"/>
		                    </Style>
	                    </Button.Resources>

	                    <StackPanel Orientation="Horizontal"
		                    VerticalAlignment="Center"
		                    HorizontalAlignment="Center">

		                    <TextBlock FontFamily="Segoe MDL2 Assets"
		                       Text="&#xE895;"
		                       Foreground="#10B981"
		                       Margin="0,0,6,0"
		                       FontSize="14"/>

		                    <TextBlock Text="Actualizar"/>
	                    </StackPanel>
                    </Button>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatus"
                           Grid.Row="0"
                           Text="Sin datos para mostrar"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dg"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="110"/>
                                <DataGridTextColumn Header="Almacén" Binding="{Binding Almacen}" Width="80"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="130"/>
                                <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="125"/>
                                <DataGridTextColumn Header="EstandarID" Binding="{Binding EstandarID}" Width="110"/>
                                <DataGridTextColumn Header="Fecha Recepción" Binding="{Binding FechaRecepcion}" Width="105"/>
                                <DataGridTextColumn Header="Fecha String" Binding="{Binding FechaString}" Width="80"/>
                                <DataGridTextColumn Header="ASN" Binding="{Binding ASN}" Width="75"/>
                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="80"/>
                                <DataGridTextColumn Header="Particion" Binding="{Binding Particion}" Width="78"/>
                                <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="90"/>
                                <DataGridTextColumn Header="No. Parte" Binding="{Binding NoParte}" Width="95"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="130"/>
                                <DataGridTextColumn Header="Recibida" Binding="{Binding Recibida}" Width="80"/>
                                <DataGridTextColumn Header="Disponible" Binding="{Binding Disponible}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="Número de Lote" Binding="{Binding NumeroLote}" Width="105"/>
                                <DataGridTextColumn Header="Caducidad" Binding="{Binding Caducidad}" Width="85"/>
                                <DataGridTextColumn Header="Orden de Compra" Binding="{Binding OrdenCompra}" Width="80"/>
                                <DataGridTextColumn Header="Pedimento" Binding="{Binding Pedimento}" Width="95"/>
                                <DataGridTextColumn Header="Tipo de Cambio" Binding="{Binding TipoCambio}" Width="85"/>
                                <DataGridTextColumn Header="SD" Binding="{Binding SD}" Width="80"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="75"/>
                                <DataGridTextColumn Header="Dias Transcurridos" Binding="{Binding DiasTranscurridos}" Width="95"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <!-- Loader -->
                        <Border x:Name="LoadingOverlay"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoading"
                                           Text="Cargando inventario..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>