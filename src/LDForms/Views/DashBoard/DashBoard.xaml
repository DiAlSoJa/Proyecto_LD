<Window x:Class="LDForms.DashBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Warehouse Dashboard"
        Width="1500"
        Height="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#DDE3E8"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#DDE3E8"/>
        <SolidColorBrush x:Key="MainBg" Color="#F7F9FC"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E1E7EF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1D4B9F"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.10"
                          Color="#000000"/>

        <Style x:Key="WindowCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCommandButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EDF3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE3EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTileStyle" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D5DDE7"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <SolidColorBrush x:Key="TabActiveBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabInactiveBg" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="TabHoverBg" Color="#E7EDF5"/>
        <SolidColorBrush x:Key="TabBorderBrush" Color="#D9E1EC"/>
        <SolidColorBrush x:Key="TabActiveBorder" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TabTextActive" Color="#0F172A"/>
        <SolidColorBrush x:Key="TabTextInactive" Color="#475569"/>

        <Style x:Key="ElegantTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource TabBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12,12,0,0"
                            Padding="8,8,8,0">
                                <TabPanel x:Name="HeaderPanel"
                                  IsItemsHost="True"
                                  Background="Transparent"/>
                            </Border>

                            <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource TabBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,0,12,12"
                            Padding="10">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ElegantTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TabTextInactive}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="{StaticResource TabInactiveBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5,5,0,0"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                      ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabActiveBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TabActiveBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TabTextActive}"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabHoverBg}"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabActiveBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>






    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Border Background="{StaticResource MainBg}"
                BorderBrush="#C9D2DC"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Grid Grid.Row="0"
                      Background="#EEF2F6"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="5"
                                Background="#233167"/>
                        <TextBlock Text="LD Warehouse"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#233167"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="520"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⌕"
                                       VerticalAlignment="Center"
                                       Foreground="#6B7280"
                                       FontSize="14"/>

                            <TextBox Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Foreground="#6B7280"
                                     Text="Buscar..."/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">

                        <Button Style="{StaticResource TopIconButtonStyle}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="#4B5563"/>
                        </Button>

                        <Grid Margin="6,0,0,0">
                            <Button Style="{StaticResource TopIconButtonStyle}">
                                <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                         Width="22"
                                                         Height="22"
                                                         Foreground="#4B5563"/>
                            </Button>

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="#EF4444"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,5,5,0"/>
                        </Grid>

                        <Button Style="{StaticResource TopIconButtonStyle}" Margin="6,0,0,0">
                            <materialDesign:PackIcon Kind="DotsVertical"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#4B5563"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="—"
                                Style="{StaticResource WindowCommandButtonStyle}"
                                Click="BtnMinimize_Click"/>

                        <Button x:Name="btnMaximize"
                                Content="□"
                                Style="{StaticResource WindowCommandButtonStyle}"
                                Click="BtnMaximize_Click"/>

                        <Button Content="✕"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0">
                    <Grid.RowDefinitions>
                        
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="1" Margin="12">
                        <TabControl x:Name="MainTabControl"
                Style="{StaticResource ElegantTabControlStyle}">
                            <TabItem x:Name="TabMenu"
                 Style="{StaticResource ElegantTabItemStyle}">
                                <TabItem.Header>
                                    <TextBlock Text="Menú"/>
                                </TabItem.Header>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                                    <WrapPanel x:Name="DashboardPanel"
                                       HorizontalAlignment="Center"
                                       Margin="12">
                                        <!-- Clientes-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="ClientesBtn"
                                             Tag="Clientes"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AccountGroupOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#3B82F6"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Clientes"
                                               Margin="0,14,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Proyectos-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="ProyectosBtn"
                                             Tag="Proyectos"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClipboardListOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#6366F1"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Proyectos"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Almacenes-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="AlmacenesBtn"
                                             Tag="Almacenes"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Warehouse"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#10B981"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Almacén"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Ubicaciones-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="UbicacionesBtn"
                                             Tag="Ubicaciones"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="MapMarkerOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#F59E0B"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Ubicaciones"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>


                                        <!-- Articulos-->                                       
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="ArticulosBtn"
                                             Tag="Articulos"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CubeOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#0EA5E9"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Artículos"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <!-- Inventario-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="InventarioBtn"
                                             Tag="Inventario"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClipboardCheckOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#22C55E"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Inventario"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Movimientos-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="MovimientosBtn"
                                             Tag="Movimientos"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="SwapHorizontal"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#8B5CF6"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Movimientos"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- ASN-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="AsnBtn"
                                             Tag="ASN"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#3B82F6"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="ASN"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Auditar-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="AuditoriaBtn"
                                             Tag="Auditar"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClipboardSearchOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#EF4444"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Auditar"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Inventario aleatorio-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="InventarioRandomBtn"
                                             Tag="Aleatorio"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ShuffleVariant"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#EC4899"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Inventario aleatorio"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Usuarios-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="UsuariosBtn"
                                             Tag="Usuarios"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AccountMultipleOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#6366F1"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Usuarios"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- CheckList montacargas-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="ChecklistBtn"
                                             Tag="CheckList"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Forklift"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#F59E0B"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Checklist montacargas"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Catalogos-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="CatalogosBtn"
                                             Tag="Catalogos"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ViewGridOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#3B82F6"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Catálogos"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Surtido-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="SurtidoBtn"
                                             Tag="Surtido"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClipboardArrowDownOutline"
                                                     Width="44"
                                                     Height="44"
                                                     Foreground="#10B981"
                                                     HorizontalAlignment="Center"/>
                                                <TextBlock Text="Surtido"
                                                   Margin="0,14,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Embarques-->
                                        <Button Style="{StaticResource DashboardTileStyle}"
                                                x:Name="EmbarquesBtn"
                                             Tag="Embarques"
                                                Click="DashboardTile_Click"
                                                MouseRightButtonUp="DashboardTile_RightClick">
