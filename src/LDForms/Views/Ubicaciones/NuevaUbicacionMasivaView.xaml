<Window x:Class="LD.FormsX.Views.Ubicaciones.NuevaUbicacionMasivaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nueva ubicación masiva"
        Width="980"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="950"
                MinHeight="660"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#16A34A"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Nueva ubicación masiva"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnCerrar_Click"
                                Content="×"/>
                    </Grid>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1" Margin="28,24,28,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Almacén:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox Grid.Column="1"
                                              x:Name="cmbAlmacenN"
                                              Style="{StaticResource InputComboBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rack:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="txtRack"
                                             Width="250"
                                             HorizontalAlignment="Left"
                                             Style="{StaticResource InputTextBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Posiciones:" Style="{StaticResource LabelStyle}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Desde:"
                                                   Margin="0,0,0,6"
                                                   Foreground="#374151"/>
                                        <TextBox x:Name="txtDesde"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Hasta:"
                                                   Margin="0,0,0,6"
                                                   Foreground="#374151"/>
                                        <TextBox x:Name="txtHasta"
                                                 Style="{StaticResource InputTextBoxStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Niveles (1 a 36):"
                                               Style="{StaticResource LabelStyle}"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="txtNiveles"
                                             Style="{StaticResource InputTextBoxStyle}"/>
                                </Grid>

                                <StackPanel Margin="140,0,0,18">
                                    <CheckBox x:Name="checkIsActive"
                                              Content="Activo"
                                              IsChecked="True"
                                              Style="{StaticResource CheckStyle}"/>
                                    <CheckBox x:Name="checkIsFiscal"
                                              Content="Fiscal"
                                              Style="{StaticResource CheckStyle}"/>
                                    <CheckBox x:Name="checkTemperatura"
                                              Content="Temperatura controlada"
                                              Style="{StaticResource CheckStyle}"/>
                                </StackPanel>

                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Background="#FCFCFD"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Dimensiones"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Alto:" Style="{StaticResource LabelStyle}" Margin="0"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="txtAltoCm"
                                                     Style="{StaticResource InputTextBoxStyle}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="cm."
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Foreground="#374151"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Ancho:" Style="{StaticResource LabelStyle}" Margin="0"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="txtAnchoCm"
                                                     Style="{StaticResource InputTextBoxStyle}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="cm."
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Foreground="#374151"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Profundidad:" Style="{StaticResource LabelStyle}" Margin="0"/>
                                            <TextBox Grid.Column="1"
                                                     x:Name="txtProfundidadCm"
                                                     Style="{StaticResource InputTextBoxStyle}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="cm."
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Foreground="#374151"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Background="#FCFCFD"
                                        Padding="16"
                                        Margin="0,218,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Tipo de ubicación"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="0,0,12,0"
                                                    Background="White">
                                                <StackPanel>
                                                    <RadioButton x:Name="radioRack"
                                                                 Content="Rack"
                                                                 IsChecked="True"
                                                                 Style="{StaticResource RadioStyle}"/>
                                                    <RadioButton x:Name="radioCompartidoType"
                                                                 Content="Compartido"
                                                                 Style="{StaticResource RadioStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <RadioButton x:Name="radioGeneral"
                                                             Content="General"
                                                             IsChecked="True"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioCompartido"
                                                             Content="Compartido"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioReciboEmbarque"
                                                             Content="Recibo y embarque"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <RadioButton x:Name="radioCuarentena"
                                                             Content="Cuarentena"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioEmbarque"
                                                             Content="Embarque"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,16,0,0"
                                                Background="White"
                                                Width="210"
                                                HorizontalAlignment="Left">
                                            <StackPanel>
                                                <RadioButton x:Name="radioDoble"
                                                             Content="Doble"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioSencillo"
                                                             Content="Sencillo"
                                                             IsChecked="True"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,16,0,0"
                                                Background="White">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="checkPaso"
                                                          Content="Paso"
                                                          Style="{StaticResource CheckStyle}"
                                                          Margin="0,0,26,0"/>
                                                <CheckBox x:Name="checkCortina"
                                                          Content="Cortina"
                                                          Style="{StaticResource CheckStyle}"
                                                          Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button x:Name="btnSave"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="btnSave_Click"/>

                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>