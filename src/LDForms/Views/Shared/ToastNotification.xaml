<Window x:Class="LDForms.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        Height="90"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">

    <Window.Resources>
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="X"
                             From="40" To="0"
                             Duration="0:0:0.20"/>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.20"/>
        </Storyboard>

        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="40"
                             Duration="0:0:0.20"/>
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.20"/>
        </Storyboard>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="RootBorder"
                Opacity="0"
                CornerRadius="14"
                Background="White"
                BorderBrush="#E7E7E7"
                BorderThickness="1"
                Padding="14">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RootTransform" X="40"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="3"
                                  Opacity="0.18"
                                  Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Barra lateral -->
                <Border x:Name="AccentBar"
                        Width="5"
                        CornerRadius="8"
                        Background="#4A90E2"/>

                <!-- Icono -->
                <Border x:Name="IconBackground"
                        Grid.Column="1"
                        Margin="0"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="#EAF2FD"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid x:Name="SuccessIcon" Visibility="Collapsed">
                            <Ellipse Width="16" Height="16"
                                     Stroke="#58C29C"
                                     StrokeThickness="2"/>
                            <Path Data="M 10 17 L 14 21 L 22 13"
                                  Stroke="#58C29C"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>

                        <Grid x:Name="WarningIcon" Visibility="Collapsed">
                            <Path Data="M17,7 L27,25 L7,25 Z"
                                  Stroke="#F0AD4E"
                                  Fill="Transparent"
                                  StrokeThickness="1.8"/>
                            <Rectangle Width="2.2"
                                       Height="7"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Fill="#F0AD4E"
                                       VerticalAlignment="Center"
                                       Margin="0,-3,0,0"/>
                            <Ellipse Width="2.8"
                                     Height="2.8"
                                     Fill="#F0AD4E"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,0,7"/>
                        </Grid>

                        <Grid x:Name="ErrorIcon" Visibility="Collapsed">
                            <Ellipse Width="16" Height="16"
                                     Stroke="#E05A5A"
                                     StrokeThickness="2"/>
                            <Path Data="M 11 11 L 23 23 M 23 11 L 11 23"
                                  Stroke="#E05A5A"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>

                        <Grid x:Name="InfoIcon" Visibility="Collapsed">
                            <Ellipse Width="16" Height="16"
                                     Stroke="#4A90E2"
                                     StrokeThickness="2"/>
                            <TextBlock Text="i"
                                       Foreground="#4A90E2"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Texto -->
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock x:Name="TxtTitle"
                               Text="Success"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#111111"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtMessage"
                               Text="Operation completed successfully."
                               FontSize="12"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               MaxWidth="220"/>
                </StackPanel>

                <!-- Botón cerrar -->
                <Button x:Name="BtnClose"
                        Grid.Column="3"
                        Width="22"
                        Height="22"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#888888"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        VerticalAlignment="Top"
                        Click="BtnClose_Click"
                        Content="✕"/>
            </Grid>
        </Border>
    </Grid>
</Window>