<Window x:Class="LD.FormsX.Views.Dimensionador.NuevoDimensionadorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Height="420"
        Width="750">

    <Border Background="#F7F7F7"
            CornerRadius="20"
            BorderBrush="#D9DDE3"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#18A545"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Dimensión"
                               Margin="15,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Click="BtnCerrar_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="14"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- BODY -->
            <Grid Grid.Row="1" Margin="25,20">

                <Border Background="#F3F3F3"
                        BorderBrush="#D8DCE2"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <!-- Dimensión -->
                        <TextBlock Text="Dimensión:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtId"
                                 Grid.Column="1"
                                 Height="28"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"/>

                        <!-- Nombre -->
                        <TextBlock Grid.Row="1"
                                   Text="Nombre:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtNombre"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="4"
                                 Height="28"
                                 Padding="6,0"
                                 VerticalContentAlignment="Center"/>

                        <!-- Alto -->
                        <TextBlock Grid.Row="2"
                                   Text="Alto:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtAlto"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Height="28"
                                 Padding="6,0"/>

                        <!-- Largo -->
                        <TextBlock Grid.Row="3"
                                   Text="Largo:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtLargo"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Height="28"
                                 Padding="6,0"/>

                        <!-- Ancho -->
                        <TextBlock Grid.Row="4"
                                   Text="Ancho:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtAncho"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Height="28"
                                 Padding="6,0"/>

                        <!-- Peso -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="Peso:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtPeso"
                                 Grid.Row="2"
                                 Grid.Column="4"
                                 Height="28"
                                 Padding="6,0"/>

                    </Grid>
                </Border>
            </Grid>

            <!-- FOOTER -->
            <Grid Grid.Row="2" Margin="0,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnSave"
                        Grid.Column="1"
                        Height="40"
                        Content="Guardar"
                        Click="btnSave_Click"
                        Background="#18A545"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <Button x:Name="btnCerrar"
                        Grid.Column="3"
                        Height="40"
                        Content="Cerrar"
                        Click="BtnCerrar_Click"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>

        </Grid>
    </Border>
</Window>