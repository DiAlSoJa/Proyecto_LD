<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        AppTheme.xaml — Paleta y tokens de diseño de LD.FormsX.
        Regla: nunca poner colores hex inline en las vistas. Siempre referenciar estos tokens.
        Mergeado en App.xaml para disponibilidad global.
    -->

    <!-- ═══════════════════════════════════════════════════════════
         COLORES PRIMARIOS DE MARCA
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppPrimary"         Color="#233167"/>
    <SolidColorBrush x:Key="AppPrimaryHover"    Color="#1B2854"/>
    <SolidColorBrush x:Key="AppPrimaryPressed"  Color="#141E40"/>
    <SolidColorBrush x:Key="TextOnPrimary"      Color="White"/>

    <!-- ═══════════════════════════════════════════════════════════
         COLORES DE ACENTO / ESTADO
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AccentAction"       Color="#2563EB"/>  <!-- Azul vivo (ícono Nuevo) -->
    <SolidColorBrush x:Key="AccentSuccess"      Color="#10B981"/>  <!-- Verde -->
    <SolidColorBrush x:Key="AccentWarning"      Color="#F59E0B"/>  <!-- Ámbar -->
    <SolidColorBrush x:Key="AccentError"        Color="#EF4444"/>  <!-- Rojo -->
    <SolidColorBrush x:Key="AccentErrorBg"      Color="#FEF2F2"/>  <!-- Fondo error -->
    <SolidColorBrush x:Key="AccentInfo"         Color="#3B82F6"/>  <!-- Azul medio -->
    <SolidColorBrush x:Key="AccentViolet"       Color="#7C3AED"/>  <!-- Violeta (icono Almacenes en Usuarios) -->
    <SolidColorBrush x:Key="AccentCyan"         Color="#0891B2"/>  <!-- Cian (icono Roles en Usuarios) -->

    <!-- ═══════════════════════════════════════════════════════════
         TEXTO
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimary"        Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondary"      Color="#6B7280"/>
    <SolidColorBrush x:Key="TextBody"           Color="#111827"/>
    <SolidColorBrush x:Key="TextSubtle"         Color="#374151"/>
    <SolidColorBrush x:Key="TextPlaceholder"    Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextVersion"        Color="#666666"/>

    <!-- ═══════════════════════════════════════════════════════════
         FONDOS / SUPERFICIES
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBg"              Color="#DDE3E8"/>  <!-- Fondo de ventana Dashboard -->
    <SolidColorBrush x:Key="SurfaceMain"        Color="#F7F9FC"/>  <!-- Área de contenido principal -->
    <SolidColorBrush x:Key="SurfaceCard"        Color="White"/>    <!-- Tarjetas y paneles -->
    <SolidColorBrush x:Key="SurfaceInput"       Color="#F9FAFB"/>  <!-- Fondo de inputs -->
    <SolidColorBrush x:Key="SurfaceWindow"      Color="#F7F7F7"/>  <!-- Fondo ventana Login -->
    <SolidColorBrush x:Key="SurfaceSubtle"      Color="#F3F4F6"/>  <!-- Botones secundarios -->
    <SolidColorBrush x:Key="SurfaceTitleBar"    Color="#EEF2F6"/>  <!-- Barra superior Dashboard -->
    <SolidColorBrush x:Key="SurfaceTabHeader"   Color="#F8FAFC"/>  <!-- Cabecera de tabs -->
    <SolidColorBrush x:Key="PatioMonitorHeroBg"        Color="#EEF4FF"/>
    <SolidColorBrush x:Key="PatioMonitorHeroAccent"    Color="#DCE7FF"/>
    <SolidColorBrush x:Key="PatioMonitorCurrentBg"     Color="#EAF4FF"/>
    <SolidColorBrush x:Key="PatioMonitorCurrentBorder" Color="#9CC8FF"/>
    <SolidColorBrush x:Key="PatioMonitorPendingBg"     Color="#F8FAFC"/>
    <SolidColorBrush x:Key="PatioMonitorPendingBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="PatioMonitorCompletedBg"   Color="#ECFDF5"/>
    <SolidColorBrush x:Key="PatioMonitorCompletedBorder" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="PatioMonitorOverdueBg"     Color="#FEF2F2"/>
    <SolidColorBrush x:Key="PatioMonitorOverdueBorder" Color="#FECACA"/>

    <!-- ═══════════════════════════════════════════════════════════
         BORDES
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderSoft"         Color="#E5E7EB"/>  <!-- Tarjetas, diálogos -->
    <SolidColorBrush x:Key="BorderInput"        Color="#D1D5DB"/>  <!-- Inputs en reposo -->
    <SolidColorBrush x:Key="BorderMuted"        Color="#D9DEE7"/>  <!-- DataGrid interno -->
    <SolidColorBrush x:Key="BorderStrong"       Color="#C9D2DC"/>  <!-- Borde exterior ventana -->
    <SolidColorBrush x:Key="BorderGrid"         Color="#D9D9D9"/>  <!-- Líneas verticales DataGrid -->
    <SolidColorBrush x:Key="BorderRow"          Color="#E4E8EE"/>  <!-- Línea inferior de fila -->

    <!-- ═══════════════════════════════════════════════════════════
         CROMO DE VENTANA
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowCloseBg"      Color="#E81123"/>
    <SolidColorBrush x:Key="BtnChromeHover"     Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BtnChromePressed"   Color="#D1D5DB"/>
    <SolidColorBrush x:Key="BtnIconColor"       Color="#374151"/>
    <SolidColorBrush x:Key="BtnIconHover"       Color="#E9EDF3"/>  <!-- Hover bg para botones ícono circulares -->
    <SolidColorBrush x:Key="BtnIconPressed"     Color="#DCE3EC"/>  <!-- Pressed bg para botones ícono circulares -->

    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DataGridHeaderBg"   Color="#EEF1F5"/>
    <SolidColorBrush x:Key="DataGridHeaderFg"   Color="#16263D"/>
    <SolidColorBrush x:Key="DataGridAltRow"     Color="#F8FAFC"/>
    <SolidColorBrush x:Key="LoadingOverlayBg"   Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="TextOnLoading"      Color="#24344D"/>

    <!-- ═══════════════════════════════════════════════════════════
         TABS (ElegantTabControlStyle / ElegantTabItemStyle)
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TabActiveBg"        Color="White"/>
    <SolidColorBrush x:Key="TabInactiveBg"      Color="#EEF2F7"/>
    <SolidColorBrush x:Key="TabHoverBg"         Color="#E7EDF5"/>
    <SolidColorBrush x:Key="TabBorderBrush"     Color="#D9E1EC"/>
    <SolidColorBrush x:Key="TabAccentBorder"    Color="#3B82F6"/>
    <SolidColorBrush x:Key="TabTextActive"      Color="#0F172A"/>
    <SolidColorBrush x:Key="TabTextInactive"    Color="#475569"/>
    <SolidColorBrush x:Key="TabCloseIcon"       Color="#64748B"/>
    <SolidColorBrush x:Key="TabCloseHover"      Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TabClosePressed"    Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TabCloseHoverFg"    Color="#0F172A"/>

    <!-- ═══════════════════════════════════════════════════════════
         ICONOS DE TILES DEL DASHBOARD (colores semánticos por módulo)
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="IconClientes"               Color="#3B82F6"/>
    <SolidColorBrush x:Key="IconProyectos"              Color="#6366F1"/>
    <SolidColorBrush x:Key="IconAlmacen"                Color="#10B981"/>
    <SolidColorBrush x:Key="IconUbicaciones"            Color="#F59E0B"/>
    <SolidColorBrush x:Key="IconArticulos"              Color="#0EA5E9"/>
    <SolidColorBrush x:Key="IconInventario"             Color="#22C55E"/>
    <SolidColorBrush x:Key="IconMovimientos"            Color="#8B5CF6"/>
    <SolidColorBrush x:Key="IconAsn"                    Color="#3B82F6"/>
    <SolidColorBrush x:Key="IconAuditar"                Color="#EF4444"/>
    <SolidColorBrush x:Key="IconInventarioAleatorio"    Color="#EC4899"/>
    <SolidColorBrush x:Key="IconUsuarios"               Color="#6366F1"/>
    <SolidColorBrush x:Key="IconChecklist"              Color="#F59E0B"/>
    <SolidColorBrush x:Key="IconCatalogos"              Color="#3B82F6"/>
    <SolidColorBrush x:Key="IconSurtido"                Color="#10B981"/>
    <SolidColorBrush x:Key="IconSurtidos"               Color="#F97316"/>
    <SolidColorBrush x:Key="IconReportes"               Color="#0EA5E9"/>
    <SolidColorBrush x:Key="IconBaseDatos"              Color="#0F766E"/>
    <SolidColorBrush x:Key="IconReporteDanos"           Color="#DC2626"/>
    <SolidColorBrush x:Key="IconTareas"                 Color="#16A34A"/>
    <SolidColorBrush x:Key="IconImpresion"              Color="#14B8A6"/>
    <SolidColorBrush x:Key="IconPatio"                  Color="#64748B"/>

    <!-- ═══════════════════════════════════════════════════════════
         EFECTOS (x:Shared="False" — cada uso crea una instancia)
    ═══════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="CardShadow"    x:Shared="False" BlurRadius="12" ShadowDepth="2"  Opacity="0.10" Color="#000000"/>
    <DropShadowEffect x:Key="DialogShadow"  x:Shared="False" BlurRadius="22" ShadowDepth="0"  Opacity="0.18" Color="#000000"/>
    <DropShadowEffect x:Key="LoginShadow"   x:Shared="False" BlurRadius="20" ShadowDepth="2"  Opacity="0.25" Color="#000000" Direction="270"/>

</ResourceDictionary>
