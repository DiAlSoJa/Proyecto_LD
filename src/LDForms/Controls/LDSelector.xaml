<UserControl x:Class="LD.FormsX.Controls.LDSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="uc">
    <StackPanel>

        <!-- Label fija arriba -->
        <TextBlock x:Name="PART_Label"
                   Text="{Binding Label, ElementName=uc}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextSubtle}"
                   Margin="0,0,0,5"/>

        <!-- Selector border + ComboBox + placeholder -->
        <Border x:Name="PART_Border"
                BorderBrush="{StaticResource BorderInput}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{StaticResource SurfaceCard}">
            <Grid>
                <!-- Placeholder (visible cuando nada está seleccionado) -->
                <TextBlock x:Name="PART_Placeholder"
                           Text="{Binding Placeholder, ElementName=uc}"
                           Foreground="{StaticResource TextPlaceholder}"
                           Margin="10,0,30,0"
                           FontSize="13"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                <ComboBox x:Name="PART_ComboBox"
                          Height="36"
                          Padding="8,0"
                          FontSize="13"
                          BorderThickness="0"
                          Background="Transparent"
                          VerticalContentAlignment="Center"
                          GotFocus="PART_ComboBox_GotFocus"
                          LostFocus="PART_ComboBox_LostFocus"
                          SelectionChanged="PART_ComboBox_SelectionChanged">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Texto de ayuda -->
        <TextBlock x:Name="PART_Help"
                   Text="{Binding HelpText, ElementName=uc}"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondary}"
                   Margin="2,4,0,0"
                   Visibility="Collapsed"/>

        <!-- Texto de error -->
        <TextBlock x:Name="PART_Error"
                   Text="{Binding ErrorText, ElementName=uc}"
                   FontSize="11"
                   Foreground="{StaticResource AccentError}"
                   Margin="2,4,0,0"
                   Visibility="Collapsed"/>

    </StackPanel>
</UserControl>
