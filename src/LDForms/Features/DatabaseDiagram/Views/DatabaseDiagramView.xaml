<UserControl x:Class="LD.FormsX.Views.DatabaseDiagram.DatabaseDiagramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#F4F6F8"
            BorderBrush="#D7DEE6"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#DCFCE7"
                            Margin="0,0,12,0">
                        <TextBlock Text="&#xE8D4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#166534"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Diagrama de base de datos"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="Todas las entidades principales del dominio y sus relaciones mas relevantes."
                                   Foreground="#64748B"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Line X1="0" Y1="8" X2="26" Y2="8" Stroke="#0F766E" StrokeThickness="2" />
                        <TextBlock Text="FK configurada"
                                   Margin="8,0,0,0"
                                   Foreground="#475569"
                                   FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Line X1="0" Y1="8" X2="26" Y2="8" Stroke="#64748B" StrokeThickness="2" StrokeDashArray="4 3" />
                        <TextBlock Text="Relacion logica"
                                   Margin="8,0,0,0"
                                   Foreground="#475569"
                                   FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Zoom"
                               VerticalAlignment="Center"
                               Foreground="#334155"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0" />
                    <Slider x:Name="ZoomSlider"
                            Grid.Column="1"
                            Minimum="0.45"
                            Maximum="1.8"
                            Value="0.82"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="-"
                            Width="32"
                            Height="28"
                            Margin="10,0,0,0"
                            Click="ZoomOut_Click" />
                    <Button Grid.Column="3"
                            Content="+"
                            Width="32"
                            Height="28"
                            Margin="6,0,0,0"
                            Click="ZoomIn_Click" />
                    <Button Grid.Column="4"
                            Content="100%"
                            Width="54"
                            Height="28"
                            Margin="6,0,0,0"
                            Click="ResetZoom_Click" />
                    <TextBlock Grid.Column="5"
                               Text="Grupo"
                               VerticalAlignment="Center"
                               Foreground="#334155"
                               FontWeight="SemiBold"
                               Margin="18,0,10,0" />
                    <ComboBox x:Name="GroupFilterComboBox"
                              Grid.Column="6"
                              Width="220"
                              Height="30"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Key"
                              SelectionChanged="GroupFilterComboBox_SelectionChanged" />
                    <TextBlock Grid.Column="7"
                               Text="Ctrl + rueda tambien cambia el zoom"
                               Foreground="#64748B"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="DiagramScrollViewer"
                          Grid.Row="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="DiagramScrollViewer_PreviewMouseWheel">
                <Canvas x:Name="DiagramCanvas"
                        Width="1760"
                        Height="2720"
                        Background="#EEF2F7">
                    <Canvas.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}"
                                        ScaleY="{Binding Value, ElementName=ZoomSlider}" />
                    </Canvas.LayoutTransform>
                </Canvas>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
