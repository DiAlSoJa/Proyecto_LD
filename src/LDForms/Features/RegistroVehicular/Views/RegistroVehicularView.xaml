<UserControl x:Class="LD.FormsX.Views.RegistroVehicular.RegistroVehicularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LD.FormsX.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="{StaticResource SurfaceMain}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="Background" Value="{StaticResource AppPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
        </Style>

        <Style x:Key="PdfHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Background" Value="#991B1B"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="20"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Registro vehicular"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Consulta los registros de patio, sus movimientos y la evidencia fotografica."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnBuscar"
                            Content="Buscar"
                            Style="{StaticResource SecondaryHeaderButtonStyle}"
                            Click="BtnBuscar_Click"/>
                    <Button x:Name="btnActualizar"
                            Content="Actualizar"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="BtnActualizar_Click"/>
                    <Button x:Name="btnPdf"
                            Content="PDF"
                            Style="{StaticResource PdfHeaderButtonStyle}"
                            Click="BtnPdf_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:LDInput x:Name="ldBuscar"
                                  Grid.Column="0"
                                  Label="Buscar"
                                  Placeholder="Folio, placa, conductor, cortina, linea..."
                                  HelpText="Escribe para filtrar la tabla. Luego usa PDF sobre el registro seleccionado."
                                  InputHeight="34"
                                  TextVerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="txtSelectionHint"
                               Text="Selecciona un registro para ver su PDF."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <DataGrid x:Name="dgRegistros"
                          AutoGenerateColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          RowHeight="30"
                          ColumnHeaderHeight="40"
                          FontSize="12"
                          VerticalGridLinesBrush="{StaticResource BorderSoft}"
                          HorizontalGridLinesBrush="{StaticResource BorderSoft}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="DgRegistros_SelectionChanged"/>

                <Border x:Name="LoadingOverlay"
                        Background="{StaticResource LoadingOverlayBg}"
                        Visibility="Collapsed"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="220"
                                     Height="18"
                                     Foreground="{StaticResource AppPrimary}"/>
                        <TextBlock x:Name="TxtLoading"
                                   Text="Cargando registros vehiculares..."
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatus"
                           Text="Registros: 0"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="txtTotal"
                           Grid.Column="1"
                           Text=""
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
