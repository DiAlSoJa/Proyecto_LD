<Window x:Class="LDForms.DashBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Warehouse Dashboard"
        Width="1500"
        Height="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBg}"
        >

    <Window.Resources>
        <!-- Estilos locales — todos los colores provienen de AppTheme.xaml (nivel App) -->

        <Style x:Key="WindowCommandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource BtnIconColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromeHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCommandButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WindowCloseBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnIconHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnIconPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardTileStyle" TargetType="Button">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="ElegantTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource SurfaceTabHeader}"
                                    BorderBrush="{StaticResource TabBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12,12,0,0"
                                    Padding="8,8,8,0">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceCard}"
                                    BorderBrush="{StaticResource TabBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,12,12"
                                    Padding="10">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ElegantTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TabTextInactive}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="{StaticResource TabInactiveBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TabBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabActiveBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TabAccentBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TabTextActive}"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabHoverBg}"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabActiveBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TabCloseIcon}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabCloseHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TabCloseHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabClosePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <ContextMenu x:Key="DefaultTileContextMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Abrir en pestaña"
                      Command="{Binding OpenCommand}"/>
            <MenuItem Header="Abrir en ventana"
                      Command="{Binding OpenInWindowCommand}"/>
        </ContextMenu>

        <ContextMenu x:Key="PrintTileContextMenu"
                     x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{Binding PrintMenuHeader}"
                      Command="{Binding OpenCommand}"/>
        </ContextMenu>

    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Border Background="{StaticResource SurfaceMain}"
                BorderBrush="{StaticResource BorderStrong}"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Grid Grid.Row="0"
                      Background="{StaticResource SurfaceTitleBar}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="5"
                                Background="{StaticResource AppPrimary}"/>
                        <TextBlock Text="LD Warehouse"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppPrimary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="520"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceCard}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⌕"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"/>

                            <TextBox x:Name="txtBuscarGlobal"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Foreground="{StaticResource TextSecondary}"
                                     materialDesign:HintAssist.Hint="Buscar módulo..."
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">

                        <Button Style="{StaticResource TopIconButtonStyle}">
                            <materialDesign:PackIcon Kind="BellOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{StaticResource TextSecondary}"/>
                        </Button>

                        <Grid Margin="6,0,0,0">
                            <Button x:Name="btnAccount"
                                    Style="{StaticResource TopIconButtonStyle}"
                                    Click="BtnAccount_Click">
                                <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                         Width="22"
                                                         Height="22"
                                                         Foreground="{StaticResource TextSecondary}"/>
                            </Button>

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource AccentError}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,5,5,0"/>

                            <Popup x:Name="AccountPopup"
                                   PlacementTarget="{Binding ElementName=btnAccount}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="-120">
                                <Border Background="{StaticResource SurfaceCard}"
                                        BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0,8"
                                        MinWidth="200">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                                                          Opacity="0.15" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>

                                        <!-- Info del usuario -->
                                        <StackPanel Margin="16,4,16,10">
                                            <TextBlock x:Name="txtPopupUserName"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="Usuario activo"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Separator Background="{StaticResource SurfaceSubtle}" Margin="0,0,0,4"/>

                                        <!-- Cerrar sesión -->
                                        <Button Click="BtnCerrarSesion_Click"
                                                Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Left"
                                                Padding="16,8" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentErrorBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="LogoutVariant"
                                                                         Width="16" Height="16"
                                                                         Foreground="{StaticResource AccentError}"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="Cerrar sesión"
                                                           FontSize="13"
                                                           Foreground="{StaticResource AccentError}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Style="{StaticResource TopIconButtonStyle}" Margin="6,0,0,0">
                            <materialDesign:PackIcon Kind="DotsVertical"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="{StaticResource TextSecondary}"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="—"
                                Style="{StaticResource WindowCommandButtonStyle}"
                                Click="BtnMinimize_Click"/>

                        <Button x:Name="btnMaximize"
                                Content="□"
                                Style="{StaticResource WindowCommandButtonStyle}"
                                Click="BtnMaximize_Click"/>

                        <Button Content="✕"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Margin="12">
                        <TabControl x:Name="MainTabControl"
                                    Style="{StaticResource ElegantTabControlStyle}">
                            <TabItem x:Name="TabMenu"
                                     Style="{StaticResource ElegantTabItemStyle}">
                                <TabItem.Header>
                                    <TextBlock Text="Menú"/>
                                </TabItem.Header>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="Transparent">
                                    <ItemsControl ItemsSource="{Binding TilesView}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center"
                                                           Margin="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding OpenCommand}"
                                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardTileStyle}">
                                                            <Setter Property="ContextMenu" Value="{StaticResource DefaultTileContextMenu}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrintTile}" Value="True">
                                                                    <Setter Property="ContextMenu" Value="{StaticResource PrintTileContextMenu}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>

                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                                 Width="44"
                                                                                 Height="44"
                                                                                 Foreground="{Binding IconColor}"
                                                                                 HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Margin="0,14,0,0"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
