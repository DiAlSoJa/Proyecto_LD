<Window x:Class="LD.FormsX.Views.Inventario.CambiarUbicacionInventarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar ubicacion"
        Width="420"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Border Padding="18"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Cambiar ubicacion"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="txtStandardId"
                           FontSize="12"
                           Foreground="#4B5563"/>
                <TextBlock x:Name="txtUbicacionActual"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="#6B7280"/>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Text="Ubicacion destino"
                           FontSize="12"
                           Foreground="#374151"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbUbicacionDestino"
                          Height="32"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          DisplayMemberPath="Code"
                          SelectedValuePath="Code"/>
            </StackPanel>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="86"
                        Height="30"
                        Margin="0,0,8,0"
                        Content="Cancelar"
                        Click="BtnCancelar_Click"/>
                <Button Width="86"
                        Height="30"
                        Content="Aceptar"
                        Click="BtnAceptar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
