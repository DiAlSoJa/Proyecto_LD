<UserControl x:Class="LD.FormsX.Views.Usuarios.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LD.FormsX.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1300"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="12"
                Padding="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Usuarios"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Consulta, crea y administra usuarios del sistema"
                               FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>

                <controls:LDInput x:Name="ldBuscar"
                                  Grid.Column="1"
                                  Placeholder="Buscar usuario..."
                                  VerticalAlignment="Center"/>

                <!-- Nuevo -->
                <Button x:Name="btnNuevo" Grid.Column="3"
                        Height="38" Padding="12,0"
                        Click="BtnNuevo_Click"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;"
                                   Foreground="{StaticResource AccentAction}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Nuevo" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Editar -->
                <Button x:Name="btnEditar" Grid.Column="5"
                        Height="38" Padding="12,0"
                        Click="BtnEditar_Click"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding CanExecuteEdit}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"
                                   Foreground="{StaticResource AccentWarning}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Editar" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Almacenes -->
                <Button x:Name="btnAlmacenes" Grid.Column="7"
                        Height="38" Padding="12,0"
                        Click="BtnAlmacenes_Click"
                        Visibility="{Binding CanManageWarehouses, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding CanExecuteManageWarehouses}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                   Foreground="{StaticResource AccentViolet}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Almacenes" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Roles -->
                <Button x:Name="btnRoles" Grid.Column="9"
                        Height="38" Padding="12,0"
                        Click="BtnRoles_Click"
                        Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;"
                                   Foreground="{StaticResource AccentCyan}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Roles" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Actualizar -->
                <Button x:Name="BtnActualizar" Grid.Column="11"
                        Height="38" Padding="12,0"
                        Command="{Binding CargarDatosCommand}"
                        Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"
                                   Foreground="{StaticResource IconTareas}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Actualizar" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Grid de usuarios (izquierda) -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceCard}" CornerRadius="12"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,8"/>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderMuted}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource SurfaceCard}">
                        <Grid>
                            <DataGrid x:Name="dgUsuarios"
                                      AutoGenerateColumns="True"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      SelectionChanged="DgUsuarios_SelectionChanged"
                                      Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}"
                                      RowHeight="28" ColumnHeaderHeight="40"
                                      FontSize="12"
                                      VerticalGridLinesBrush="{StaticResource BorderGrid}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
                                        <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>

                            <!-- Loader -->
                            <Border Background="{StaticResource LoadingOverlayBg}"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="18"/>
                                    <TextBlock Text="{Binding LoadingMessage}"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0" FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextOnLoading}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Paneles de detalle (derecha) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Permisos -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceCard}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;"
                                       FontSize="14" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Permisos del usuario"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4">
                            <DataGrid x:Name="dgPermisos"
                                      AutoGenerateColumns="True"
                                      ItemsSource="{Binding Permissions}"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28" ColumnHeaderHeight="36"
                                      FontSize="12"
                                      VerticalGridLinesBrush="{StaticResource BorderGrid}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
                                        <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Almacenes asignados -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceCard}" CornerRadius="12"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                       FontSize="14" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Almacenes asignados"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSubtle}"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                BorderBrush="{StaticResource BorderMuted}" BorderThickness="1" CornerRadius="4">
                            <DataGrid x:Name="dgAlmacenes"
                                      AutoGenerateColumns="True"
                                      ItemsSource="{Binding Warehouses}"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28" ColumnHeaderHeight="36"
                                      FontSize="12"
                                      VerticalGridLinesBrush="{StaticResource BorderGrid}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
                                        <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
