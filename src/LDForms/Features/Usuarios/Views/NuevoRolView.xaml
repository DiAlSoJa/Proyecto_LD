<Window x:Class="LD.FormsX.Views.Usuarios.NuevoRolView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        Title="Rol" Height="660" Width="560"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ContentRendered="Window_ContentRendered">

    <Border Background="{StaticResource SurfaceCard}" CornerRadius="12"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.12"
                              BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource AppPrimary}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <TextBlock x:Name="txtHeaderTitle"
                               Text="Nuevo Rol"
                               Foreground="{StaticResource TextOnPrimary}"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextOnPrimary}" Cursor="Hand"
                            Width="32" Height="32">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;"
                                   FontSize="14" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Cuerpo -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="24,20,24,4">
                <StackPanel>
                    <controls:LDInput x:Name="txtRoleName"
                                      Label="Nombre del Rol"
                                      Margin="0,0,0,20"/>

                    <TextBlock Text="Permisos" FontSize="13"
                               Foreground="{StaticResource TextSubtle}"
                               FontWeight="Medium" Margin="0,0,0,8"/>

                    <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                            CornerRadius="8" Padding="4" MinHeight="360">
                        <TreeView x:Name="treePermisos"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="13"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                    Padding="24,16" CornerRadius="0,0,12,12"
                    Background="{StaticResource SurfaceCard}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnCancel"
                            Content="Cancelar"
                            Height="38" Padding="20,0"
                            Click="BtnClose_Click"
                            Background="{StaticResource SurfaceSubtle}"
                            Foreground="{StaticResource TextSubtle}"
                            BorderBrush="{StaticResource BorderInput}"
                            BorderThickness="1" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="btnSave"
                            Content="Guardar"
                            Height="38" Padding="20,0"
                            Margin="8,0,0,0"
                            Click="BtnSave_Click"
                            Background="{StaticResource AppPrimary}"
                            Foreground="{StaticResource TextOnPrimary}"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
