<Window x:Class="LD.FormsX.Views.Usuarios.UsuarioAlmacenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Almacenes del usuario"
        Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#233167"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="800"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#233167"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnClose_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- Cuerpo: dos grids + botones entre ellos -->
                <Grid Grid.Row="1" Margin="20,16,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Almacenes disponibles -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                       FontSize="13" Foreground="#6B7280"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Disponibles"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6">
                            <DataGrid x:Name="dgDisponibles"
                                      AutoGenerateColumns="True"
                                      ItemsSource="{Binding Disponibles}"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      SelectionChanged="DgDisponibles_SelectionChanged"
                                      RowHeight="28" ColumnHeaderHeight="36"
                                      FontSize="12" VerticalGridLinesBrush="#D9D9D9">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- Botones del medio -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Button Content="›"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#2563EB" Foreground="White"
                                Margin="0,0,0,10"
                                ToolTip="Asignar almacén"
                                Command="{Binding AgregarCommand}"/>
                        <Button Content="‹"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#EF4444" Foreground="White"
                                ToolTip="Quitar almacén"
                                Command="{Binding QuitarCommand}"/>
                    </StackPanel>

                    <!-- Almacenes asignados -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;"
                                       FontSize="13" Foreground="#16A34A"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Asignados"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                        </StackPanel>
                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6">
                            <DataGrid x:Name="dgAsignados"
                                      AutoGenerateColumns="True"
                                      ItemsSource="{Binding Asignados}"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      SelectionChanged="DgAsignados_SelectionChanged"
                                      RowHeight="28" ColumnHeaderHeight="36"
                                      FontSize="12" VerticalGridLinesBrush="#D9D9D9">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="9,6"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
