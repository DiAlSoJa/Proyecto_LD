<Window x:Class="LD.FormsX.Views.Usuarios.NuevoUsuarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nuevo usuario"
        Height="460" Width="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#233167"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="560"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#233167"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnClose_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- Formulario -->
                <Grid Grid.Row="1" Margin="28,20,28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Nombre de usuario -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre de usuario:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Nombre completo -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Nombre completo:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Contraseña -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Contraseña:" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="txtPassword" Grid.Row="4" Grid.Column="1" Style="{StaticResource InputPasswordStyle}"/>

                    <!-- Confirmar contraseña -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Confirmar contraseña:" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="txtConfirmPassword" Grid.Row="6" Grid.Column="1" Style="{StaticResource InputPasswordStyle}"/>

                    <!-- Rol -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Rol:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="8" Grid.Column="1"
                              Style="{StaticResource InputComboStyle}"
                              ItemsSource="{Binding RolesSource}"
                              SelectedValue="{Binding SelectedRoleId}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"/>

                    <!-- Activo -->
                    <CheckBox Grid.Row="10" Grid.Column="1"
                              Content="Activo"
                              FontSize="14"
                              IsChecked="{Binding IsActive}"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="BtnSave_Click"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>