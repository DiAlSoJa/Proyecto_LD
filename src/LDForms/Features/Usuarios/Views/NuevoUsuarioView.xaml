<Window x:Class="LD.FormsX.Views.Usuarios.NuevoUsuarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Nuevo usuario"
        Height="480" Width="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Width="560"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnClose_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- Formulario -->
                <StackPanel Grid.Row="1" Margin="28,20,28,16">
                    <controls:LDInput Label="Nombre de usuario"
                                      Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10"/>

                    <controls:LDInput Label="Nombre completo"
                                      Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,10"/>

                    <TextBlock Text="Contraseña"
                               FontSize="12"
                               Foreground="{StaticResource TextBody}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtPassword"
                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                 Margin="0,0,0,10"/>

                    <TextBlock Text="Confirmar contraseña"
                               FontSize="12"
                               Foreground="{StaticResource TextBody}"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="txtConfirmPassword"
                                 Style="{StaticResource RoundedPasswordBoxStyle}"
                                 Margin="0,0,0,10"/>

                    <controls:LDSelector Label="Rol"
                                         ItemsSource="{Binding RolesSource}"
                                         SelectedValue="{Binding SelectedRoleId}"
                                         DisplayMemberPath="Value"
                                         SelectedValuePath="Key"
                                         Margin="0,0,0,12"/>

                    <CheckBox Content="Activo"
                              FontSize="14"
                              IsChecked="{Binding IsActive}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="BtnSave_Click"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
