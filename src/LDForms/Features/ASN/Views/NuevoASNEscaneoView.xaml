<Window x:Class="LD.FormsX.Views.Dialogs.NuevoASNEscaneoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASN Escaneo"
        Width="780"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#233167"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>

        <Style TargetType="TextBox" x:Key="InputTextBoxStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White"
                CornerRadius="14"
                BorderBrush="#000"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="54"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="14,14,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ASN Escaneo"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>

                        <Button Grid.Column="1"
                                Content="X"
                                Click="BtnCerrarVentana_Click"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Escaneo:"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEscaneo"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 KeyDown="TxtEscaneo_KeyDown"/>
                    </StackPanel>

                    <GroupBox Grid.Row="2"
                              Header="Condiciones del proyecto"
                              BorderBrush="{StaticResource BorderBrushSoft}"
                              BorderThickness="1"
                              Padding="8">
                        <DataGrid x:Name="dgScanRules"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding ScanRules}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="26"
                                  ColumnHeaderHeight="30"
                                  FontSize="11"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  BorderThickness="1">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCaptured}" Value="True">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Setter Property="Foreground" Value="#14532D"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Orden" Binding="{Binding Order}" Width="50"/>
                                <DataGridTextColumn Header="Campo" Binding="{Binding FieldName}" Width="160"/>
                                <DataGridTextColumn Header="Condición" Binding="{Binding ConditionSummary}" Width="190"/>
                                <DataGridTextColumn Header="Guardar como" Binding="{Binding SaveSummary}" Width="160"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding CapturedValue}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <TextBox x:Name="txtUltimoMensaje"
                             Grid.Row="4"
                             Height="38"
                             Padding="10,4"
                             FontSize="13"
                             FontWeight="SemiBold"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             Background="#F0FDF4"
                             Foreground="#166534"
                             BorderBrush="#22C55E"
                             BorderThickness="1"/>

                    <GroupBox Grid.Row="6"
                              Header="Mensajes"
                              BorderBrush="{StaticResource BorderBrushSoft}"
                              BorderThickness="1"
                              Padding="8">
                        <TextBox x:Name="txtMensajes"
                                 MinHeight="10"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 Background="#F9FAFB"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 BorderThickness="1"/>
                    </GroupBox>
                </Grid>

                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,1,0,0"
                        Padding="12">
                    <Button Content="Cerrar"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCerrar_Click"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
