<Window x:Class="LD.FormsX.Views.Dialogs.NuevoASNView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:LD.FormsX.Features.Common"  
        mc:Ignorable="d"
        Title="ASN"
        Height="780"
        Width="1180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
         AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#111827"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#FDFCD5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox" x:Key="InputTextBoxStyle">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="InputComboBoxStyle">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DatePicker" x:Key="InputDatePickerStyle">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#93C5FD"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Border
         
         Background="White"
         CornerRadius="14"
         BorderBrush="#000"
         BorderThickness="1"
         SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                           ShadowDepth="0"
                           Opacity="0.16"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Border Grid.Row="0"
                    Background="#233167"
                    CornerRadius="16,16,0,0"
                     MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtTituloVentana"
                               Text="ASN"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>

                        <Button x:Name="btnCerrarVentana"
                            Grid.Column="1"
                            Content="✕"
                            Click="BtnCerrarVentana_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="13"
                            Cursor="Hand"/>
                    </Grid>
                </Border>

                <!-- Encabezado -->
                <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="16,14,16,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="430"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Cliente:"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,7,0,0"/>

                            <ComboBox x:Name="cmbCliente"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="cmbCliente_SelectionChanged"/>

                            <Border x:Name="bdPreAsn"
                                Grid.Row="0"
                                Grid.Column="4"
                                Background="#FDE68A"
                                BorderBrush="#D4A017"
                                BorderThickness="1"
                                CornerRadius="4"
                                HorizontalAlignment="Left"
                                Padding="10,4"
                                Visibility="Collapsed">
                                <TextBlock x:Name="txtPreAsn"
                                       Text="PREASN000001"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Proyecto:"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="0,11,0,0"/>

                            <ComboBox x:Name="cmbProyecto"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,4,0,0"
                                  Style="{StaticResource InputComboBoxStyle}"
                                      SelectionChanged="cmbProyecto_SelectionChanged"
                                      />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="410"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Grupo ASN -->
                            <GroupBox Grid.Column="0" Header="ASN">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="98"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="No. Factura:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                    <TextBox x:Name="txtNumeroFactura" Grid.Row="0" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="No. Guía:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                    <TextBox x:Name="txtNumeroGuia" Grid.Row="1" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ETA:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                    <DatePicker x:Name="dpEta" Grid.Row="2" Grid.Column="1" Style="{StaticResource InputDatePickerStyle}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Bultos:" Style="{StaticResource LabelStyle}" Margin="0,8,8,0"/>
                                    <TextBox x:Name="txtBultos"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                    <CheckBox x:Name="chkEsDevolucion"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Content="Devolución"
                                          Margin="0,4,0,10"/>

                                    <CheckBox x:Name="chkMovimientoRequeridoCliente"
                                          Grid.Row="5"
                                          Grid.Column="1"
                                          Content="Movimiento requerido por cliente"/>
                                </Grid>
                            </GroupBox>

                            <!-- Grupo Transporte -->
                            <GroupBox Grid.Column="2" Header="Transporte">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="51*"/>
                                        <ColumnDefinition Width="97*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Button x:Name="btnBuscarVehiculo"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Height="32"
                                        Padding="10,0"
                                        Click="BtnBuscarVehiculo_Click"
                                        Background="#F3F4F6"
                                        Foreground="#374151"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>

                                        <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE721;"
                                               Foreground="#2563EB"
                                               Margin="0,0,6,0"
                                               FontSize="12"/>
                                            <TextBlock Text="Buscar Vehiculo"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Línea de Transporte:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,12,8,0"
                                           VerticalAlignment="Top"/>
                                    <TextBox x:Name="txtLineaTransporte"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Tipo de vehículo:"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,12,8,0"
                                       VerticalAlignment="Top"/>
                                    <TextBox x:Name="txtTipoVehiculo"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Width="170"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="Nombre de chofer:"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,8,8,0"
                                       VerticalAlignment="Top"/>

                                    <!-- CAMBIO AQUÍ -->
                                    <TextBox x:Name="txtChofer"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.ColumnSpan="2"
                                         Margin="0,1,0,0"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="Placas:"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,13,8,0"
                                           VerticalAlignment="Top"/>
                                    <TextBox x:Name="txtPlacasVehiculo"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Grid.RowSpan="2"
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         Margin="0,35,0,0"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Text="Sello:"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,13,8,0"
                                       VerticalAlignment="Top"/>
                                    <TextBox x:Name="txtSelloTransporte"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Grid.RowSpan="2"
                                         Width="170"
                                         HorizontalAlignment="Left"
                                         Margin="0,34,0,0"
                                         Style="{StaticResource InputTextBoxStyle}"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sección central -->
                <Grid Grid.Row="2" Margin="16,1,16,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="btnGuardar"
                            Height="32"
                            Padding="10,0"
                            Click="BtnGuardar_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>

                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE74E;"
                                       Foreground="#15803D"
                                       Margin="0,0,6,0"
                                       FontSize="12"/>
                                <TextBlock Text="Guardar y continuar"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnEscanear"
                            Height="32"
                            Padding="10,0"
                            Click="BtnEscanear_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            Visibility="Collapsed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>

                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xEC5A;"
                                       Foreground="#2563EB"
                                       Margin="0,0,6,0"
                                       FontSize="12"/>
                                <TextBlock Text="Escanear"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="gridScanSection"
                      Grid.Row="1"
                      Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.1*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="bdPartidasAsn"
                            Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="180">
                            <DataGrid x:Name="dgDetail"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="True"
                                      IsReadOnly="False"
                                      ItemsSource="{Binding DetailItems}"
                                      InitializingNewItem="dgDetail_InitializingNewItem"
                                      CellEditEnding="dgDetail_CellEditEnding"
                                      CurrentCellChanged="dgDetail_CurrentCellChanged"
                                      PreviewKeyDown="dgDetail_PreviewKeyDown"
                                      
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      AlternatingRowBackground="{StaticResource AltRowBrush}"
                                      RowBackground="White"
                                      BorderThickness="0"
                                      RowHeight="26"
                                      ColumnHeaderHeight="32"
                                      FontSize="11"
                                      Margin="0"
                                      SelectionUnit="Cell"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Número de Parte" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PartNumber}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,0,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <common:InlineLookupEditor ItemsSource="{Binding DataContext.ProductLookupItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           DisplayMemberPath="Code"
                                                                           SearchMemberPaths="Code,Description"
                                                                           InitialText="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedCode="{Binding PartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedDescription="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedId="{Binding ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           RequireSelectionMatch="False"
                                                                           MaxResults="12"
                                                                           OpenDropDownOnLoad="True"
                                                                           SelectAllTextOnLoad="True"
                                                                           SelectionConfirmed="InlineLookup_SelectionConfirmed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Descripción"
                                       Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                        Width="220"
                                        IsReadOnly="True"/>



                                    <DataGridTextColumn Header="Cantidad"
                                        Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90"/>

                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,0,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <common:InlineLookupEditor ItemsSource="{Binding DataContext.StatusLookupItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           DisplayMemberPath="Code"
                                                                           SearchMemberPaths="Code,Description"
                                                                           InitialText="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedCode="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           RequireSelectionMatch="True"
                                                                           MaxResults="12"
                                                                           OpenDropDownOnLoad="True"
                                                                           SelectAllTextOnLoad="True"
                                                                           SelectionConfirmed="InlineLookup_SelectionConfirmed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="SD" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SD}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,0,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <common:InlineLookupEditor ItemsSource="{Binding DataContext.SdLookupItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           DisplayMemberPath="Code"
                                                                           SearchMemberPaths="Code,Description"
                                                                           InitialText="{Binding SD, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedCode="{Binding SD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           RequireSelectionMatch="True"
                                                                           MaxResults="12"
                                                                           OpenDropDownOnLoad="True"
                                                                           SelectAllTextOnLoad="True"
                                                                           SelectionConfirmed="InlineLookup_SelectionConfirmed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Número de Lote"
                                        Binding="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"/>

                                    <DataGridTextColumn Header="Fecha de Caducidad"
                                        Binding="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged, StringFormat=dd/MM/yyyy}"
                                        Width="150"/>

                                    <DataGridTextColumn Header="Referencia de Cliente"
                                        Binding="{Binding CustomerReference, UpdateSourceTrigger=PropertyChanged}"
                                        Width="160"/>

                                    <DataGridTextColumn Header="Tipo de Cambio"
                                        Binding="{Binding ExchangeRate, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"/>

                                    <DataGridTextColumn Header="Orden de Compra"
                                        Binding="{Binding PurchaseOrder, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"/>

                                    <DataGridTextColumn Header="Pedimento"
                                        Binding="{Binding CustomsDeclarationNumber, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"/>

                                    <DataGridTextColumn Header="Split"
                                    Binding="{Binding Split, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border x:Name="bdUbicacionesAsignadas"
                            Grid.Row="2"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="170">
                            <DataGrid x:Name="dgUbicacionesAsignadas"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="False"
                                  ItemsSource="{Binding ReceiptItems}"
                                  InitializingNewItem="dgUbicacionesAsignadas_InitializingNewItem"
                                  CellEditEnding="dgUbicacionesAsignadas_CellEditEnding"
                                  CurrentCellChanged="dgUbicacionesAsignadas_CurrentCellChanged"
                                  PreviewKeyDown="dgUbicacionesAsignadas_PreviewKeyDown"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  AlternatingRowBackground="{StaticResource AltRowBrush}"
                                  RowBackground="White"
                                  BorderThickness="0"
                                  RowHeight="26"
                                  ColumnHeaderHeight="32"
                                  FontSize="11"
                                  Margin="0"
                                  SelectionUnit="Cell"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="EstandarID" Binding="{Binding StandardId, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTextColumn Header="Número de Parte" Binding="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" Width="180" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="220" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Estandar" Binding="{Binding StandardQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTextColumn Header="Máxima" Binding="{Binding MaximumQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTextColumn Header="SD" Binding="{Binding SD, UpdateSourceTrigger=PropertyChanged}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Recibida" Binding="{Binding ReceivedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <DataGridTemplateColumn Header="Ubicación" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LocationCode}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0,0,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <common:InlineLookupEditor ItemsSource="{Binding DataContext.LocationLookupItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           DisplayMemberPath="Code"
                                                                           SearchMemberPaths="Code,Description"
                                                                           InitialText="{Binding LocationCode, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedCode="{Binding LocationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           SelectedId="{Binding LocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                           RequireSelectionMatch="True"
                                                                           MaxResults="12"
                                                                           OpenDropDownOnLoad="True"
                                                                           SelectAllTextOnLoad="True"
                                                                           SelectionConfirmed="InlineLookup_SelectionConfirmed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Número de Lote" Binding="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                    <DataGridTextColumn Header="Fecha de Caducidad" Binding="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged, StringFormat=dd/MM/yyyy}" Width="150"/>
                                    <DataGridTextColumn Header="Referencia" Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Botones inferiores -->
                <Border Grid.Row="3"
                    Background="#F3F4F6"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="10,6">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">


                        <Button x:Name="btnCerrar"
                            Content="Cerrar"
                            Width="116"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0"
                            Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
