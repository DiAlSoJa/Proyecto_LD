<Window x:Class="LD.FormsX.Views.Dialogs.CuadreASNView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cuadre ASN"
        Width="1400"
        Height="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceTabHeader}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Border Margin="24"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                Effect="{StaticResource DialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cuadre ASN"
                                       Foreground="{StaticResource TextOnPrimary}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AsnHeaderText}"
                                       Foreground="{StaticResource TextOnPrimary}"
                                       FontSize="12"
                                       Opacity="0.92"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button x:Name="btnClose"
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnClose_Click"
                                Content="×"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="24,20,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding AsnMetaText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBody}"/>
                        <TextBlock Text="{Binding SummaryText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceCard}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <DataGrid x:Name="dgCuadre"
                                      AutoGenerateColumns="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      AlternatingRowBackground="{StaticResource DataGridAltRow}"
                                      AlternationCount="2"
                                      RowHeight="28"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                            <Border x:Name="loadingOverlay"
                                    Background="{StaticResource LoadingOverlayBg}"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="220"
                                                 Height="18"/>
                                    <TextBlock x:Name="txtLoading"
                                               Text="Cargando cuadre..."
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextOnLoading}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Margin="2,10,0,0"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"/>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceTabHeader}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <Grid Margin="24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Usa los filtros del encabezado del grid para revisar y exportar las lineas visibles."
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                        <Button x:Name="btnFooterClose"
                                Grid.Column="1"
                                Style="{StaticResource FooterButtonStyle}"
                                Click="BtnClose_Click"
                                Content="Cerrar"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
