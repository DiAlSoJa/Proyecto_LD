<UserControl x:Class="LD.FormsX.Views.ASN.ASNView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="2.2*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="2.3*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="6"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="ASN"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                   
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Cliente:"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <ComboBox x:Name="cmbCliente"
                          Grid.Column="2"
                          Height="28"
                          Padding="4,0"
                          FontSize="11"
                          VerticalContentAlignment="Center"
                          SelectionChanged="cmbCliente_SelectionChanged"/>

                <TextBlock Grid.Column="4"
                           Text="Proyecto:"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <ComboBox x:Name="cmbProyecto"
                          Grid.Column="5"
                          Height="28"
                          Padding="4,0"
                          FontSize="11"
                          VerticalContentAlignment="Center"
                          SelectionChanged="cmbProyecto_SelectionChanged"/>

               <Button x:Name="BtnActualizar"
		            Grid.Column="7"
		            Height="32"
		            Padding="8,0"
		            Click="BtnActualizar_Click"
		            Background="#F3F4F6"
		            Foreground="#374151"
		            BorderBrush="#D1D5DB"
		            BorderThickness="1"
		            Cursor="Hand">

	            <Button.Resources>
		            <Style TargetType="Border">
			            <Setter Property="CornerRadius" Value="6"/>
		            </Style>
	            </Button.Resources>

	            <StackPanel Orientation="Horizontal"
		            VerticalAlignment="Center"
		            HorizontalAlignment="Center">

		            <TextBlock FontFamily="Segoe MDL2 Assets"
		               Text="&#xE895;"
		               Foreground="#10B981"
		               Margin="0,0,5,0"
		               FontSize="12"/>

		            <TextBlock Text="Actualizar"
                               FontSize="11"/>
	            </StackPanel>
            </Button>
                

                <Button x:Name="btnNuevo"
	            Grid.Column="9"
	            Height="32"
	            Padding="8,0"
	            Click="BtnNuevoASN_Click"
	            Background="#F3F4F6"
	            Foreground="#374151"
	            BorderBrush="#D1D5DB"
	            BorderThickness="1"
	            Cursor="Hand">

	            <Button.Resources>
		            <Style TargetType="Border">
			            <Setter Property="CornerRadius" Value="6"/>
		            </Style>
	            </Button.Resources>

	            <StackPanel Orientation="Horizontal"
		            VerticalAlignment="Center"
		            HorizontalAlignment="Center">

		            <TextBlock FontFamily="Segoe MDL2 Assets"
		                Text="&#xE710;"
		                Foreground="#2563EB"
		                Margin="0,0,5,0"
		                FontSize="12"/>

		            <TextBlock Text="Nuevo ASN"
                               FontSize="11"/>
	            </StackPanel>
            </Button>

                <Button x:Name="btnEditar"
                    Grid.Column="11"
                    Height="32"
                    Padding="8,0"
                    Click="BtnEditar_Click"
                    Background="#F3F4F6"
                    Foreground="#374151"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

                        <TextBlock FontFamily="Segoe MDL2 Assets"
            Text="&#xE70F;"
            Foreground="#F59E0B"
            Margin="0,0,5,0"
            FontSize="12"/>

                        <TextBlock Text="Editar"
                                   FontSize="11"/>
                    </StackPanel>
                </Button>
                

                <Button x:Name="btnRegistrar"
	                Grid.Column="13"
	                Height="32"
	                Padding="8,0"
	                Click="BtnRegistrarArribo_Click"
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Asssets"
		                   Text="&#xE710;"
		                   Foreground="#10B981"
		                   Margin="0,0,5,0"
		                   FontSize="12"/>

		                <TextBlock Text="Registrar Arribo"
                                   FontSize="11"/>
	                </StackPanel>
                </Button>
               
            </Grid>
        </Border>

        <!-- Grid ASN principal -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dgASN"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  RowHeight="26"
                                  ColumnHeaderHeight="32"
                                  FontSize="11"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgASN_SelectionChanged">
                        

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border x:Name="LoadingOverlayASN"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoadingASN"
                                           Text="Cargando ASN..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Grid detalle / escaneo -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtStatusDetalle"
                               Grid.Column="0"
                               Text="Sin detalle para mostrar"
                               FontSize="8"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0"/>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dgDetalleASN"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgDetalleASN_SelectionChanged">
                         
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border x:Name="LoadingOverlayDetalle"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoadingDetalle"
                                           Text="Cargando detalle..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Grid recepción -->
        <Border Grid.Row="6"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatusRecepcion"
                           Grid.Row="0"
                           Text="Sin partidas recibidas"
                           FontSize="8"
                           Foreground="#6B7280"
                           Margin="0,0,0,0"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dgRecepcionASN"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                         

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border x:Name="LoadingOverlayRecepcion"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoadingRecepcion"
                                           Text="Cargando recepción..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
