<UserControl x:Class="LD.FormsX.Views.CheckList.Tabs.ConfiguracionPreguntasTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtro tipo equipo -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Tipo:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#374151"/>

                <ComboBox x:Name="cmbTipoPregunta"
                          Grid.Column="1"
                          Height="38"
                          FontSize="13"
                          VerticalContentAlignment="Center"
                          SelectionChanged="cmbTipoPregunta_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Formulario y lista -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Formulario de pregunta -->
            <Border Grid.Row="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16">
                <GroupBox Header="Preguntas" FontWeight="SemiBold" Foreground="#1F2937">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Texto de pregunta -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pregunta:" VerticalAlignment="Center" FontSize="13" Foreground="#374151"/>
                            <TextBox x:Name="txtPregunta"
                                     Grid.Column="1"
                                     Height="38"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     BorderBrush="#D1D5DB"/>
                        </Grid>

                        <!-- Tipo de respuesta -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Respuesta:" VerticalAlignment="Top" FontSize="13" Foreground="#374151"/>
                            <RadioButton x:Name="rbSiNo"
                                         Grid.Column="1"
                                         Content="Si / No"
                                         VerticalAlignment="Center"
                                         IsChecked="True"
                                         Checked="TipoRespuesta_Checked"/>
                            <RadioButton x:Name="rbOpciones"
                                         Grid.Column="3"
                                         Content="Opciones (una por línea)"
                                         VerticalAlignment="Center"
                                         Checked="TipoRespuesta_Checked"/>
                        </Grid>

                        <!-- Opciones -->
                        <TextBox x:Name="txtOpciones"
                                 Grid.Row="4"
                                 Width="420"
                                 HorizontalAlignment="Left"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="120"
                                 BorderBrush="#D1D5DB"
                                 IsEnabled="False"/>

                        <!-- Botón guardar -->
                        <Button x:Name="btnGuardarPregunta"
                                Grid.Row="6"
                                Height="38"
                                Padding="2,0"
                                Background="#F3F4F6"
                                Foreground="#374151"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Cursor="Hand"
                                Margin="0,0,521,0"
                                Click="BtnGuardarPregunta_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" Foreground="#2563EB" Margin="0,0,6,0" FontSize="14"/>
                                <TextBlock x:Name="txtBtnGuardar" Text="Guardar"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </GroupBox>
            </Border>

            <!-- Lista de preguntas configuradas -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Preguntas configuradas"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="btnEditarPregunta"
                                Grid.Column="1"
                                Height="38"
                                Padding="12,0"
                                Background="#F3F4F6"
                                Foreground="#374151"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Cursor="Hand"
                                IsEnabled="False"
                                Click="BtnEditarPregunta_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Foreground="#F59E0B" Margin="0,0,6,0" FontSize="14"/>
                                <TextBlock Text="Editar"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnEliminarPregunta"
                                Grid.Column="3"
                                Height="38"
                                Padding="12,0"
                                Background="#F3F4F6"
                                Foreground="#374151"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Cursor="Hand"
                                IsEnabled="False"
                                Click="BtnEliminarPregunta_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Foreground="#B91C1C" Margin="0,0,6,0" FontSize="14"/>
                                <TextBlock Text="Eliminar"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4" Background="White">
                        <DataGrid x:Name="dgPreguntas"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgPreguntas_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pregunta" Binding="{Binding QuestionText}"    Width="420"/>
                                <DataGridTextColumn Header="Opciones" Binding="{Binding OptionAnswerText}" Width="320"/>
                            </DataGrid.Columns>
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell"         BasedOn="{StaticResource GridCellStyle}"/>
                                <Style TargetType="DataGridRow"          BasedOn="{StaticResource GridRowStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
