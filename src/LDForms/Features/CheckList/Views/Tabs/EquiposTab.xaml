<UserControl x:Class="LD.FormsX.Views.CheckList.Tabs.EquiposTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de acciones -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Checklist de equipos"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Administración de equipos y usuarios"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="BtnActualizar"
                        Grid.Column="1"
                        Height="38"
                        Padding="12,0"
                        Click="BtnActualizar_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" Foreground="#10B981" Margin="0,0,6,0" FontSize="14"/>
                        <TextBlock Text="Actualizar"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnAsignarUsuario"
                        Grid.Column="3"
                        Height="38"
                        Padding="12,0"
                        Click="BtnAsignarUsuario_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="3"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Foreground="#10B981" Margin="0,0,6,0" FontSize="14"/>
                        <TextBlock Text="Asignar usuario"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnNuevo"
                        Grid.Column="5"
                        Height="38"
                        Padding="12,0"
                        Click="BtnNuevoEquipo_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" Foreground="#2563EB" Margin="0,0,6,0" FontSize="14"/>
                        <TextBlock Text="Nuevo"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnEditar"
                        Grid.Column="7"
                        Height="38"
                        Padding="12,0"
                        Click="BtnEditarEquipo_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Foreground="#F59E0B" Margin="0,0,6,0" FontSize="14"/>
                        <TextBlock Text="Editar"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnEliminar"
                        Grid.Column="9"
                        Height="38"
                        Padding="12,0"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Foreground="#B91C1C" Margin="0,0,6,0" FontSize="14"/>
                        <TextBlock Text="Eliminar"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Grid de equipos -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatusEquipo"
                           Grid.Row="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <DataGrid x:Name="dgEquipo"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              RowHeight="28"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              VerticalGridLinesBrush="#D9D9D9"
                              HorizontalGridLinesBrush="#E4E8EE"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgEquipo_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo"         Binding="{Binding Tipo}"      Width="130"/>
                            <DataGridTextColumn Header="No. de Equipo" Binding="{Binding NoEquipo}" Width="140"/>
                            <DataGridTextColumn Header="Serie"        Binding="{Binding Serie}"     Width="130"/>
                            <DataGridTextColumn Header="Marca"        Binding="{Binding Marca}"     Width="130"/>
                            <DataGridTextColumn Header="Operativo"    Binding="{Binding Operativo}" Width="130"/>
                            <DataGridTextColumn Header="Proveedor"    Binding="{Binding Proveedor}" Width="130"/>
                            <DataGridTextColumn Header="Turno 1"      Binding="{Binding Turno1}"    Width="125"/>
                            <DataGridTextColumn Header="Turno 2"      Binding="{Binding Turno2}"    Width="125"/>
                            <DataGridTextColumn Header="Turno 3"      Binding="{Binding Turno3}"    Width="125"/>
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                            <Style TargetType="DataGridCell"         BasedOn="{StaticResource GridCellStyle}"/>
                            <Style TargetType="DataGridRow"          BasedOn="{StaticResource GridRowStyle}"/>
                        </DataGrid.Resources>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
