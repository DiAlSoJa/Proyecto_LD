<UserControl x:Class="LD.FormsX.Views.CheckList.Tabs.ResumenTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Desde:" VerticalAlignment="Center" FontSize="13" Foreground="#374151"/>
                <DatePicker x:Name="dpResumenDesde" Grid.Column="1" Height="38" FontSize="13" SelectedDateFormat="Short" BorderBrush="#D1D5DB" Background="White"/>
                <TextBlock Grid.Column="3" Text="Hasta:" VerticalAlignment="Center" FontSize="13" Foreground="#374151"/>
                <DatePicker x:Name="dpResumenHasta" Grid.Column="4" Height="38" FontSize="13" SelectedDateFormat="Short" BorderBrush="#D1D5DB" Background="White"/>

                <Button x:Name="btnBuscar"
                        Grid.Column="6"
                        Height="38"
                        Padding="12,0"
                        Click="BtnBuscar_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" Foreground="#2563EB" Margin="0,0,6,0" FontSize="14"/>
                        <TextBlock Text="Buscar"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido: lista + detalle -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista principal -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtStatusResumen"
                               Grid.Row="0"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="4,0,0,8"/>

                    <Border Grid.Row="2" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4" Background="White">
                        <DataGrid x:Name="dgResumen"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgResumen_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Defectos"     Binding="{Binding TotalDefects}"    Width="90"/>
                                <DataGridTextColumn Header="Horometro"    Binding="{Binding Hourmeter}"        Width="110"/>
                                <DataGridTextColumn Header="Fecha"        Binding="{Binding FechaDisplay}"    Width="100"/>
                                <DataGridTextColumn Header="Turno"        Binding="{Binding Turno}"           Width="100"/>
                                <DataGridTextColumn Header="Operador"     Binding="{Binding UserName}"        Width="150"/>
                                <DataGridTextColumn Header="Tipo"         Binding="{Binding EquipmentTypeName}" Width="130"/>
                                <DataGridTextColumn Header="No. de Equipo" Binding="{Binding EquipmentName}"  Width="130"/>
                                <DataGridTextColumn Header="Serie"        Binding="{Binding SerialNumber}"    Width="110"/>
                                <DataGridTextColumn Header="Marca"        Binding="{Binding Brand}"           Width="110"/>
                                <DataGridTextColumn Header="Operativo"    Binding="{Binding OperativoDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Proveedor"    Binding="{Binding SupplierName}"    Width="120"/>
                            </DataGrid.Columns>
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell"         BasedOn="{StaticResource GridCellStyle}"/>
                                <Style TargetType="DataGridRow"          BasedOn="{StaticResource GridRowStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel de detalle -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1.3*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detalle" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" Margin="4,0,0,0"/>
                            <Button x:Name="BtnVerImagenes"
                                    Grid.Column="1"
                                    Height="34"
                                    Content="Ver imágenes"
                                    Click="BtnVerImagenes_Click"
                                    Background="White"
                                    Foreground="#111827"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Cursor="Hand"/>
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4" Background="White">
                            <DataGrid x:Name="dgResumenDetalle"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28"
                                      ColumnHeaderHeight="40"
                                      FontSize="12"
                                      VerticalGridLinesBrush="#D9D9D9"
                                      HorizontalGridLinesBrush="#E4E8EE">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo"  Binding="{Binding Tipo}"  Width="140"/>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="220"/>
                                </DataGrid.Columns>
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                    <Style TargetType="DataGridCell"         BasedOn="{StaticResource GridCellStyle}"/>
                                    <Style TargetType="DataGridRow"          BasedOn="{StaticResource GridRowStyle}"/>
                                </DataGrid.Resources>
                            </DataGrid>
                        </Border>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Observaciones" FontSize="13" Foreground="#374151" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtObservacionesResumen"
                                     Height="40"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderBrush="#D1D5DB"
                                     IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Imágenes con marcas de daños -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB" Padding="2">
                            <Grid>
                                <Image x:Name="imgMontacargasIzq"
                                       Source="/Resources/Images/montacargas_hp_izq.png"
                                       Width="193"
                                       Height="331"
                                       Stretch="Uniform"/>
                                <Canvas x:Name="canvasIzq"
                                        Width="193"
                                        Height="331"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="10" BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB" Padding="8">
                            <Grid>
                                <Image x:Name="imgMontacargasDer"
                                       Source="/Resources/Images/montacargas_hp_der.png"
                                       Width="193"
                                       Height="331"
                                       Stretch="Uniform"/>
                                <Canvas x:Name="canvasDer"
                                        Width="193"
                                        Height="331"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
