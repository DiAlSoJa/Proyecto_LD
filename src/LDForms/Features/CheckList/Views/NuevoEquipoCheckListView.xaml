<Window x:Class="LD.FormsX.Views.CheckList.NuevoEquipoCheckListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nuevo Equipo"
        Height="560"
        Width="1160"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#233167"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F3F4F6"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#233167"
                    CornerRadius="12,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Nuevo Equipo"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <Button x:Name="BtnCloseHeader"
                            Grid.Column="1"
                            Content="✕"
                            Click="BtnCerrar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="26,22,26,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Tipo:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <ComboBox x:Name="cmbTipo"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Height="30"
                                  FontSize="13"
                                  Padding="8,0"
                                  VerticalContentAlignment="Center"
                                  BorderBrush="#9CA3AF"
                                  Background="White"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="No. Equipo:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <TextBox x:Name="txtNoEquipo"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Height="30"
                                 FontSize="13"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#9CA3AF"
                                 Background="White"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Serie:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <TextBox x:Name="txtSerie"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Height="30"
                                 FontSize="13"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#9CA3AF"
                                 Background="White"/>

                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Marca:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <TextBox x:Name="txtMarca"
                                 Grid.Row="6"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Height="30"
                                 FontSize="13"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#9CA3AF"
                                 Background="White"/>

                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   Text="Horometro:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <TextBox x:Name="txtHorometro"
                                 Grid.Row="8"
                                 Grid.Column="1"
                                 Height="30"
                                 FontSize="13"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#9CA3AF"
                                 Background="White"/>

                        <TextBlock Grid.Row="10"
                                   Grid.Column="0"
                                   Text="Operativo:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <StackPanel Grid.Row="10"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <RadioButton x:Name="rbSi"
                                         Content="Sí"
                                         GroupName="Operativo"
                                         FontSize="13"
                                         Margin="0,0,26,0"/>
                            <RadioButton x:Name="rbNo"
                                         Content="No"
                                         GroupName="Operativo"
                                         FontSize="13"/>
                        </StackPanel>

                        <TextBlock Grid.Row="12"
                                   Grid.Column="0"
                                   Text="Proveedor:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <ComboBox x:Name="cmbProveedor"
                                  Grid.Row="12"
                                  Grid.Column="1"
                                  Height="30"
                                  FontSize="13"
                                  Padding="8,0"
                                  VerticalContentAlignment="Center"
                                  BorderBrush="#9CA3AF"
                                  Background="White"/>

                        <!-- Imagen Izquierda -->
                        <TextBlock Grid.Row="14"
                                   Grid.Column="0"
                                   Text="Img. Izquierda:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <Grid Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtImagenIzq"
                                     Grid.Column="0"
                                     Height="30"
                                     FontSize="12"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     BorderBrush="#9CA3AF"
                                     Background="#F9FAFB"/>
                            <Button x:Name="btnCargarIzq"
                                    Grid.Column="2"
                                    Height="30"
                                    Content="Cargar imagen"
                                    Click="BtnCargarImagenIzq_Click"
                                    Background="#F3F4F6"
                                    Foreground="#374151"
                                    BorderBrush="#D1D5DB"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Image x:Name="imgPreviewIzq"
                                   Grid.Column="4"
                                   Height="50"
                                   Width="70"
                                   Stretch="Uniform"/>
                        </Grid>

                        <!-- Imagen Derecha -->
                        <TextBlock Grid.Row="16"
                                   Grid.Column="0"
                                   Text="Img. Derecha:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#111827"/>

                        <Grid Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtImagenDer"
                                     Grid.Column="0"
                                     Height="30"
                                     FontSize="12"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     BorderBrush="#9CA3AF"
                                     Background="#F9FAFB"/>
                            <Button x:Name="btnCargarDer"
                                    Grid.Column="2"
                                    Height="30"
                                    Content="Cargar imagen"
                                    Click="BtnCargarImagenDer_Click"
                                    Background="#F3F4F6"
                                    Foreground="#374151"
                                    BorderBrush="#D1D5DB"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Image x:Name="imgPreviewDer"
                                   Grid.Column="4"
                                   Height="50"
                                   Width="70"
                                   Stretch="Uniform"/>
                        </Grid>

                        <Button x:Name="btnNuevo"
                                Grid.Row="12"
                                Grid.Column="3"
                                Height="38"
                                Padding="12,0"
                                Margin="0,0,0,0"
                                Background="#F3F4F6"
                                Foreground="#374151"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Cursor="Hand">

                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE710;"
                                           Foreground="#2563EB"
                                           Margin="0,0,6,0"
                                           FontSize="14"/>

                                <TextBlock Text="Nuevo"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                    <Button x:Name="btnSave"
                            Content="Guardar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"/>

                    <Button x:Name="button2"
                            Content="Cerrar"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
