<Window x:Class="LD.FormsX.Features.Embarques.Views.SeleccionCargaExistenteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar carga existente"
        Width="1020"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid Background="Transparent">
        <Border x:Name="MainBorder"
                Background="White"
                CornerRadius="18"
                Padding="22"
                Margin="16"
                MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="4"
                                  Opacity="0.20"
                                  Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnClose"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#888888"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnClose_Click"
                        Content="✕"/>

                <StackPanel Grid.Row="1"
                            Margin="0,2,0,0">
                    <TextBlock Text="Seleccionar carga existente"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#111111"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <TextBlock x:Name="TxtContext"
                               FontSize="14"
                               Foreground="#6B7280"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,18,0,12"
                        Background="#F7F7F7"
                        CornerRadius="10"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtBuscar"
                                 Height="30"
                                 Padding="10,3"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 TextChanged="txtBuscar_TextChanged"
                                 KeyDown="txtBuscar_KeyDown"/>

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="BtnBuscar_Click"
                                Background="#EEF2FF"
                                BorderBrush="#C7D2FE"
                                BorderThickness="1"
                                Cursor="Hand"
                                Focusable="False">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE721;"
                                           Foreground="#4F46E5"
                                           FontSize="13"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Buscar" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Background="#FAFAFA"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="0">
                    <DataGrid x:Name="dgOpciones"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              ItemsSource="{Binding FilteredItems}"
                              SelectionChanged="dgOpciones_SelectionChanged"
                              MouseDoubleClick="dgOpciones_MouseDoubleClick"
                              PreviewKeyDown="dgOpciones_PreviewKeyDown"
                              FontSize="12"
                              RowHeight="30"
                              ColumnHeaderHeight="32"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Orden de entrega"
                                                Binding="{Binding DeliveryOrderCode}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Kitting"
                                                Binding="{Binding KittingCode}"
                                                Width="170"/>
                            <DataGridTextColumn Header="Kittings"
                                                Binding="{Binding KittingsCount}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Client}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Proyecto"
                                                Binding="{Binding Project}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button x:Name="BtnAceptar"
                            Width="120"
                            Height="40"
                            Margin="0,0,10,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="BtnAceptar_Click"
                            IsDefault="True"
                            IsEnabled="False"
                            Content="Aceptar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnCancelar"
                            Width="120"
                            Height="40"
                            Background="#EAEAEA"
                            Foreground="#333333"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            IsCancel="True"
                            Click="BtnCancelar_Click"
                            Content="Cancelar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
