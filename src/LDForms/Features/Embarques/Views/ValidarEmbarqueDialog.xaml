<Window x:Class="LD.FormsX.Features.Embarques.Views.ValidarEmbarqueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Validar embarque"
        Width="1280"
        Height="860"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#233167"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#F8FAFC"/>

        <Style TargetType="Button" x:Key="DialogActionButtonStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ScanTextBoxStyle">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="14"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Validar embarque"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding KittingSummary}"
                                   FontSize="12"
                                   Foreground="#E5E7EB"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="X"
                            Width="34"
                            Height="34"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#FFFFFF"
                            BorderBrush="#FFFFFF"
                            Foreground="{StaticResource PrimaryBrush}"
                            Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Escaneo"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtEscaneo"
                             Style="{StaticResource ScanTextBoxStyle}"
                             KeyDown="TxtEscaneo_KeyDown"/>
                </StackPanel>

                <TextBox x:Name="txtUltimoMensaje"
                         Grid.Row="2"
                         Height="36"
                         Padding="10,4"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextWrapping="NoWrap"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True"
                         Background="#F0FDF4"
                         Foreground="#166534"
                         BorderBrush="#22C55E"
                         BorderThickness="1"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Validación"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding SurtidoCountText}"
                                           FontSize="11"
                                           Foreground="#6B7280"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Border Grid.Row="2"
                                    BorderBrush="#D9DEE7"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <DataGrid x:Name="dgSurtido"
                                          ItemsSource="{Binding SurtidoItems}"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="36"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          AlternatingRowBackground="{StaticResource AltRowBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="StandardIdStr" Binding="{Binding StandardIdStr}" Width="120"/>
                                        <DataGridTextColumn Header="Numero de parte" Binding="{Binding PartNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding ReceivedQuantity}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="12"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Cargando"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ValidadoCountText}"
                                           FontSize="11"
                                           Foreground="#6B7280"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Border Grid.Row="2"
                                    BorderBrush="#D9DEE7"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <DataGrid x:Name="dgValidado"
                                          ItemsSource="{Binding ValidadoItems}"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="36"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          AlternatingRowBackground="{StaticResource AltRowBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="StandardIdStr" Binding="{Binding StandardIdStr}" Width="120"/>
                                        <DataGridTextColumn Header="Numero de parte" Binding="{Binding PartNumber}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding ReceivedQuantity}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F3F4F6"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnCerrar"
                            Content="Cerrar"
                            Width="120"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Background="White"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
