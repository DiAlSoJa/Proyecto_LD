<UserControl x:Class="LD.FormsX.Features.Embarques.Views.EmbarquesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:LD.FormsX.Features.Common"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="2.2*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="2.3*"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="6"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Embarques"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Cliente:"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <common:InlineLookupEditor x:Name="lookupCliente"
                                           Grid.Column="2"
                                           Height="28"
                                           Tag="Cliente|Clave"
                                           ItemsSource="{Binding ClientLookupItems}"
                                           DisplayMemberPath="Code"
                                           SearchMemberPaths="Code,Description"
                                           SelectedCode="{Binding SelectedClientText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           SelectedId="{Binding SelectedClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           EditorCornerRadius="10"
                                           EditorPadding="14,6,8,6"
                                           EditorBorderBrush="#D1D5DB"
                                           EditorBorderThickness="1.2"
                                           EditorForeground="#1F2937"
                                           EditorFontSize="12"
                                           GlyphBrush="#94A3B8"
                                           RequireSelectionMatch="True"
                                           MaxResults="12"
                                           OpenDropDownOnLoad="False"
                                           SelectAllTextOnLoad="False"
                                           SelectionConfirmed="LookupCliente_SelectionConfirmed"/>

                <TextBlock Grid.Column="4"
                           Text="Proyecto:"
                           FontSize="11"
                           Foreground="#4B5563"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <common:InlineLookupEditor x:Name="lookupProyecto"
                                           Grid.Column="5"
                                           Height="28"
                                           Tag="Proyecto|Clave"
                                           ItemsSource="{Binding ProjectLookupItems}"
                                           DisplayMemberPath="Code"
                                           SearchMemberPaths="Code,Description"
                                           SelectedCode="{Binding SelectedProjectText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           SelectedId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           EditorCornerRadius="10"
                                           EditorPadding="14,6,8,6"
                                           EditorBorderBrush="#D1D5DB"
                                           EditorBorderThickness="1.2"
                                           EditorForeground="#1F2937"
                                           EditorFontSize="12"
                                           GlyphBrush="#94A3B8"
                                           RequireSelectionMatch="True"
                                           MaxResults="12"
                                           OpenDropDownOnLoad="False"
                                           SelectAllTextOnLoad="False"
                                           SelectionConfirmed="LookupProyecto_SelectionConfirmed"/>

                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <ComboBox x:Name="cmbFiltroEmbarques"
                              Width="150"
                              Height="28"
                              Margin="0,0,0,0"
                              Padding="5,1"
                              FontSize="12"
                              Background="White"
                              BorderBrush="#D1D5DB"
                              BorderThickness="1"
                              VerticalAlignment="Center"
                              SelectionChanged="CmbFiltroEmbarques_SelectionChanged"
                              Cursor="Hand">
                        <ComboBoxItem Content="Ver validación" Tag="Validación"/>
                        <ComboBoxItem Content="Ver cargando" Tag="Cargando"/>
                    </ComboBox>

                    <Button x:Name="BtnActualizar"
                            Height="28"
                            MinWidth="68"
                            Padding="6,0"
                            Margin="8,0,0,0"
                            Click="BtnActualizar_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE895;"
                                       Foreground="#10B981"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Actualizar" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button x:Name="btnCancelar"
                        Grid.Column="9"
                        Height="28"
                        MinWidth="72"
                        Padding="6,0"
                        Click="BtnCancelar_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE711;"
                                   Foreground="#DC2626"
                                   Margin="0,0,4,0"
                                   FontSize="12"/>
                        <TextBlock Text="Cancelar" FontSize="11"/>
                    </StackPanel>
                </Button>

                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="10"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Left">
                    <Button x:Name="btnNuevo"
                            Visibility="Collapsed"
                            Height="28"
                            MinWidth="68"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnNuevo_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE710;"
                                       Foreground="#2563EB"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Nuevo" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnEditar"
                            Visibility="Collapsed"
                            Height="28"
                            MinWidth="176"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnEditar_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE70F;"
                                       Foreground="#F59E0B"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Editar transporte y entrega" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnEnviarASurtir"
                            Visibility="Collapsed"
                            Height="28"
                            MinWidth="128"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnEnviarASurtir_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE707;"
                                       Foreground="#0D9488"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Enviar a surtir" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnConfirmar"
                            Visibility="Collapsed"
                            Height="28"
                            MinWidth="96"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnConfirmar_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE73E;"
                                       Foreground="#2563EB"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Validación" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnListaSurtido"
                            Height="28"
                            MinWidth="132"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnListaSurtido_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE749;"
                                       Foreground="#374151"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Lista de validación" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnValidar"
                            Height="28"
                            MinWidth="92"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnValidar_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE73E;"
                                       Foreground="#2563EB"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Validar" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnImprimirDO"
                            Height="28"
                            MinWidth="110"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnImprimirDO_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE7C3;"
                                       Foreground="#0F766E"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Vista previa DO" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnCargar"
                            Visibility="Collapsed"
                            Height="28"
                            MinWidth="84"
                            Padding="6,0"
                            Margin="0,0,8,0"
                            Click="BtnCargar_Click"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE73E;"
                                       Foreground="#0E7490"
                                       Margin="0,0,4,0"
                                       FontSize="12"/>
                            <TextBlock Text="Cargar" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <DataGrid x:Name="dgKitting"
                          AutoGenerateColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          AlternatingRowBackground="#F8FAFC"
                          AlternationCount="2"
                          RowHeight="26"
                          ColumnHeaderHeight="32"
                          FontSize="11"
                          VerticalGridLinesBrush="#D9D9D9"
                          HorizontalGridLinesBrush="#E4E8EE"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="dgKitting_SelectionChanged"
                          AutoGeneratingColumn="dgKitting_AutoGeneratingColumn"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatusDetalle"
                           Grid.Row="0"
                           Text="Sin detalle para mostrar"
                           FontSize="8"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <DataGrid x:Name="dgDetalleKitting"
                              AutoGenerateColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              AlternatingRowBackground="#F8FAFC"
                              AlternationCount="2"
                              RowHeight="28"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              VerticalGridLinesBrush="#D9D9D9"
                              HorizontalGridLinesBrush="#E4E8EE"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgDetalleKitting_SelectionChanged"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatusIssues"
                           Grid.Row="0"
                           Text="Sin issues para mostrar"
                           FontSize="8"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <DataGrid x:Name="dgIssueKitting"
                              AutoGenerateColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              AlternatingRowBackground="#F8FAFC"
                              AlternationCount="2"
                              RowHeight="28"
                              ColumnHeaderHeight="40"
                              FontSize="12"
                              VerticalGridLinesBrush="#D9D9D9"
                              HorizontalGridLinesBrush="#E4E8EE"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
