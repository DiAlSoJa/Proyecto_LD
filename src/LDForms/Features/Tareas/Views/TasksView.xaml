<UserControl x:Class="LD.FormsX.Views.Tareas.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LD.FormsX.Views.Tareas"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/ElegantTabStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:TaskStatusConverter x:Key="TaskStatusConverter"/>
            <local:WarehouseTaskStatusConverter x:Key="WarehouseTaskStatusConverter"/>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FilterInputStyle" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <TabControl Style="{StaticResource ElegantTabControlStyle}">

        <TabItem Header="Tareas" Style="{StaticResource ElegantTabItemStyle}">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Tareas"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta tareas operativas y sus evidencias"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="2">
                    <StackPanel Width="140" Margin="0,0,10,10">
                        <TextBlock Text="Desde" Style="{StaticResource FilterLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding Desde, Mode=TwoWay}" Style="{StaticResource FilterInputStyle}"/>
                    </StackPanel>

                    <StackPanel Width="140" Margin="0,0,10,10">
                        <TextBlock Text="Hasta" Style="{StaticResource FilterLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding Hasta, Mode=TwoWay}" Style="{StaticResource FilterInputStyle}"/>
                    </StackPanel>

                    <StackPanel Width="220" Margin="0,0,10,10">
                        <TextBlock Text="Almacen" Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}"
                                  DisplayMemberPath="NombreAlmacen"
                                  IsTextSearchEnabled="True"
                                  Style="{StaticResource FilterInputStyle}"/>
                    </StackPanel>

                    <StackPanel Width="170" Margin="0,0,10,10">
                        <TextBlock Text="Estatus" Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                  Style="{StaticResource FilterInputStyle}"/>
                    </StackPanel>

                    <Button Height="34"
                            MinWidth="110"
                            Margin="0,18,8,10"
                            Command="{Binding CargarDatosCommand}"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="Buscar"/>
                    </Button>

                    <Button Height="34"
                            MinWidth="110"
                            Margin="0,18,0,10"
                            Command="{Binding LimpiarFiltrosCommand}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand">
                        <TextBlock Text="Limpiar"/>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,0"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="TasksGrid"
                                  ItemsSource="{Binding Tasks}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  MouseDoubleClick="TasksGrid_MouseDoubleClick"
                                  Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Folio" Binding="{Binding OperationalTaskId}" Width="80"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                                <DataGridTextColumn Header="Almacen" Binding="{Binding WarehouseName}" Width="160"/>
                                <DataGridTextColumn Header="Estatus" Binding="{Binding Completed, Converter={StaticResource TaskStatusConverter}}" Width="110"/>
                                <DataGridTextColumn Header="Prioridad" Binding="{Binding Priority}" Width="110"/>
                                <DataGridTextColumn Header="Actividad" Binding="{Binding Activity}" Width="180"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}" Width="260"/>
                                <DataGridTextColumn Header="Finalizado" Binding="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                                <DataGridTextColumn Header="Finalizo" Binding="{Binding CompletedByName}" Width="150"/>
                                <DataGridTextColumn Header="Observaciones" Binding="{Binding ResolutionObservations}" Width="260"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border Background="#80FFFFFF"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock Text="{Binding LoadingMessage}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
        </TabItem>

        <TabItem Header="Tareas asignadas" Style="{StaticResource ElegantTabItemStyle}">
            <Grid Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AsignadasStatusText}"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <Button Content="Actualizar"
                            Height="28"
                            MinWidth="90"
                            Margin="12,0,0,0"
                            Padding="10,0"
                            Command="{Binding CargarTareasAsignadasCommand}"
                            Background="#F3F4F6"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid ItemsSource="{Binding WarehouseTasks}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="30"
                                  ColumnHeaderHeight="40"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Orden" Binding="{Binding OrderIndex}" Width="60"/>
                                <DataGridTextColumn Header="Folio" Binding="{Binding WarehouseTaskId}" Width="70"/>
                                <DataGridTextColumn Header="Prioridad" Binding="{Binding Priority}" Width="100"/>
                                <DataGridTextColumn Header="Actividad" Binding="{Binding Activity}" Width="150"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Almacen" Binding="{Binding WarehouseName}" Width="150"/>
                                <DataGridTextColumn Header="Estatus"
                                                    Binding="{Binding Status, Converter={StaticResource WarehouseTaskStatusConverter}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Asignado a" Binding="{Binding AssignedToUserId}" Width="150"/>
                                <DataGridTextColumn Header="Asignada"
                                                    Binding="{Binding AssignedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                    Width="130"/>

                                <DataGridTemplateColumn Header="Acciones" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Asignar"
                                                    Height="26"
                                                    Margin="4,0"
                                                    Padding="10,0"
                                                    Background="#2563EB"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.AsignarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}"/>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border Background="#80FFFFFF"
                                Visibility="{Binding IsLoadingAsignadas, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="18"/>
                                <TextBlock Text="Cargando tareas..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        </TabControl>
    </Grid>
</UserControl>
