<Window x:Class="LD.FormsX.Views.Dialogs.NuevoClienteView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Nuevo cliente"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10,10,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceCard}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderInput}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Width="870"
                MinHeight="580"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnClose_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="24,20,24,18">
                    <TabControl x:Name="tabControl1">

                        <TabItem Header="Información Comercial" Margin="0,0,-4,0">
                            <Border Background="{StaticResource SurfaceCard}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10,12,12,12"
                                    Padding="22">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="383">
                                    <StackPanel>
                                        <controls:LDInput Label="Id"
                                                          Text="{Binding ClientIdText}"
                                                          IsReadOnly="True"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Nombre comercial"
                                                          Text="{Binding CommercialName, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Domicilio comercial"
                                                          Text="{Binding CommercialAddress, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Colonia"
                                                          Text="{Binding CommercialNeighborhood, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Ciudad"
                                                          Text="{Binding CommercialCity, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Código postal"
                                                          Text="{Binding CommercialZipCode, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Teléfono"
                                                          Text="{Binding CommercialPhone, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,16"/>

                                        <CheckBox Content="Activo"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextBody}"
                                                  IsChecked="{Binding IsActive}"
                                                  Margin="0,0,0,8"/>

                                        <CheckBox Content="Proveedor VMI"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextBody}"
                                                  IsChecked="{Binding IsProvider}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <TabItem Header="Información Fiscal" Margin="0,0,-10,0">
                            <Border Background="{StaticResource SurfaceCard}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    CornerRadius="0,12,12,12"
                                    Padding="22">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <controls:LDInput Label="Razón social"
                                                          Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="RFC"
                                                          Text="{Binding Rfc, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Domicilio fiscal"
                                                          Text="{Binding FiscalAddress, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Colonia"
                                                          Text="{Binding FiscalNeighborhood, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Ciudad"
                                                          Text="{Binding FiscalCity, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Código postal"
                                                          Text="{Binding FiscalZipCode, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Email"
                                                          Text="{Binding FiscalEmail, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,0,10"/>

                                        <controls:LDInput Label="Teléfono"
                                                          Text="{Binding FiscalPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
