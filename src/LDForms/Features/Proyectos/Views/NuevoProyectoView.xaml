<Window x:Class="LD.FormsX.Views.Proyectos.NuevoProyectoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:LD.FormsX.Features.Common"
        mc:Ignorable="d"
        Title="Nuevo proyecto"
        Height="740" Width="1100"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#233167"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="1100"
                Background="White" CornerRadius="16"
                BorderBrush="#E5E7EB" BorderThickness="1" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Border Grid.Row="0" Background="#233167"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center" Foreground="White"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnClose_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- ── Body con tabs ── -->
                <TabControl Grid.Row="1" Margin="16,12,16,0">

                    <!-- ─ Tab 1: Datos Generales ─ -->
                    <TabItem Header="Datos generales">
                        <Border Background="White" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="0,8,8,8" Padding="0,5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- Fila 1: Cliente / Almacén / Nombre -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cliente:" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource ComboStyle}"
                                                  ItemsSource="{Binding ClientsSource}"
                                                  SelectedValue="{Binding SelectedClientId}"
                                                  DisplayMemberPath="Value" SelectedValuePath="Key"/>
                                        <TextBlock Grid.Column="3" Text="Almacén:" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox Grid.Column="4"
                                                  Style="{StaticResource ComboStyle}"
                                                  ItemsSource="{Binding WarehousesSource}"
                                                  SelectedValue="{Binding SelectedWarehouseId}"
                                                  DisplayMemberPath="Value" SelectedValuePath="Key"/>
                                        <TextBlock Grid.Column="6" Text="Proyecto:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Grid.Column="7" Style="{StaticResource InputStyle}"
                                                 Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <!-- Fila 2: Activo / AutoPicking -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <CheckBox Content="Activo"
                                                  IsChecked="{Binding IsActive}"
                                                  Style="{StaticResource CheckStyle}" Margin="0,0,24,0"/>
                                        <CheckBox Content="AutoPicking"
                                                  IsChecked="{Binding AutoPicking}"
                                                  Style="{StaticResource CheckStyle}"/>
                                    </StackPanel>

                                    <!-- Fila 3: tres grupos lado a lado -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Tipo de almacenamiento -->
                                        <Border Grid.Column="0" BorderBrush="#E5E7EB"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="TIPO DE ALMACENAMIENTO" Style="{StaticResource GroupLabelStyle}"/>
                                                <RadioButton Content="FIFO (First In - First Out)"  IsChecked="{Binding IsFifo}"      Style="{StaticResource RadioStyle}" GroupName="StorageType"/>
                                                <RadioButton Content="LIFO (Last In - First Out)"   IsChecked="{Binding IsLifo}"      Style="{StaticResource RadioStyle}" GroupName="StorageType"/>
                                                <RadioButton Content="Número de Lote"               IsChecked="{Binding IsLote}"      Style="{StaticResource RadioStyle}" GroupName="StorageType"/>
                                                <RadioButton Content="Fecha de Caducidad"           IsChecked="{Binding IsCaducidad}" Style="{StaticResource RadioStyle}" GroupName="StorageType"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Opciones de almacenamiento -->
                                        <Border Grid.Column="2" BorderBrush="#E5E7EB"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="OPCIONES" Style="{StaticResource GroupLabelStyle}"/>
                                                <CheckBox Content="Backorder"       IsChecked="{Binding AllowsBackorder}"      Style="{StaticResource CheckStyle}"/>
                                                <CheckBox Content="Distribución"    IsChecked="{Binding IsDistributionArea}"   Style="{StaticResource CheckStyle}"/>
                                                <CheckBox Content="Almacén Fiscal"  IsChecked="{Binding IsFiscalWarehouse}"    Style="{StaticResource CheckStyle}"/>
                                                <CheckBox Content="Sobredimensión"  IsChecked="{Binding AllowsOversizedItems}" Style="{StaticResource CheckStyle}"/>
                                                <CheckBox Content="Etiquetas"       IsChecked="{Binding RequiresLabels}"       Style="{StaticResource CheckStyle}"/>
                                                <CheckBox Content="Lote único"      IsChecked="{Binding UniqueLot}"            Style="{StaticResource CheckStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Unidades -->
                                        <Border Grid.Column="4" BorderBrush="#E5E7EB"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                           Text="UNIDADES" Style="{StaticResource GroupLabelStyle}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Entrada:"      Style="{StaticResource LabelStyle}" Margin="0,4,0,4"/>
                                                <ComboBox  Grid.Row="1" Grid.Column="1" Style="{StaticResource ComboStyle}" Margin="0,4,0,4"
                                                           ItemsSource="{Binding UnitsSource}"
                                                           DisplayMemberPath="Value"
                                                           SelectedValuePath="Key"
                                                           SelectedValue="{Binding Entrada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Almacenamiento:" Style="{StaticResource LabelStyle}" Margin="0,4,0,4"/>
                                                <ComboBox  Grid.Row="2" Grid.Column="1" Style="{StaticResource ComboStyle}" Margin="0,4,0,4"
                                                           ItemsSource="{Binding UnitsSource}"
                                                           DisplayMemberPath="Value"
                                                           SelectedValuePath="Key"
                                                           SelectedValue="{Binding StorageArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Retrabajo:"    Style="{StaticResource LabelStyle}" Margin="0,4,0,4"/>
                                                <ComboBox  Grid.Row="3" Grid.Column="1" Style="{StaticResource ComboStyle}" Margin="0,4,0,4"
                                                           ItemsSource="{Binding UnitsSource}"
                                                           DisplayMemberPath="Value"
                                                           SelectedValuePath="Key"
                                                           SelectedValue="{Binding ReworkArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Salida:"       Style="{StaticResource LabelStyle}" Margin="0,4,0,4"/>
                                                <ComboBox  Grid.Row="4" Grid.Column="1" Style="{StaticResource ComboStyle}" Margin="0,4,0,4"
                                                           ItemsSource="{Binding UnitsSource}"
                                                           DisplayMemberPath="Value"
                                                           SelectedValuePath="Key"
                                                           SelectedValue="{Binding Salida, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <CheckBox Content="Escaneo obligatorio"
                                              IsChecked="{Binding ScanRequired}"
                                              Style="{StaticResource CheckStyle}"
                                              Margin="0,16,0,0"/>

                                    <!-- ── Configuraciones de escaneo ── -->
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                            CornerRadius="8" Padding="14,10" Margin="0,8,0,0"
                                            IsEnabled="{Binding ScanRequired}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="CONFIGURACIONES DE ESCANEO" Style="{StaticResource GroupLabelStyle}"/>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Campos del sistema -->
                                                <Border Grid.Column="0" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4">
                                                    <DataGrid x:Name="dgCamposSistema"
                                                              AutoGenerateColumns="False"
                                                              ItemsSource="{Binding AvailableSystemFields}"
                                                              SelectedItem="{Binding SelectedSystemField}"
                                                              SelectionMode="Single" SelectionUnit="FullRow"
                                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                                              IsReadOnly="True" HeadersVisibility="Column"
                                                              GridLinesVisibility="Vertical"
                                                              RowHeight="26" ColumnHeaderHeight="32"
                                                              FontSize="12" VerticalGridLinesBrush="#D9D9D9"
                                                              MinHeight="140">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Campos del sistema" Binding="{Binding Value}" Width="*"/>
                                                        </DataGrid.Columns>
                                                        <DataGrid.Resources>
                                                            <Style TargetType="DataGridColumnHeader">
                                                                <Setter Property="Background" Value="#EEF1F5"/>
                                                                <Setter Property="Foreground" Value="#16263D"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                                <Setter Property="Padding" Value="8,4"/>
                                                            </Style>
                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            </Style>
                                                        </DataGrid.Resources>
                                                    </DataGrid>
                                                </Border>

                                                <!-- Botones agregar / quitar -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Button x:Name="btnAgregarCampo" Content="›"
                                                            Width="32" Height="32" FontSize="16" FontWeight="Bold"
                                                            Background="#2563EB" Foreground="White"
                                                            BorderThickness="0" Cursor="Hand"
                                                            Margin="0,0,0,8"
                                                            ToolTip="Agregar campo"
                                                            Command="{Binding AgregarCampoCommand}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button x:Name="btnQuitarCampo" Content="‹"
                                                            Width="32" Height="32" FontSize="16" FontWeight="Bold"
                                                            Background="#EF4444" Foreground="White"
                                                            BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Quitar campo"
                                                            Command="{Binding QuitarCampoCommand}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Campos del cliente -->
                                                <Border Grid.Column="2" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="4">
                                                    <DataGrid x:Name="dgCamposCliente"
                                                              AutoGenerateColumns="False"
                                                              ItemsSource="{Binding ScanConfigurations}"
                                                              SelectedItem="{Binding SelectedScanConfig}"
                                                              SelectionMode="Single" SelectionUnit="FullRow"
                                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                                              IsReadOnly="False" HeadersVisibility="Column"
                                                              GridLinesVisibility="Vertical"
                                                              RowHeight="26" ColumnHeaderHeight="32"
                                                              FontSize="12" VerticalGridLinesBrush="#D9D9D9"
                                                              MinHeight="140">

                                                        <DataGrid.Columns>

                                                            <!-- Orden -->
                                                            <DataGridTextColumn Header="Orden"
                                                                                Binding="{Binding Order}"
                                                                                Width="50"
                                                                                IsReadOnly="True"/>

                                                            <!-- Campo sistema -->
                                                            <DataGridTextColumn Header="Campo del sistema"
                                                                                Binding="{Binding SystemFieldName}"
                                                                                Width="130"
                                                                                IsReadOnly="True"/>                                                 

                                                            <!-- Campo cliente -->
                                                            <DataGridTextColumn Header="Campo del cliente"
                                                                                Binding="{Binding ClientField}"
                                                                                Width="130"/>                                               

                                                            <!-- Config de escaneo (Combo) -->
                                                            <DataGridTemplateColumn Header="Config escaneo" Width="130">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ComboBox
                                                                                ItemsSource="{Binding DataContext.ScanTypeSource, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                DisplayMemberPath="Value"
                                                                                SelectedValuePath="Key"
                                                                                SelectedValue="{Binding ScanTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                Padding="2"/>               
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>

                                                            <!-- Valor escaneo -->
                                                            <DataGridTextColumn Header="Valor para escaneo"
                                                                                Binding="{Binding ScanValue}"
                                                                                Width="130"/>

                                                            <!-- Config guardado (Combo) -->
                                                            <DataGridTemplateColumn Header="Config guardado" Width="130">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ComboBox
                                                                                ItemsSource="{Binding DataContext.SaveScanTypeSource, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                DisplayMemberPath="Value"
                                                                                SelectedValuePath="Key"
                                                                                SelectedValue="{Binding SaveTypeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                Padding="2"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="Valor de guardado"
                                                                             Binding="{Binding SaveValue, UpdateSourceTrigger=PropertyChanged}"
                                                                             Width="130"/>
                                                        </DataGrid.Columns>

                                                        <!-- Tus estilos (los dejo intactos 👍) -->
                                                        <DataGrid.Resources>
                                                            <Style TargetType="DataGridColumnHeader">
                                                                <Setter Property="Background" Value="#EEF1F5"/>
                                                                <Setter Property="Foreground" Value="#16263D"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                                <Setter Property="Padding" Value="8,4"/>
                                                            </Style>

                                                            <Style TargetType="DataGridRow">
                                                                <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            </Style>
                                                        </DataGrid.Resources>

                                                    </DataGrid>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- ─ Tab 2: Notificaciones ─ -->
                    <TabItem Header="Notificaciones">
                        <Border Background="White" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="0,8,8,8" Padding="0,6">
                            <StackPanel>

                                <!-- Tipos de notificación -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                   Text="NOTIFICACIONES" Style="{StaticResource GroupLabelStyle}"/>
                                        <CheckBox Grid.Row="2" Grid.Column="0"
                                                  Content="Notificación de Recibo"   Style="{StaticResource CheckStyle}"
                                                  IsChecked="{Binding ReceiptNotificationEnabled}"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1"
                                                  Style="{StaticResource ComboStyle}" IsEditable="True" MaxWidth="280" HorizontalAlignment="Left"
                                                  Text="{Binding ReceiptNotificationMethod, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="EMAIL"/><ComboBoxItem Content="SMS"/><ComboBoxItem Content="NINGUNO"/>
                                        </ComboBox>
                                        <CheckBox Grid.Row="4" Grid.Column="0"
                                                  Content="Notificación de Embarque" Style="{StaticResource CheckStyle}"
                                                  IsChecked="{Binding ShipmentNotificationEnabled}"/>
                                        <ComboBox Grid.Row="4" Grid.Column="1"
                                                  Style="{StaticResource ComboStyle}" IsEditable="True" MaxWidth="280" HorizontalAlignment="Left"
                                                  Text="{Binding ShipmentNotificationMethod, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="EMAIL"/><ComboBoxItem Content="SMS"/><ComboBoxItem Content="NINGUNO"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                   Text="TIEMPOS DE RESPUESTA (hrs)" Style="{StaticResource GroupLabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Normal:"  Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1"
                                                   Style="{StaticResource InputStyle}" Width="120" HorizontalAlignment="Left"
                                                   Text="{Binding TiempoNormal, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Urgente:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="4" Grid.Column="1"
                                                   Style="{StaticResource InputStyle}" Width="120" HorizontalAlignment="Left"
                                                   Text="{Binding TiempoUrgente, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ─ Tab 3: Prefijos ─ -->
                    <TabItem Header="Prefijos">
                        <Border Background="White" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="0,8,8,8" Padding="20,16">
                            <StackPanel>

                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                   Text="UBICACION" Style="{StaticResource GroupLabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ubicación:" Style="{StaticResource LabelStyle}"/>
                                        <common:InlineLookupEditor Grid.Row="2"
                                                                   Grid.Column="1"
                                                                   Height="34"
                                                                   Tag="Ubicación|Almacén"
                                                                   ItemsSource="{Binding LocationLookupItems}"
                                                                   DisplayMemberPath="Code"
                                                                   SearchMemberPaths="Code,Description"
                                                                   SelectedCode="{Binding SelectedLocationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   SelectedId="{Binding SelectedLocationLookupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                   EditorCornerRadius="0"
                                                                   EditorPadding="8,4,6,4"
                                                                   EditorBackground="#F9FAFB"
                                                                   EditorBorderBrush="#D1D5DB"
                                                                   EditorBorderThickness="1"
                                                                   EditorForeground="#111827"
                                                                   EditorFontSize="13"
                                                                   GlyphBrush="#6B7280"
                                                                   RequireSelectionMatch="True"
                                                                   MaxResults="12"
                                                                   OpenDropDownOnLoad="False"
                                                                   SelectAllTextOnLoad="False"/>
                                    </Grid>
                                </Border>

                                <!-- ASN -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                                                   Text="ASN" Style="{StaticResource GroupLabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Número:"  Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}"
                                                   Text="{Binding AsnNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Prefijo:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="4" Style="{StaticResource InputStyle}"
                                                   Text="{Binding AsnPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>

                                <!-- Kitting -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="5"
                                                   Text="KITTING" Style="{StaticResource GroupLabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Número:"  Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}"
                                                   Text="{Binding KittingNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Prefijo:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="4" Style="{StaticResource InputStyle}"
                                                   Text="{Binding KittingPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Border>

                                <!-- Orden de entrega DO -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="7"
                                                   Text="ORDEN DE ENTREGA (DO)" Style="{StaticResource GroupLabelStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Número:"  Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource InputStyle}"
                                                   Text="{Binding DoNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Prefijo:" Style="{StaticResource LabelStyle}"/>
                                        <TextBox   Grid.Row="2" Grid.Column="4" Style="{StaticResource InputStyle}"
                                                   Text="{Binding DoPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox  Grid.Row="2" Grid.Column="6"
                                                   Content="Requiere registro de llegadas"
                                                   IsChecked="{Binding ReciveRequired}"
                                                   Style="{StaticResource CheckStyle}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </Border>
                    </TabItem>
                    
                </TabControl>

                <!-- ── Footer ── -->
                <Border Grid.Row="2" Background="#F9FAFB"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,0,10,0" Command="{Binding SaveCommand}"/>
                        <Button Content="Cancelar"
                                Style="{StaticResource SecondaryBtn}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
                  
