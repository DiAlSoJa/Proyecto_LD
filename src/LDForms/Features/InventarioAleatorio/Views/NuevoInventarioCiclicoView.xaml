<Window x:Class="LD.FormsX.Views.InventarioAleatorio.NuevoInventarioCiclicoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo inventario cíclico"
        Width="1040"
        Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#233167"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F5"/>
            <Setter Property="Foreground" Value="#16263D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#233167"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White"
                CornerRadius="14"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="14,14,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Nuevo inventario cíclico"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="X"
                                Click="BtnCerrar_Click"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="13"
                                Cursor="Hand"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Auditor"
                                   Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cmbAuditor"
                                  Grid.Column="1"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  IsTextSearchEnabled="True"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Almacén"
                                   Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="cmbAlmacen"
                                  Grid.Column="4"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  IsTextSearchEnabled="True"
                                  SelectionChanged="CmbAlmacen_SelectionChanged"
                                  Style="{StaticResource InputComboBoxStyle}"/>
                    </Grid>

                    <GroupBox Grid.Row="2"
                              Header="Filtro"
                              BorderBrush="{StaticResource BorderBrushSoft}"
                              BorderThickness="1"
                              Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal">
                                <RadioButton x:Name="rbTodos"
                                             Content="Todos"
                                             GroupName="FiltroUbicaciones"
                                             IsChecked="True"
                                             Checked="Filtro_Changed"
                                             Margin="0,0,24,0"/>
                                <RadioButton x:Name="rbNoRack"
                                             Content="No rack"
                                             GroupName="FiltroUbicaciones"
                                             Checked="Filtro_Changed"
                                             Margin="0,0,24,0"/>
                                <RadioButton x:Name="rbRack"
                                             Content="Rack"
                                             GroupName="FiltroUbicaciones"
                                             Checked="Filtro_Changed"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Ubicación"
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="txtUbicacion"
                                         Grid.Column="1"
                                         TextChanged="Filtro_Changed"
                                         Style="{StaticResource InputTextBoxStyle}"/>

                                <TextBlock Grid.Column="3"
                                           Text="Rack"
                                           Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbRack"
                                          Grid.Column="4"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          IsTextSearchEnabled="True"
                                          IsEnabled="False"
                                          SelectionChanged="Filtro_Changed"
                                          Style="{StaticResource InputComboBoxStyle}"/>

                                <TextBlock Grid.Column="6"
                                           Text="Posición"
                                           Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbPosicion"
                                          Grid.Column="7"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          IsTextSearchEnabled="True"
                                          IsEnabled="False"
                                          SelectionChanged="Filtro_Changed"
                                          Style="{StaticResource InputComboBoxStyle}"/>

                                <TextBlock Grid.Column="9"
                                           Text="Nivel"
                                           Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="cmbNivel"
                                          Grid.Column="10"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          IsTextSearchEnabled="True"
                                          IsEnabled="False"
                                          SelectionChanged="Filtro_Changed"
                                          Style="{StaticResource InputComboBoxStyle}"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0"
                                  Header="Ubicaciones"
                                  BorderBrush="#D9DEE7"
                                  BorderThickness="1"
                                  Padding="8">
                            <DataGrid x:Name="dgUbicacionesDisponibles"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28"
                                      ColumnHeaderHeight="38"
                                      FontSize="12"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                      CellStyle="{StaticResource GridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*"/>
                                    <DataGridTextColumn Header="Último inventario" Binding="{Binding UltimoInventario}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <Button Content="&gt;"
                                    Style="{StaticResource MoveButtonStyle}"
                                    Click="BtnAgregarUbicacion_Click"
                                    Margin="0,0,0,12"/>
                            <Button Content="&lt;"
                                    Click="BtnQuitarUbicacion_Click"
                                    Style="{StaticResource MoveButtonStyle}"/>
                        </StackPanel>

                        <GroupBox Grid.Column="2"
                                  Header="Ubicaciones asignadas"
                                  BorderBrush="#D9DEE7"
                                  BorderThickness="1"
                                  Padding="8">
                            <DataGrid x:Name="dgUbicacionesSeleccionadas"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28"
                                      ColumnHeaderHeight="38"
                                      FontSize="12"
                                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                      CellStyle="{StaticResource GridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*"/>
                                    <DataGridTextColumn Header="Último movimiento" Binding="{Binding UltimoMovimiento}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,18,0">
                        <Button Content="Guardar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Background="#233167"
                                Foreground="White"
                                BorderBrush="#233167"
                                Click="BtnGuardar_Click"
                                Margin="0,0,10,0"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
