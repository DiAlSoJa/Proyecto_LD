<UserControl x:Class="LD.FormsX.Views.InventarioAleatorio.InventarioCiclicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="1.25*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Desde:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#374151"/>

                <DatePicker x:Name="dpDesde"
                            Grid.Column="1"
                            Height="38"
                            FontSize="13"
                            SelectedDateFormat="Short"
                            BorderBrush="#D1D5DB"
                            Background="White"/>

                <TextBlock Grid.Column="3"
                           Text="Hasta:"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#374151"/>

                <DatePicker x:Name="dpHasta"
                            Grid.Column="4"
                            Height="38"
                            FontSize="13"
                            SelectedDateFormat="Short"
                            BorderBrush="#D1D5DB"
                            Background="White"/>

               <Button x:Name="BtnActualizar"
		                Grid.Column="6"
		                Height="38"
		                Padding="12,0"
		                Click="BtnActualizar_Click"
		                Background="#F3F4F6"
		                Foreground="#374151"
		                BorderBrush="#D1D5DB"
		                BorderThickness="1"
		                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE895;"
		                   Foreground="#10B981"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Actualizar"/>
	                </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Grid superior -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatusFechas"
                           Grid.Row="0"
                           Text="Fechas"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dgFechas"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionChanged="dgFechas_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="140"/>
                                <DataGridTextColumn Header="Almacen" Binding="{Binding Almacen}" Width="140"/>
                                <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="110"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border x:Name="LoadingOverlayFechas"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoadingFechas"
                                           Text="Cargando fechas..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Botones medios -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                Padding="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
               <Button x:Name="btnNuevo"
	                
	                Height="38"
	                Padding="12,0"
	                
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE710;"
		                   Foreground="#2563EB"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Nuevo"/>
	                </StackPanel>
                </Button>

                <Button x:Name="btnEditar"
	                
	                Height="38"
	                Padding="12,0"
	                Click="BtnEditar_Click"
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE70F;"
		                   Foreground="#F59E0B"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Editar"/>
	                </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- Sección media -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Izquierda -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtStatusUbicacionesTop"
                               Grid.Row="0"
                               Text="Ubicaciones"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="4,0,0,8"/>

                    <Border Grid.Row="2"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                        <Grid>
                            <DataGrid x:Name="dgAuditores"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28"
                                      ColumnHeaderHeight="40"
                                      FontSize="12"
                                      VerticalGridLinesBrush="#D9D9D9"
                                      HorizontalGridLinesBrush="#E4E8EE"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionChanged="dgAuditores_SelectionChanged">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Auditor" Binding="{Binding Auditor}" Width="300"/>
                                </DataGrid.Columns>

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>

                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>

                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Background" Value="White"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>

                            <Border x:Name="LoadingOverlayUbicacionesTop"
                                    Background="#80FFFFFF"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="220"
                                                 Height="18"/>
                                    <TextBlock x:Name="TxtLoadingUbicacionesTop"
                                               Text="Cargando ubicaciones..."
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#24344D"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Derecha -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtStatusResultados"
                               Grid.Row="0"
                               Text="Resultados"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="4,0,0,8"/>

                    <Border Grid.Row="2"
                            BorderBrush="#D9DEE7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="White">
                        <Grid>
                            <DataGrid x:Name="dgResultados"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical"
                                      RowHeight="28"
                                      ColumnHeaderHeight="40"
                                      FontSize="12"
                                      VerticalGridLinesBrush="#D9D9D9"
                                      HorizontalGridLinesBrush="#E4E8EE"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No. Parte" Binding="{Binding NoParte}" Width="150"/>
                                    <DataGridCheckBoxColumn Header="Escaneado" Binding="{Binding Escaneado}" Width="110"/>
                                </DataGrid.Columns>

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#EEF1F5"/>
                                        <Setter Property="Foreground" Value="#16263D"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>

                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>

                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Background" Value="White"/>
                                    </Style>
                                </DataGrid.Resources>
                            </DataGrid>

                            <Border x:Name="LoadingOverlayResultados"
                                    Background="#80FFFFFF"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="220"
                                                 Height="18"/>
                                    <TextBlock x:Name="TxtLoadingResultados"
                                               Text="Cargando resultados..."
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#24344D"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Grid inferior -->
        <Border Grid.Row="8"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatusUbicacionesBottom"
                           Grid.Row="0"
                           Text="Ubicaciones"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dgUbicacionesDetalle"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="140"/>
                                <DataGridCheckBoxColumn Header="Tomada" Binding="{Binding Tomada}" Width="110"/>
                                <DataGridTextColumn Header="Teorico" Binding="{Binding Teorico}" Width="90"/>
                                <DataGridTextColumn Header="Fisico" Binding="{Binding Fisico}" Width="90"/>
                                <DataGridTextColumn Header="Resultado primera toma" Binding="{Binding ResultadoPrimeraToma}" Width="160"/>
                                <DataGridTextColumn Header="Resultado segunda toma" Binding="{Binding ResultadoSegundaToma}" Width="160"/>
                                <DataGridTextColumn Header="Resultado final" Binding="{Binding ResultadoFinal}" Width="150"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border x:Name="LoadingOverlayUbicacionesBottom"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoadingUbicacionesBottom"
                                           Text="Cargando detalle..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>