<Window x:Class="LD.FormsX.Views.Articulos.NuevoArticuloView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nuevo artículo"
        Width="1380"
        Height="840"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CheckStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#233167"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FCFCFD"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="1360"
                Height="810"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#233167"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Nuevo artículo"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnCerrar_Click"
                                Content="×"/>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <TabControl Grid.Row="1" Margin="12,12,12,0">
                    <TabItem Header="General">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="610"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="640"/>
                                </Grid.ColumnDefinitions>

                                <!-- Columna izquierda -->
                                <StackPanel Grid.Column="0">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>

                                            <Grid x:Name="NoParteRow" Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="No. Parte:" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="txtNoParte"
                                                         Grid.Column="1"
                                                         Style="{StaticResource InputTextBoxStyle}"/>
                                            </Grid>

                                            <Grid x:Name="DescripcionRow" Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Descripción:" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="txtDescripcion"
                                                         Grid.Column="1"
                                                         Style="{StaticResource InputTextBoxStyle}"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Categoría:" Style="{StaticResource LabelStyle}"/>
                                                <ComboBox x:Name="cmbCategoria"
                                                          Grid.Column="1"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Familia:" Style="{StaticResource LabelStyle}"/>
                                                <ComboBox x:Name="cmbFamilia"
                                                          Grid.Column="1"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <WrapPanel>
                                                <CheckBox x:Name="chkActivo" Content="Activo" IsChecked="True" Style="{StaticResource CheckStyle}"/>
                                                <CheckBox x:Name="chkTemperatura" Content="Temperatura controlada" Style="{StaticResource CheckStyle}"/>
                                                <CheckBox x:Name="chkVMI" Content="VMI" Style="{StaticResource CheckStyle}"/>
                                                <CheckBox x:Name="chkBOM" Content="BOM" Style="{StaticResource CheckStyle}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                                        <StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <CheckBox x:Name="chkSolicitarLote" Content="Solicitar número de lote" Style="{StaticResource CheckStyle}"/>
                                                    <CheckBox x:Name="chkSolicitarCaducidad" Content="Solicitar fecha de caducidad" Style="{StaticResource CheckStyle}"/>
                                                    <CheckBox x:Name="chkSolicitarPedimento" Content="Solicitar número de pedimento" Style="{StaticResource CheckStyle}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <CheckBox x:Name="chkSolicitarTipoCambio" Content="Solicitar tipo de cambio" Style="{StaticResource CheckStyle}"/>
                                                    <CheckBox x:Name="chkSolicitarOC" Content="Solicitar orden de compra" Style="{StaticResource CheckStyle}"/>
                                                    <CheckBox x:Name="chkSolicitarReferencia" Content="Solicitar referencia" Style="{StaticResource CheckStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="chkNotificacionMax"
                                                          Grid.Column="0"
                                                          Content="Notificación de máximos"
                                                          Style="{StaticResource CheckStyle}"/>

                                                <TextBlock Grid.Column="1" Text="Máximos:" Style="{StaticResource LabelStyle}" Margin="0"/>
                                                <TextBox x:Name="txtMaximos" Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox x:Name="chkNotificacionMin"
                                                          Grid.Column="0"
                                                          Content="Notificación de mínimos"
                                                          Style="{StaticResource CheckStyle}"/>

                                                <TextBlock Grid.Column="1" Text="Mínimos:" Style="{StaticResource LabelStyle}" Margin="0"/>
                                                <TextBox x:Name="txtMinimos" Grid.Column="2" Style="{StaticResource InputTextBoxStyle}"/>
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Reorden:" Style="{StaticResource LabelStyle}" Margin="0"/>
                                                <TextBox x:Name="txtOrden" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>

                                                <TextBlock Grid.Column="2" Text="Tiempo de entrega:" Style="{StaticResource LabelStyle}" Margin="20,0,14,0"/>
                                                <TextBox x:Name="txtTiempoEntrega" Grid.Column="3" Style="{StaticResource InputTextBoxStyle}"/>
                                                <TextBlock Grid.Column="4" Text="días" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Columna derecha -->
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Tipo de almacenamiento" Style="{StaticResource SectionTitleStyle}"/>
                                                <RadioButton x:Name="rdFifo" Content="FIFO - First In First Out" Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="rdLifo" Content="LIFO - Last In First Out" Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="rdLote" Content="Número de lote" Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="rdCaducidad" Content="Fecha de caducidad" Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                            <StackPanel>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Unidad mínima:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbUnidadMinima" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Unidad media:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbUnidadMedia" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                    <TextBox x:Name="txtValorUnidadMedia" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Unidad máxima:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbUnidadMaxima" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                    <TextBox x:Name="txtValorUnidadMax" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Paquete estándar:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbPaqueteEstandar" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                    <TextBox x:Name="txtValorPaqueteEst" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Costos:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtCostos" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Factor almacén:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtFactorAlmacen" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Factor producción:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtFactorProduccion" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Estatus producción:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbEstatusProduccion" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Unidad de producción:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbUnidadProduccion" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Dimensiones" Style="{StaticResource SectionTitleStyle}"/>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Alto:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtAlto" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Largo:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtLargo" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Ancho:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtAncho" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Peso y dimensión" Style="{StaticResource SectionTitleStyle}"/>

                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Peso:" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox x:Name="txtPeso" Grid.Column="1" Style="{StaticResource InputTextBoxStyle}"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Dimensión:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox x:Name="cmbDimension" Grid.Column="1" Style="{StaticResource InputComboBoxStyle}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Avanzada">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16">
                                <StackPanel Width="760">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Proveedor" Style="{StaticResource SectionTitleStyle}"/>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Proveedor:" Style="{StaticResource LabelStyle}"/>
                                                <ComboBox x:Name="cmbProveedor"
                                                          Grid.Column="1"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Número de parte proveedor:" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="txtNoParteProv"
                                                         Grid.Column="1"
                                                         Style="{StaticResource InputTextBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Notificaciones" Style="{StaticResource SectionTitleStyle}"/>

                                            <StackPanel Margin="0,0,0,14">
                                                <RadioButton x:Name="rdNotificacionEmail"
                                                             Content="Notificación vía email"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="rdNotificacionArchivos"
                                                             Content="Notificación vía archivos"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Lista de distribución:" Style="{StaticResource LabelStyle}"/>
                                                <ComboBox x:Name="cmbListaDistribucion"
                                                          Grid.Column="1"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ruta de notificación:" Style="{StaticResource LabelStyle}"/>
                                                <ComboBox x:Name="cmbRutaNotificacion"
                                                          Grid.Column="1"
                                                          Style="{StaticResource InputComboBoxStyle}"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Correo alterno:" Style="{StaticResource LabelStyle}"/>
                                                <TextBox x:Name="txtCorreoAlterno"
                                                         Grid.Column="1"
                                                         Style="{StaticResource InputTextBoxStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button x:Name="btnSave"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Foreground="White"
                                Margin="0,0,10,0"
                                Click="btnSave_Click"/>

                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
