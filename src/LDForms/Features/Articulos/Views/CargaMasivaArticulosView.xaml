<Window x:Class="LD.FormsX.Views.Articulos.CargaMasivaArticulosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Carga masiva de articulos"
        Width="980"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#233167"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="950"
                Height="670"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#233167"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Carga masiva de articulos"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnCerrar_Click"
                                Content="x"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="18,18,18,10"
                        Padding="14"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock x:Name="txtContexto"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock Margin="0,8,0,0"
                                   Text="Pegue los datos en este orden: numero de parte y descripcion."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource LabelStyle}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="18,0,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Pegar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnPegar_Click"/>

                    <Button Grid.Column="2"
                            Content="Limpiar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnLimpiar_Click"/>
                </Grid>

                <Border Grid.Row="3"
                        Margin="18,0,18,12"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="White">
                    <DataGrid x:Name="dgCarga"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              RowHeight="32"
                              ColumnHeaderHeight="40"
                              AlternatingRowBackground="#F8FAFC"
                              AlternationCount="2"
                              FontSize="12"
                              VerticalGridLinesBrush="#D9D9D9"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Numero de parte"
                                                Binding="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                                Width="230"/>
                            <DataGridTextColumn Header="Descripcion"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                        </DataGrid.Columns>

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EEF1F5"/>
                                <Setter Property="Foreground" Value="#16263D"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Padding" Value="9,6"/>
                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Border>

                <Border Grid.Row="4"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <Grid Margin="18,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Aceptar"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,10,0"
                                    Click="BtnAceptar_Click"/>
                            <Button Content="Cerrar"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BtnCerrar_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
