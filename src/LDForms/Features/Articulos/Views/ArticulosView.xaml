<UserControl x:Class="LD.FormsX.Views.ArticulosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:LD.FormsX.Features.Common"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Artículos"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta, crea y edita artículos"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <common:InlineLookupEditor x:Name="lookupCliente"
                                           Grid.Column="1"
                                           Height="38"
                                           Tag="Cliente|Clave"
                                           ItemsSource="{Binding ClientLookupItems}"
                                           DisplayMemberPath="Code"
                                           SearchMemberPaths="Code,Description"
                                           SelectedCode="{Binding SelectedClientText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           SelectedId="{Binding SelectedClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           EditorCornerRadius="10"
                                           EditorPadding="14,6,8,6"
                                           EditorBorderBrush="#D1D5DB"
                                           EditorBorderThickness="1.2"
                                           EditorForeground="#1F2937"
                                           EditorFontSize="13"
                                           GlyphBrush="#94A3B8"
                                           RequireSelectionMatch="True"
                                           MaxResults="12"
                                           OpenDropDownOnLoad="False"
                                           SelectAllTextOnLoad="False"
                                           SelectionConfirmed="LookupCliente_SelectionConfirmed"/>

                <common:InlineLookupEditor x:Name="lookupProyecto"
                                           Grid.Column="3"
                                           Height="38"
                                           Tag="Proyecto|Clave"
                                           ItemsSource="{Binding ProjectLookupItems}"
                                           DisplayMemberPath="Code"
                                           SearchMemberPaths="Code,Description"
                                           SelectedCode="{Binding SelectedProjectText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           SelectedId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           EditorCornerRadius="10"
                                           EditorPadding="14,6,8,6"
                                           EditorBorderBrush="#D1D5DB"
                                           EditorBorderThickness="1.2"
                                           EditorForeground="#1F2937"
                                           EditorFontSize="13"
                                           GlyphBrush="#94A3B8"
                                           RequireSelectionMatch="True"
                                           MaxResults="12"
                                           OpenDropDownOnLoad="False"
                                           SelectAllTextOnLoad="False"
                                           SelectionConfirmed="LookupProyecto_SelectionConfirmed"/>

                <TextBox x:Name="txtBuscar"
                         Grid.Column="5"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="13"
                         IsEnabled="False"
                         ToolTip="Buscar artículo..."/>

                <Button x:Name="btnNuevo"
                        Grid.Column="7"
                        Height="38"
                        Padding="12,0"
                        Click="BtnNuevo_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE710;"
                                   Foreground="#2563EB"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Nuevo"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnEditar"
                        Grid.Column="9"
                        Height="38"
                        Padding="12,0"
                        Click="BtnEditar_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE70F;"
                                   Foreground="#F59E0B"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Editar"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnActualizar"
                        Grid.Column="11"
                        Height="38"
                        Padding="12,0"
                        Click="BtnActualizar_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE895;"
                                   Foreground="#10B981"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Actualizar"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnCargaMasiva"
                        Grid.Column="13"
                        Height="38"
                        Padding="12,0"
                        Click="BtnCargaMasiva_Click"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8B7;"
                                   Foreground="#7C3AED"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Carga masiva"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatus"
                           Text="Selecciona un cliente y un proyecto para consultar artículos."
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="1"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">

                    <Grid>
                        <DataGrid x:Name="dg"
                                  AutoGenerateColumns="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  SelectionChanged="dg_SelectionChanged"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  AlternatingRowBackground="#F8FAFC"
                                  AlternationCount="2"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  Margin="0">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="9,6"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <Border x:Name="LoadingOverlay"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoading"
                                           Text="Trayendo artículos..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
