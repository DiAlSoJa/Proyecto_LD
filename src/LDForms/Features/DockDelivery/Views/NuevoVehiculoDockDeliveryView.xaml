<Window x:Class="LDForms.Features.DockDelivery.Views.NuevoVehiculoDockDeliveryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Nuevo vehículo"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldSectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="Background" Value="{StaticResource AppPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromeHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WindowCloseBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="860"
                Height="580"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="18"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="74"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="18,18,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtHeaderTitle"
                                   Text="Nuevo vehículo"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Content="×"
                                Style="{StaticResource HeaderCloseButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,22,24,18">
                    <Border Background="{StaticResource SurfaceCard}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Datos del vehículo"
                                           Style="{StaticResource FieldSectionStyle}"/>

                                <controls:LDInput x:Name="ldPlacas"
                                                  Label="Placas"
                                                  Placeholder="JP26370"
                                                  MaxLength="50"
                                                  Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:LDInput x:Name="ldNumeroVehiculo"
                                                      Grid.Column="0"
                                                      Label="Número de vehículo"
                                                      Placeholder="No. vehículo"
                                                      MaxLength="20"/>

                                    <controls:LDInput x:Name="ldTipo"
                                                      Grid.Column="2"
                                                      Label="Tipo"
                                                      Placeholder="Caja seca, rabón, camioneta"
                                                      MaxLength="50"/>
                                </Grid>

                                <controls:LDInput x:Name="ldNombre"
                                                  Label="Nombre"
                                                  Placeholder="FORD DIESEL 96"
                                                  MaxLength="150"
                                                  Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:LDInput x:Name="ldCapacidad"
                                                      Grid.Column="0"
                                                      Label="Capacidad"
                                                      Placeholder="0.00"
                                                      MaxLength="20"/>

                                    <controls:LDInput x:Name="ldLong"
                                                      Grid.Column="2"
                                                      Label="Largo"
                                                      Placeholder="0.00"
                                                      MaxLength="20"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:LDInput x:Name="ldWight"
                                                      Grid.Column="0"
                                                      Label="Ancho"
                                                      Placeholder="0.00"
                                                      MaxLength="20"/>

                                    <controls:LDInput x:Name="ldHeight"
                                                      Grid.Column="2"
                                                      Label="Alto"
                                                      Placeholder="0.00"
                                                      MaxLength="20"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,18,18">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button x:Name="btnSave"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="BtnSave_Click"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
