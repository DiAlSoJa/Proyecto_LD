<UserControl x:Class="LD.FormsX.Views.Auditar.AuditarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <DataTemplate x:Key="AuditCardTemplate">
            <Border Margin="4,0,4,10"
                    Padding="12,10"
                    Background="{Binding Background}"
                    BorderBrush="{Binding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    MouseLeftButtonUp="AuditCard_MouseLeftButtonUp">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="1"
                                      Opacity="0.05"
                                      Color="#111827"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{Binding TitleForeground}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{Binding TextForeground}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{Binding TextForeground}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock Text="Auditoría"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta y control de auditorías"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="BtnActualizar"
		            Grid.Column="1"
		            Height="38"
		            Padding="12,0"
		            Click="BtnActualizar_Click"
		            Background="#F3F4F6"
		            Foreground="#374151"
		            BorderBrush="#D1D5DB"
		            BorderThickness="1"
		            Cursor="Hand">

	            <Button.Resources>
		            <Style TargetType="Border">
			            <Setter Property="CornerRadius" Value="6"/>
		            </Style>
	            </Button.Resources>

	            <StackPanel Orientation="Horizontal"
		            VerticalAlignment="Center"
		            HorizontalAlignment="Center">

		            <TextBlock FontFamily="Segoe MDL2 Assets"
		               Text="&#xE895;"
		               Foreground="#10B981"
		               Margin="0,0,6,0"
		               FontSize="14"/>

		            <TextBlock Text="Actualizar"/>
	            </StackPanel>
            </Button>


               <Button x:Name="btnNuevo"
	                Grid.Column="3"
	                Height="38"
	                Padding="12,0"
	                Click="BtnNuevo_Click"
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE710;"
		                   Foreground="#2563EB"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Nuevo"/>
	                </StackPanel>
                </Button>

               <Button x:Name="btnEnviar"
	                Grid.Column="5"
	                Height="38"
	                Padding="12,0"
	              
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE70F;"
		                   Foreground="#F59E0B"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Editar"/>
	                </StackPanel>
                </Button>

              <Button x:Name="btnEditar"
	                Grid.Column="7"
	                Height="38"
	                Padding="12,0"
	              
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE70;"
		                   Foreground="#233167"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Enviar"/>
	                </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.95*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Lado izquierdo -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2.1*"/>
                </Grid.RowDefinitions>

                <!-- Grid principal -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatusAuditoria"
                                   Grid.Row="0"
                                   Text="Sin mapeos de carga por mostrar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            BorderBrush="#D9DEE7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="White">
                                        <DataGrid x:Name="dgMapeoCarga"
                                                  AutoGenerateColumns="False"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Vertical"
                                                  RowHeight="28"
                                                  ColumnHeaderHeight="40"
                                                  FontSize="12"
                                                  VerticalGridLinesBrush="#D9D9D9"
                                                  HorizontalGridLinesBrush="#E4E8EE"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  SelectionChanged="dgMapeoCarga_SelectionChanged"
                                                  ItemsSource="{Binding MapeoCargaItems}">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Id mapeo" Binding="{Binding MapeoCargaId}" Width="90"/>
                                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                                                <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="*"/>
                                                <DataGridTextColumn Header="Orden de entrega" Binding="{Binding OrdenEntrega}" Width="140"/>
                                            </DataGrid.Columns>

                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#EEF1F5"/>
                                                    <Setter Property="Foreground" Value="#16263D"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Background" Value="White"/>
                                                </Style>
                                            </DataGrid.Resources>
                                        </DataGrid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            BorderBrush="#D9DEE7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="White">
                                        <DataGrid x:Name="dgAuditoriasKitting"
                                                  AutoGenerateColumns="False"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Vertical"
                                                  RowHeight="28"
                                                  ColumnHeaderHeight="40"
                                                  FontSize="12"
                                                  VerticalGridLinesBrush="#D9D9D9"
                                                  HorizontalGridLinesBrush="#E4E8EE"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ItemsSource="{Binding KittingItems}">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Kitting" Binding="{Binding KittingCode}" Width="*"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                            </DataGrid.Columns>

                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#EEF1F5"/>
                                                    <Setter Property="Foreground" Value="#16263D"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Background" Value="White"/>
                                                </Style>
                                            </DataGrid.Resources>
                                        </DataGrid>
                                    </Border>
                                </Grid>

                                <Border x:Name="LoadingOverlayAuditoria"
                                        Background="#80FFFFFF"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="18"/>
                                        <TextBlock x:Name="TxtLoadingAuditoria"
                                                   Text="Cargando auditorías..."
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#24344D"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid detalle -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatusDetalle"
                                   Grid.Row="0"
                                   Text="Sin detalle para mostrar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid>
                                <DataGrid x:Name="dgDetalleAuditoria"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="40"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ItemsSource="{Binding KittingIssueItems}"
                                          SelectionChanged="dgDetalleAuditoria_SelectionChanged">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kitting" Binding="{Binding Kitting}" Width="120"/>
                                        <DataGridTextColumn Header="StandardId" Binding="{Binding StandardIdStr}" Width="120"/>
                                        <DataGridTextColumn Header="Numero de Parte" Binding="{Binding PartNumber}" Width="140"/>
                                        <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding ReceivedQuantity}" Width="95"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding SupplyStatus}" Width="110"/>
                                        <DataGridTextColumn Header="Lote" Binding="{Binding LotNumber}" Width="120"/>
                                    </DataGrid.Columns>

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#EEF1F5"/>
                                            <Setter Property="Foreground" Value="#16263D"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>

                                <Border x:Name="LoadingOverlayDetalle"
                                        Background="#80FFFFFF"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="18"/>
                                        <TextBlock x:Name="TxtLoadingDetalle"
                                                   Text="Cargando detalle..."
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#24344D"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel derecho -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Escanear StandardId"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>

                            <TextBox x:Name="txtScanStandardId"
                                     Grid.Row="2"
                                     Grid.Column="0"
                                     Height="34"
                                     Padding="10,4"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Background="White"
                                     KeyDown="TxtScanStandardId_KeyDown"/>

                            <StackPanel Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Grid.Column="2">
                                <TextBlock Text="Ubicar en"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <RadioButton x:Name="rbScanIzquierda"
                                                 Content="Izquierda"
                                                 GroupName="ScanSide"
                                                 Margin="0,0,12,0"
                                                 Checked="ScanSide_Checked"/>
                                    <RadioButton x:Name="rbScanDerecha"
                                                 Content="Derecha"
                                                 GroupName="ScanSide"
                                                 Checked="ScanSide_Checked"/>
                                </StackPanel>
                                <TextBlock x:Name="txtSelectedScanSide"
                                           Margin="0,8,0,0"
                                           Text="Siguiente: Izquierda"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#2563EB"/>
                            </StackPanel>

                            <TextBox x:Name="txtUltimoMensajeEscaneo"
                                     Grid.Row="4"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="3"
                                     Height="34"
                                     Padding="8,4"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Background="#F0FDF4"
                                     Foreground="#166534"
                                     BorderBrush="#22C55E"
                                     BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          MinWidth="260"
                          Margin="0,4,0,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#4778C7"
                                BorderBrush="#E5E7EB"
                                BorderThickness="2"
                                CornerRadius="7"
                                Panel.ZIndex="2">
                            <TextBlock Text="Fondo"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,-1,0,-1"
                                Background="White"
                                BorderBrush="#111827"
                                BorderThickness="2"
                                CornerRadius="24"
                                Padding="12,16"
                                ClipToBounds="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <Grid MinWidth="330">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Izquierda"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,2,0,8"
                                                   Text="StandardId y parte"
                                                   FontSize="11"
                                                   Foreground="#6B7280"/>

                                        <ItemsControl Grid.Row="2"
                                                      ItemsSource="{Binding LeftCards}"
                                                      ItemTemplate="{StaticResource AuditCardTemplate}"/>
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Derecha"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,2,0,8"
                                                   Text="StandardId y parte"
                                                   FontSize="11"
                                                   Foreground="#6B7280"/>

                                        <ItemsControl Grid.Row="2"
                                                      ItemsSource="{Binding RightCards}"
                                                      ItemTemplate="{StaticResource AuditCardTemplate}"/>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="2"
                                Background="#4778C7"
                                BorderBrush="#E5E7EB"
                                BorderThickness="2"
                                CornerRadius="7"
                                Panel.ZIndex="2">
                            <TextBlock Text="Puerta"
                               Foreground="White"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
