<UserControl x:Class="LD.FormsX.Views.Auditar.AuditarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <DataTemplate x:Key="AuditCardTemplate">
            <Border Margin="0,0,0,10"
                    Padding="15,13"
                    Background="#F8FAFC"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="1"
                                      Opacity="0.05"
                                      Color="#111827"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#475569"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Details}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#64748B"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock Text="Auditoría"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta y control de auditorías"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="BtnActualizar"
		            Grid.Column="1"
		            Height="38"
		            Padding="12,0"
		            Click="BtnActualizar_Click"
		            Background="#F3F4F6"
		            Foreground="#374151"
		            BorderBrush="#D1D5DB"
		            BorderThickness="1"
		            Cursor="Hand">

	            <Button.Resources>
		            <Style TargetType="Border">
			            <Setter Property="CornerRadius" Value="6"/>
		            </Style>
	            </Button.Resources>

	            <StackPanel Orientation="Horizontal"
		            VerticalAlignment="Center"
		            HorizontalAlignment="Center">

		            <TextBlock FontFamily="Segoe MDL2 Assets"
		               Text="&#xE895;"
		               Foreground="#10B981"
		               Margin="0,0,6,0"
		               FontSize="14"/>

		            <TextBlock Text="Actualizar"/>
	            </StackPanel>
            </Button>


               <Button x:Name="btnNuevo"
	                Grid.Column="3"
	                Height="38"
	                Padding="12,0"
	                
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE710;"
		                   Foreground="#2563EB"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Nuevo"/>
	                </StackPanel>
                </Button>

               <Button x:Name="btnEnviar"
	                Grid.Column="5"
	                Height="38"
	                Padding="12,0"
	              
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE70F;"
		                   Foreground="#F59E0B"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Editar"/>
	                </StackPanel>
                </Button>

              <Button x:Name="btnEditar"
	                Grid.Column="7"
	                Height="38"
	                Padding="12,0"
	              
	                Background="#F3F4F6"
	                Foreground="#374151"
	                BorderBrush="#D1D5DB"
	                BorderThickness="1"
	                Cursor="Hand">

	                <Button.Resources>
		                <Style TargetType="Border">
			                <Setter Property="CornerRadius" Value="6"/>
		                </Style>
	                </Button.Resources>

	                <StackPanel Orientation="Horizontal"
		                VerticalAlignment="Center"
		                HorizontalAlignment="Center">

		                <TextBlock FontFamily="Segoe MDL2 Assets"
		                   Text="&#xE70;"
		                   Foreground="#233167"
		                   Margin="0,0,6,0"
		                   FontSize="14"/>

		                <TextBlock Text="Enviar"/>
	                </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.95*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <!-- Lado izquierdo -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.2*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2.1*"/>
                </Grid.RowDefinitions>

                <!-- Grid principal -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatusAuditoria"
                                   Grid.Row="0"
                                   Text="Sin auditorías por mostrar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            BorderBrush="#D9DEE7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="White">
                                        <DataGrid x:Name="dgAuditoriasResumen"
                                                  AutoGenerateColumns="False"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Vertical"
                                                  RowHeight="28"
                                                  ColumnHeaderHeight="40"
                                                  FontSize="12"
                                                  VerticalGridLinesBrush="#D9D9D9"
                                                  HorizontalGridLinesBrush="#E4E8EE"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ItemsSource="{Binding AuditoriaResumenItems}"
                                                  SelectionChanged="dgAuditorias_SelectionChanged">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                                                <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="*"/>
                                                <DataGridTextColumn Header="Orden de entrega" Binding="{Binding OrdenEntrega}" Width="140"/>
                                            </DataGrid.Columns>

                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#EEF1F5"/>
                                                    <Setter Property="Foreground" Value="#16263D"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Background" Value="White"/>
                                                </Style>
                                            </DataGrid.Resources>
                                        </DataGrid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            BorderBrush="#D9DEE7"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="White">
                                        <DataGrid x:Name="dgAuditoriasKitting"
                                                  AutoGenerateColumns="False"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Vertical"
                                                  RowHeight="28"
                                                  ColumnHeaderHeight="40"
                                                  FontSize="12"
                                                  VerticalGridLinesBrush="#D9D9D9"
                                                  HorizontalGridLinesBrush="#E4E8EE"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ItemsSource="{Binding AuditoriaResumenItems}"
                                                  SelectionChanged="dgAuditorias_SelectionChanged">

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Kitting" Binding="{Binding Kitting}" Width="*"/>
                                            </DataGrid.Columns>

                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#EEF1F5"/>
                                                    <Setter Property="Foreground" Value="#16263D"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </Style>

                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="Background" Value="White"/>
                                                </Style>
                                            </DataGrid.Resources>
                                        </DataGrid>
                                    </Border>
                                </Grid>

                                <Border x:Name="LoadingOverlayAuditoria"
                                        Background="#80FFFFFF"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="18"/>
                                        <TextBlock x:Name="TxtLoadingAuditoria"
                                                   Text="Cargando auditorías..."
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#24344D"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid detalle -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatusDetalle"
                                   Grid.Row="0"
                                   Text="Sin detalle para mostrar"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="4,0,0,8"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White">
                            <Grid>
                                <DataGrid x:Name="dgDetalleAuditoria"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="40"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          SelectionChanged="dgDetalleAuditoria_SelectionChanged">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="No Parte" Binding="{Binding NoParte}" Width="130"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="150"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="95"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                        <DataGridTextColumn Header="Lote" Binding="{Binding Lote}" Width="110"/>
                                        <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="120"/>
                                    </DataGrid.Columns>

                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#EEF1F5"/>
                                            <Setter Property="Foreground" Value="#16263D"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>

                                <Border x:Name="LoadingOverlayDetalle"
                                        Background="#80FFFFFF"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="220"
                                                     Height="18"/>
                                        <TextBlock x:Name="TxtLoadingDetalle"
                                                   Text="Cargando detalle..."
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#24344D"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel derecho -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Vista de ubicación"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>
                        <TextBlock Text="Lista de ubicaciones simulada"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid HorizontalAlignment="Center"
                              Width="460"
                              MinHeight="1040"
                              Margin="0,4,0,0">
                            <!-- sombra del camión -->
                            <Border Width="420"
                                    Height="980"
                                    CornerRadius="14"
                                    Background="#10000000"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,14,0,0"/>

                            <!-- caja del camión -->
                            <Grid Width="420"
                                  Height="980"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                                <Border Background="#A4652D"
                                        CornerRadius="14"
                                        BorderBrush="#81481F"
                                        BorderThickness="1"/>

                                <TextBlock Text="Fondo"
                                           Foreground="#F8FAFC"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,18"/>
                            </Grid>

                            <!-- cabina -->
                            <Grid Width="420"
                                  Height="126"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top">
                                <Border Background="#1E293B"
                                        Height="84"
                                        CornerRadius="16,16,8,8"
                                        Margin="20,0,20,0"
                                        VerticalAlignment="Top"/>

                                <Border Background="#334155"
                                        Height="24"
                                        CornerRadius="10"
                                        Margin="58,8,58,0"
                                        VerticalAlignment="Top"/>
                                <Grid Height="24"
                                      Margin="58,8,58,0"
                                      VerticalAlignment="Top">
                                    <TextBlock Text="Puerta"
                                               Foreground="#F8FAFC"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Rectangle Fill="#1E293B"
                                           Width="18"
                                           Height="72"
                                           HorizontalAlignment="Left"
                                           Margin="56,20,0,0"
                                           RadiusX="4"
                                           RadiusY="4"/>

                                <Rectangle Fill="#1E293B"
                                           Width="18"
                                           Height="72"
                                           HorizontalAlignment="Right"
                                           Margin="0,20,56,0"
                                           RadiusX="4"
                                           RadiusY="4"/>

                                <Border Background="#475569"
                                        Height="22"
                                        CornerRadius="0,0,8,8"
                                        Margin="68,58,68,0"
                                        VerticalAlignment="Top"
                                        Opacity="0.96"/>
                            </Grid>

                            <!-- tarjetas -->
                            <Grid Margin="30,112,30,0"
                                  VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Izquierda"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"/>
                                    <TextBlock Grid.Row="1"
                                               Text="10 tarjetas"
                                               FontSize="11"
                                               Foreground="#6B7280"/>

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding LeftCards}"
                                                  ItemTemplate="{StaticResource AuditCardTemplate}"/>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Derecha"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937"/>
                                    <TextBlock Grid.Row="1"
                                               Text="10 tarjetas"
                                               FontSize="11"
                                               Foreground="#6B7280"/>

                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding RightCards}"
                                                  ItemTemplate="{StaticResource AuditCardTemplate}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
