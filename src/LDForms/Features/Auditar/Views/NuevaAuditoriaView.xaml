<Window x:Class="LD.FormsX.Views.Auditar.NuevaAuditoriaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Seleccionar orden de entrega"
        Height="660"
        Width="1080"
        MinHeight="560"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Border Background="#F3F4F6"
            CornerRadius="14"
            BorderBrush="#D1D5DB"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0B8E00"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Seleccionar orden de entrega"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                            Content="x"
                            Click="BtnCerrar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="18,16,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TxtContexto"
                           Text="Solo se muestran ordenes en Cargando de tus almacenes."
                           FontSize="12"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"/>

                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        CornerRadius="10"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtBuscar"
                                 Height="32"
                                 Padding="10,4"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 TextChanged="txtBuscar_TextChanged"
                                 KeyDown="txtBuscar_KeyDown"/>

                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="BtnBuscar_Click"
                                Background="#EEF2FF"
                                BorderBrush="#C7D2FE"
                                BorderThickness="1"
                                Cursor="Hand"
                                Focusable="False">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE721;"
                                           Foreground="#4F46E5"
                                           FontSize="13"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="Buscar" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1">
                    <DataGrid x:Name="dgOpciones"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Vertical"
                              ItemsSource="{Binding FilteredItems}"
                              SelectionChanged="dgOpciones_SelectionChanged"
                              MouseDoubleClick="dgOpciones_MouseDoubleClick"
                              PreviewKeyDown="dgOpciones_PreviewKeyDown"
                              FontSize="12"
                              RowHeight="30"
                              ColumnHeaderHeight="32"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Orden de entrega"
                                                Binding="{Binding OrdenEntrega}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Cliente}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Proyecto"
                                                Binding="{Binding Proyecto}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Almacen"
                                                Binding="{Binding Almacen}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Kittings"
                                                Binding="{Binding KittingsCount}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="18,0,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        x:Name="BtnAceptar"
                        Height="32"
                        Content="Aceptar"
                        Click="BtnAceptar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        Cursor="Hand"
                        IsDefault="True"
                        IsEnabled="False"/>

                <Button Grid.Column="3"
                        Height="32"
                        Content="Cancelar"
                        Click="BtnCerrar_Click"
                        Background="White"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>

            <Border x:Name="LoadingOverlay"
                    Grid.RowSpan="3"
                    Background="#80FFFFFF"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="240"
                                 Height="18"/>
                    <TextBlock x:Name="TxtLoading"
                               Text="Cargando ordenes..."
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#24344D"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
