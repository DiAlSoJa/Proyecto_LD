<Window x:Class="LD.FormsX.Features.Surtidos.Views.CapturaFolioDetalleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Detalle de folio"
        Width="860"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBg}"
        WindowStyle="None">

    <Window.Resources>
        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>

        <Style x:Key="PanelValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{StaticResource SurfaceCard}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="18,18,18,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocumentOutline"
                                             Width="26"
                                             Height="26"
                                             Foreground="{StaticResource IconSurtido}"
                                             VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="{Binding KittingCode, FallbackValue='Folio capturado'}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="{Binding KittingStatus, StringFormat=Estatus Kitting: {0}}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="X"
                        Width="34"
                        Height="34"
                        Background="{StaticResource SurfaceSubtle}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        Foreground="{StaticResource TextSecondary}"
                        Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="18,18,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Cliente"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding Client}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Proyecto"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding Project}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Guia"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding GuideNumber}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Factura"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding InvoiceNumber}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,18,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Parte"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding PartNumber}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Cantidad"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding Quantity}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,18,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Lote"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding LotNumber}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Linea de archivo"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding SourceLineNumber}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,18,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Archivo"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding SourceFileName}"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Creado"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Kitting"/>
                    <TextBlock Style="{StaticResource PanelValueStyle}" Text="{Binding KittingCode}"/>
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2">
                    <TextBlock Style="{StaticResource PanelTitleStyle}" Text="Descripcion"/>
                    <Border Margin="0,6,0,0"
                            Padding="12"
                            Background="{StaticResource SurfaceSubtle}"
                            CornerRadius="10">
                        <TextBlock Style="{StaticResource PanelValueStyle}"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="18,0,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding KittingStatus, StringFormat=Estatus actual: {0}}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"/>

                <Button Grid.Column="1"
                        Content="Cerrar"
                        Padding="18,8"
                        Background="{StaticResource SurfaceSubtle}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        Foreground="{StaticResource TextPrimary}"
                        Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
