<UserControl x:Class="LD.FormsX.Features.Surtidos.Views.CapturaFoliosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:LD.FormsX.Features.Common"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceCard}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="12,12,12,8"
                Padding="14"
                Background="{StaticResource SurfaceCard}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Width="28"
                                                 Height="28"
                                                 Foreground="{StaticResource IconSurtido}"
                                                 VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Captura de folios"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Importa un archivo de texto y genera un Kitting con sus detalles."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               TextAlignment="Right"
                               Margin="16,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Cliente:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               Margin="0,0,8,0"/>

                    <common:InlineLookupEditor x:Name="lookupCliente"
                                               Grid.Column="1"
                                               Height="30"
                                               Tag="Cliente|Clave"
                                               ItemsSource="{Binding ClientLookupItems}"
                                               DisplayMemberPath="Code"
                                               SearchMemberPaths="Code,Description"
                                               SelectedCode="{Binding SelectedClientText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               SelectedId="{Binding SelectedClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               EditorCornerRadius="10"
                                               EditorPadding="14,6,8,6"
                                               EditorBorderBrush="{StaticResource BorderSoft}"
                                               EditorBorderThickness="1.2"
                                               EditorForeground="{StaticResource TextPrimary}"
                                               EditorFontSize="12"
                                               GlyphBrush="{StaticResource TextSecondary}"
                                               RequireSelectionMatch="True"
                                               MaxResults="12"
                                               OpenDropDownOnLoad="False"
                                               SelectAllTextOnLoad="False"
                                               SelectionConfirmed="LookupCliente_SelectionConfirmed"/>

                    <TextBlock Grid.Column="2"
                               Text="Proyecto:"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               Margin="12,0,8,0"/>

                    <common:InlineLookupEditor x:Name="lookupProyecto"
                                               Grid.Column="3"
                                               Height="30"
                                               Tag="Proyecto|Clave"
                                               ItemsSource="{Binding ProjectLookupItems}"
                                               DisplayMemberPath="Code"
                                               SearchMemberPaths="Code,Description"
                                               SelectedCode="{Binding SelectedProjectText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               SelectedId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               EditorCornerRadius="10"
                                               EditorPadding="14,6,8,6"
                                               EditorBorderBrush="{StaticResource BorderSoft}"
                                               EditorBorderThickness="1.2"
                                               EditorForeground="{StaticResource TextPrimary}"
                                               EditorFontSize="12"
                                               GlyphBrush="{StaticResource TextSecondary}"
                                               RequireSelectionMatch="True"
                                               MaxResults="12"
                                               OpenDropDownOnLoad="False"
                                               SelectAllTextOnLoad="False"
                                               SelectionConfirmed="LookupProyecto_SelectionConfirmed"/>

                    <WrapPanel Grid.Column="4"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button x:Name="btnActualizar"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding ActualizarCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{StaticResource IconSurtido}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Actualizar"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnGenerar"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"
                                Click="BtnGenerar_Click"
                                IsEnabled="{Binding CanGenerate}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{StaticResource IconSurtido}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Generar"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnConsultar"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding ConsultarCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Magnify"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{StaticResource IconSurtido}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Consultar"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCancelar"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding CancelarCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Cancel"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{StaticResource IconSurtido}"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Cancelar"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="{Binding BusyMessage}"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12,0,12,12"
                Padding="10"
                Background="{StaticResource SurfaceCard}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <DataGrid x:Name="dgCapturas"
                          ItemsSource="{Binding Capturas}"
                          SelectedItem="{Binding SelectedCapture, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="{StaticResource SurfaceSubtle}"
                          AlternationCount="2"
                          RowHeight="28"
                          ColumnHeaderHeight="32"
                          FontSize="12"
                          VerticalGridLinesBrush="{StaticResource BorderSoft}"
                          HorizontalGridLinesBrush="{StaticResource BorderSoft}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Creado" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Client}" Width="150"/>
                        <DataGridTextColumn Header="Proyecto" Binding="{Binding Project}" Width="150"/>
                        <DataGridTextColumn Header="Kitting" Binding="{Binding KittingCode}" Width="130"/>
                        <DataGridTextColumn Header="Estatus Kitting" Binding="{Binding KittingStatus}" Width="125"/>
                        <DataGridTextColumn Header="Guia" Binding="{Binding GuideNumber}" Width="120"/>
                        <DataGridTextColumn Header="Factura" Binding="{Binding InvoiceNumber}" Width="120"/>
                        <DataGridTextColumn Header="Parte" Binding="{Binding PartNumber}" Width="150"/>
                        <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}" Width="240"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
                        <DataGridTextColumn Header="Lote" Binding="{Binding LotNumber}" Width="120"/>
                        <DataGridTextColumn Header="Archivo" Binding="{Binding SourceFileName}" Width="190"/>
                        <DataGridTextColumn Header="Linea" Binding="{Binding SourceLineNumber}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource SurfaceCard}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="220"
                                     Height="18"/>
                        <TextBlock Text="{Binding BusyMessage}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
