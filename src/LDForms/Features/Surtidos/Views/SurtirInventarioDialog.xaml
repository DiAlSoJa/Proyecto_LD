<Window x:Class="LD.FormsX.Features.Surtidos.Views.SurtirInventarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surtir inventario"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#233167"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextBrush" Color="#111827"/>

        <Style TargetType="Button" x:Key="DialogActionButtonStyle">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="14"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Surtir inventario"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="Selecciona varias lineas de inventario para generarlas en Issue details."
                                   FontSize="12"
                                   Foreground="#E5E7EB"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="X"
                            Width="34"
                            Height="34"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#FFFFFF"
                            BorderBrush="#FFFFFF"
                            Foreground="{StaticResource PrimaryBrush}"
                            Cursor="Hand"
                            Name="btnClose"
                            Click="BtnCancelar_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Cliente"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="txtCliente"
                                 Grid.Column="1"
                                 Height="30"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 Background="White"
                                 TextChanged="Filtro_TextChanged"/>

                        <TextBlock Grid.Column="3"
                                   Text="Proyecto"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="txtProyecto"
                                 Grid.Column="4"
                                 Height="30"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 Background="White"
                                 TextChanged="Filtro_TextChanged"/>

                        <TextBlock Grid.Column="6"
                                   Text="Número de parte"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,8,0"/>

                        <TextBox x:Name="txtParte"
                                 Grid.Column="7"
                                 Height="30"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 BorderBrush="{StaticResource BorderBrushSoft}"
                                 Background="White"
                                 TextChanged="Filtro_TextChanged"/>

                        <CheckBox x:Name="chkSoloEstatusDisponible"
                                  Grid.Column="9"
                                  Content="Solo estatus disponible"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Foreground="{StaticResource TextBrush}"
                                  Checked="ChkSoloEstatusDisponible_CheckedChanged"
                                  Unchecked="ChkSoloEstatusDisponible_CheckedChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="12"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtStatus"
                                   Grid.Row="0"
                                   Text="Cargando inventario..."
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="2,0,0,2"/>

                        <Border Grid.Row="2"
                                BorderBrush="#D9DEE7"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <DataGrid x:Name="dgInventario"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          RowHeight="28"
                                          ColumnHeaderHeight="36"
                                          FontSize="12"
                                          VerticalGridLinesBrush="#D9D9D9"
                                          HorizontalGridLinesBrush="#E4E8EE"
                                          AlternatingRowBackground="{StaticResource AltRowBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Margin="0"
                                          MouseDoubleClick="DgInventario_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#EEF1F5"/>
                                            <Setter Property="Foreground" Value="#16263D"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        </Style>

                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvailableStatus}" Value="Surtido">
                                                    <Setter Property="Background" Value="#FFF7ED"/>
                                                    <Setter Property="Foreground" Value="#9A3412"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="160"/>
                                        <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="160"/>
                                        <DataGridTextColumn Header="No. Parte" Binding="{Binding PartNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}" Width="210"/>
                                        <DataGridTextColumn Header="Lote" Binding="{Binding LotNumber}" Width="120"/>
                                        <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="140"/>
                                        <DataGridTextColumn Header="Referencia disponible" Binding="{Binding AvailableReference}" Width="160"/>
                                        <DataGridTextColumn Header="Orden compra" Binding="{Binding PurchaseOrder}" Width="140"/>
                                        <DataGridTextColumn Header="Pedimento" Binding="{Binding CustomsDeclarationNumber}" Width="130"/>
                                        <DataGridTextColumn Header="Ubicacion" Binding="{Binding Ubicacion}" Width="130"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusId}" Width="110"/>
                                        <DataGridTextColumn Header="Estatus disponible" Binding="{Binding AvailableStatus}" Width="150"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Qty}" Width="90"/>
                                        <DataGridTextColumn Header="StandardId" Binding="{Binding StandardIdStr}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border x:Name="loadingOverlay"
                                        Background="#CCFFFFFF"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="10">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <ProgressBar Width="240"
                                                     Height="8"
                                                     IsIndeterminate="True"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Margin="0,0,0,10"/>
                                        <TextBlock x:Name="txtLoading"
                                                   Text="Cargando inventario..."
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F3F4F6"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1,1,0,0"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnAceptar"
                            Content="Aceptar"
                            Width="120"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Margin="0,0,10,0"
                            Click="BtnAceptar_Click"/>
                    <Button x:Name="btnCancelar"
                            Content="Cancelar"
                            Width="120"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Background="White"
                            Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            Click="BtnCancelar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
