<UserControl x:Class="LD.FormsX.Features.Common.InlineLookupEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="root"
             mc:Ignorable="d"
             MinHeight="28"
             Focusable="False">
    <Grid>
        <Border Background="{Binding EditorBackground, ElementName=root}"
                BorderBrush="{Binding EditorBorderBrush, ElementName=root}"
                BorderThickness="{Binding EditorBorderThickness, ElementName=root}"
                CornerRadius="{Binding EditorCornerRadius, ElementName=root}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtLookup"
                         Grid.Column="0"
                         Padding="{Binding EditorPadding, ElementName=root}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{Binding EditorForeground, ElementName=root}"
                         FontSize="{Binding EditorFontSize, ElementName=root}"
                         VerticalContentAlignment="Center"
                         Loaded="txtLookup_Loaded"
                         GotKeyboardFocus="txtLookup_GotKeyboardFocus"
                         TextChanged="txtLookup_TextChanged"
                         PreviewKeyDown="txtLookup_PreviewKeyDown"/>

                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Click="DropDownButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE70D;"
                               FontSize="10"
                               Foreground="{Binding GlyphBrush, ElementName=root}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="popupLookup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=txtLookup}"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Width="560">
            <Border Background="#FCFCFD"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    MinWidth="560"
                    MaxHeight="320">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#E2E8F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtPrimaryHeader"
                                   Grid.Column="0"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   Text="Numero de parte"/>
                        <TextBlock x:Name="txtSecondaryHeader"
                                   Grid.Column="2"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#334155"
                                   FontWeight="SemiBold"
                                   Text="Descripcion"/>
                    </Grid>

                    <ListBox x:Name="lstLookup"
                             Grid.Row="1"
                             BorderThickness="0"
                             ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             PreviewMouseLeftButtonDown="lstLookup_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="lstLookup_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="#FCFCFD"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#DCEAFE"/>
                                        <Setter Property="BorderBrush" Value="#60A5FA"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Code}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Description}"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
