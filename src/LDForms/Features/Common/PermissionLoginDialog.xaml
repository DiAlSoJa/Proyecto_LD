<Window x:Class="LD.FormsX.Features.Common.PermissionLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorizar accion"
        Width="420"
        Height="330"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border Background="White"
            CornerRadius="14"
            BorderBrush="#E5E7EB"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="2"
                              Opacity="0.22"
                              Color="#111827"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#233167"
                    Padding="16,12"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="txtTitle"
                                   Text="Autorizar accion"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtSubtitle"
                                   Margin="0,3,0,0"
                                   Text="Ingresa credenciales con permiso suficiente."
                                   Foreground="#E5E7EB"
                                   FontSize="12"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Content="X"
                            Background="White"
                            BorderBrush="White"
                            Foreground="#233167"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Usuario"
                           Foreground="#111827"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtUsuario"
                         Grid.Row="2"
                         Height="34"
                         Padding="10,4"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Background="White"
                         KeyDown="TxtUsuario_KeyDown"/>

                <TextBlock Grid.Row="4"
                           Text="Contrasena"
                           Foreground="#111827"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <PasswordBox x:Name="txtPassword"
                             Grid.Row="6"
                             Height="34"
                             Padding="10,4"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="White"
                             KeyDown="TxtPassword_KeyDown"/>

                <Border Grid.Row="8"
                        x:Name="messagePanel"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                    <TextBlock x:Name="txtMessage"
                               Text="Listo para validar permisos."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="#475569"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="#F3F4F6"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Width="100"
                            Height="34"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            Foreground="#111827"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="btnAutorizar"
                            Content="Autorizar"
                            Width="112"
                            Height="34"
                            Cursor="Hand"
                            Background="#233167"
                            BorderBrush="#233167"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Click="BtnAutorizar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
