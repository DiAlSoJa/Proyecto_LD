<Window x:Class="LD.FormsX.Views.Almacen.NuevoAlmacenView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Nuevo almacén"
        Height="540"
        Width="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Width="740"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnCerrar_Click"
                                Content="×"/>
                    </Grid>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1" Margin="28,20,28,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Nombre del almacén (ocupa 2 columnas) -->
                    <controls:LDInput Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                      Label="Nombre del almacén"
                                      Placeholder="Ej. Centro de Distribución Norte"
                                      Text="{Binding WarehouseName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Fila 2: Domicilio + Colonia -->
                    <controls:LDInput Grid.Row="2" Grid.Column="0"
                                      Label="Domicilio"
                                      Placeholder="Calle y número"
                                      Margin="0,0,8,0"
                                      Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    <controls:LDInput Grid.Row="2" Grid.Column="1"
                                      Label="Colonia"
                                      Placeholder="Colonia"
                                      Margin="8,0,0,0"
                                      Text="{Binding Neighborhood, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Fila 4: Ciudad + CP -->
                    <controls:LDInput Grid.Row="4" Grid.Column="0"
                                      Label="Ciudad"
                                      Placeholder="Ciudad"
                                      Margin="0,0,8,0"
                                      Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                    <controls:LDInput Grid.Row="4" Grid.Column="1"
                                      Label="Código postal"
                                      Placeholder="00000"
                                      Margin="8,0,0,0"
                                      MaxLength="10"
                                      Text="{Binding ZipCode, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Fila 6: Capacidad (mitad izquierda) -->
                    <controls:LDInput Grid.Row="6" Grid.Column="0"
                                      Label="Capacidad"
                                      Placeholder="Ej. 1000"
                                      Margin="0,0,8,0"
                                      MaxLength="10"
                                      Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Fila 8: Checkboxes -->
                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,4,0,0">
                        <CheckBox Content="Producción"
                                  FontSize="14"
                                  Foreground="{StaticResource TextBody}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsProduction}"
                                  Margin="0,0,24,0"/>
                        <CheckBox Content="Activo"
                                  FontSize="14"
                                  Foreground="{StaticResource TextBody}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsActive}"/>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
