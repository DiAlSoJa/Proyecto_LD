<Window x:Class="LD.FormsX.Views.Almacen.CortinasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Cortinas"
        Height="580"
        Width="1040"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Width="1020"
                HorizontalAlignment="Center"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="BtnClose_Click"
                                Content="&#x00D7;"/>
                    </Grid>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1" Margin="28,20,28,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceSubtle}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:LDInput x:Name="ldBuscar"
                                              Grid.Column="0"
                                              Placeholder="Buscar cortina..."
                                              VerticalAlignment="Center"/>

                            <Button x:Name="btnNuevo"
                                    Grid.Column="2"
                                    Height="38"
                                    Padding="12,0"
                                    Click="BtnNuevo_Click"
                                    Background="{StaticResource SurfaceSubtle}"
                                    Foreground="{StaticResource TextSubtle}"
                                    BorderBrush="{StaticResource BorderInput}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE710;"
                                               Foreground="{StaticResource AccentAction}"
                                               Margin="0,0,6,0"
                                               FontSize="14"/>
                                    <TextBlock Text="Nuevo"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnEditar"
                                    Grid.Column="4"
                                    Height="38"
                                    Padding="12,0"
                                    Click="BtnEditar_Click"
                                    IsEnabled="{Binding CanExecuteEdit}"
                                    Background="{StaticResource SurfaceSubtle}"
                                    Foreground="{StaticResource TextSubtle}"
                                    BorderBrush="{StaticResource BorderInput}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE70F;"
                                               Foreground="{StaticResource AccentWarning}"
                                               Margin="0,0,6,0"
                                               FontSize="14"/>
                                    <TextBlock Text="Editar"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnEliminar"
                                    Grid.Column="6"
                                    Height="38"
                                    Padding="12,0"
                                    Click="BtnEliminar_Click"
                                    IsEnabled="{Binding CanExecuteDelete}"
                                    Background="{StaticResource SurfaceSubtle}"
                                    Foreground="{StaticResource TextSubtle}"
                                    BorderBrush="{StaticResource BorderInput}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE74D;"
                                               Foreground="{StaticResource AccentError}"
                                               Margin="0,0,6,0"
                                               FontSize="14"/>
                                    <TextBlock Text="Eliminar"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceCard}"
                            CornerRadius="12"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="4,0,0,8"/>

                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource BorderMuted}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{StaticResource SurfaceCard}">
                                <DataGrid x:Name="dgCortinas"
                                          AutoGenerateColumns="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Vertical"
                                          SelectionChanged="dgCortinas_SelectionChanged"
                                          RowHeight="28"
                                          ColumnHeaderHeight="40"
                                          AlternatingRowBackground="{StaticResource DataGridAltRow}"
                                          AlternationCount="2"
                                          FontSize="12"
                                          VerticalGridLinesBrush="{StaticResource BorderGrid}"
                                          Margin="0">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="9,6"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
