<UserControl x:Class="LD.FormsX.Views.ControlPatio.ControlPatioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LD.FormsX.Controls"
             xmlns:contracts="clr-namespace:LD.Contracts.Enums;assembly=LD.Contracts"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Background="{StaticResource SurfaceMain}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="MonitorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="MonitorChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="MonitorSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
        </Style>

        <Style x:Key="MonitorSectionValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border Grid.Row="0"
                Background="{StaticResource PatioMonitorHeroBg}"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="Control de patio"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Monitor de movimientos faltantes para cajas y tractos desde securityregistrations."
                           Margin="0,1,0,0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{StaticResource TextSubtle}"/>
            </StackPanel>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="2"
                Style="{StaticResource MonitorCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:LDInput Grid.Column="0"
                                  Label="Buscar"
                                  Placeholder="Placa, operador, paso, cortina..."
                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <controls:LDSelector Grid.Column="2"
                                     Label="Secuencia"
                                     Placeholder="Todas"
                                     ItemsSource="{Binding SequenceFilters}"
                                     DisplayMemberPath="Label"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding SelectedSequenceFilterValue, Mode=TwoWay}"/>

                <CheckBox Grid.Column="4"
                          Content="Solo críticos"
                          IsChecked="{Binding OnlyCritical, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource TextSubtle}"
                          FontWeight="SemiBold"/>

                <Button Grid.Column="6"
                        Height="38"
                        Padding="14,0"
                        Command="{Binding LimpiarFiltrosCommand}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Limpiar filtros"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="8"
                        Height="38"
                        Padding="14,0"
                        Command="{Binding CargarDatosCommand}"
                        IsEnabled="{Binding CanView}"
                        Background="{StaticResource AppPrimary}"
                        Foreground="{StaticResource TextOnPrimary}"
                        BorderBrush="{StaticResource AppPrimary}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="14"
                                                 Height="14"
                                                 Foreground="{StaticResource TextOnPrimary}"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Actualizar"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Grid.Column="0" Style="{StaticResource MonitorCardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Unidades en patio"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{StaticResource MonitorChipStyle}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CajaCount, StringFormat=Cajas: {0}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSubtle}"/>
                            </Border>
                            <Border Style="{StaticResource MonitorChipStyle}">
                                <TextBlock Text="{Binding TractoCount, StringFormat=Tractos: {0}}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSubtle}"/>
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderMuted}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="{StaticResource SurfaceCard}">
                        <DataGrid x:Name="dgPatioUnits"
                                  ItemsSource="{Binding PatioRowsView}"
                                  SelectedItem="{Binding SelectedRegistration, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  RowHeight="40"
                                  ColumnHeaderHeight="42"
                                  AlternatingRowBackground="{StaticResource DataGridAltRow}"
                                  AlternationCount="2"
                                  FontSize="12"
                                  VerticalGridLinesBrush="{StaticResource BorderGrid}"
                                  HorizontalGridLinesBrush="{StaticResource BorderRow}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="9,6"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="{StaticResource SurfaceCard}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PatioMonitorOverdueBg}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PatioMonitorCurrentBg}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Estado"
                                                        SortMemberPath="StatusBadgeText"
                                                        Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4"
                                                    CornerRadius="14"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PatioMonitorPendingBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorPendingBorder}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="Crítico">
                                                                <Setter Property="Background" Value="{StaticResource PatioMonitorOverdueBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorOverdueBorder}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="En seguimiento">
                                                                <Setter Property="Background" Value="{StaticResource PatioMonitorCurrentBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorCurrentBorder}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="Completado">
                                                                <Setter Property="Background" Value="{StaticResource PatioMonitorCompletedBg}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorCompletedBorder}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusBadgeText}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSubtle}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Unidad" Binding="{Binding Numero}" Width="95"/>
                                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="110"/>
                                <DataGridTextColumn Header="Tipo vehículo" Binding="{Binding TipoVehiculo}" Width="130"/>
                                <DataGridTextColumn Header="Secuencia" Binding="{Binding SequenceText}" Width="95"/>
                                <DataGridTextColumn Header="Cortina" Binding="{Binding CortinaNumero}" Width="95"/>
                                <DataGridTextColumn Header="Paso actual" Binding="{Binding CurrentStep}" Width="150"/>
                                <DataGridTextColumn Header="Siguiente" Binding="{Binding NextStep}" Width="150"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding MinutesSinceLastEvent, StringFormat={}{0} min}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource MonitorCardStyle}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Secuencia de pasos"
                                   Margin="0,0,0,10"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <ItemsControl ItemsSource="{Binding SelectedSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            CornerRadius="16"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PatioMonitorPendingBg}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorPendingBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:PatioMonitorStepState_e.Completed}">
                                                        <Setter Property="Background" Value="{StaticResource PatioMonitorCompletedBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorCompletedBorder}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:PatioMonitorStepState_e.Current}">
                                                        <Setter Property="Background" Value="{StaticResource PatioMonitorCurrentBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorCurrentBorder}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:PatioMonitorStepState_e.Overdue}">
                                                        <Setter Property="Background" Value="{StaticResource PatioMonitorOverdueBg}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource PatioMonitorOverdueBorder}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="36"
                                                    Height="36"
                                                    CornerRadius="18"
                                                    Background="{StaticResource AppPrimary}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Order}"
                                                           Foreground="{StaticResource TextOnPrimary}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Area}"
                                                           Margin="0,3,0,0"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Note}"
                                                           Margin="0,6,0,0"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextSubtle}"/>
                                                <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue=Pendiente}"
                                                           Margin="0,6,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>

                                            <Border Grid.Column="3"
                                                    Style="{StaticResource MonitorChipStyle}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StateText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSubtle}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
