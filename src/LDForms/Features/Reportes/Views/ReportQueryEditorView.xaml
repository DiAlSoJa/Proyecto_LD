<Window x:Class="LD.FormsX.Views.Reportes.ReportQueryEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Consulta"
        Width="980"
        Height="740"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="Background" Value="{StaticResource AppPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromeHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceCard}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource AppPrimary}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0" Height="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Define un nombre y una consulta SQL parametrizada."
                                   Foreground="{StaticResource TextOnPrimary}"
                                   Opacity="0.82"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextOnPrimary}"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnCerrar_Click"
                            Content="×"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,18">
                <Border Background="{StaticResource SurfaceCard}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <controls:LDInput Label="Nombre"
                                              Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                              Placeholder="Ej. Movimientos por fecha"
                                              InputHeight="36"
                                              TextVerticalAlignment="Center"/>

                            <TextBlock Text="El nombre se mostrará al usuario final."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       Margin="2,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <controls:LDInput Label="Consulta SQL"
                                              Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                              Placeholder="SELECT ... WHERE Fecha >= @fecha"
                                              InputHeight="360"
                                              TextVerticalAlignment="Top"
                                              InputTextWrapping="NoWrap"
                                              AcceptsReturn="True"
                                              AcceptsTab="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              HelpText="Usa parámetros con @nombre, por ejemplo @fecha o @almacenId."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceTabHeader}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="0,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,24,0">
                    <Button x:Name="btnSave"
                            Content="Guardar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="btnSave_Click"/>
                    <Button Content="Cerrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCerrar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
