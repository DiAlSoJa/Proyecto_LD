<Window x:Class="LD.FormsX.Views.Reportes.ReportQueryParametersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Parámetros"
        Width="760"
        Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
            <Setter Property="Background" Value="{StaticResource AppPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubtle}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromeHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnChromePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceCard}"
            CornerRadius="16"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource AppPrimary}"
                    CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0" Height="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderTitle}"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   Opacity="0.82"
                                   FontSize="12"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextOnPrimary}"
                            FontSize="18"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnCerrar_Click"
                            Content="×"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22">
                <Border Background="{StaticResource SurfaceCard}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Completa los valores requeridos. Deja vacío si deseas enviar NULL."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"/>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceCard}"
                                                BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,12">
                                            <controls:LDInput Label="{Binding DisplayName}"
                                                              Text="{Binding Valor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Placeholder="Ingresa el valor"
                                                              InputHeight="36"
                                                              TextVerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border x:Name="loadingOverlay"
                        Background="{StaticResource LoadingOverlayBg}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        CornerRadius="12"
                        Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar Width="220"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Foreground="{StaticResource AppPrimary}"
                                     Margin="0,0,0,10"/>
                        <TextBlock Text="Cargando parámetros..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextOnLoading}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceTabHeader}"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16"
                    Padding="0,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,22,0">
                    <Button Content="Ejecutar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="BtnEjecutar_Click"/>
                    <Button Content="Cerrar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCerrar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
