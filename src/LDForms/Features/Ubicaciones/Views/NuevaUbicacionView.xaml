<Window x:Class="LD.FormsX.Views.Ubicaciones.NuevaUbicacionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Nueva ubicación"
        Height="560"
        Width="980"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="CheckStyle" TargetType="CheckBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RadioStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Width="950"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding HeaderTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnCerrar_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1" Margin="28,24,28,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda -->
                    <StackPanel Grid.Column="0">
                        <controls:LDSelector Label="Almacén"
                                             ItemsSource="{Binding WarehousesSource}"
                                             SelectedValue="{Binding SelectedWarehouseId}"
                                             DisplayMemberPath="Value"
                                             SelectedValuePath="Key"
                                             Margin="0,0,0,14"/>

                        <controls:LDInput Label="Ubicación"
                                          Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,14"/>

                        <StackPanel Margin="0,0,0,18">
                            <CheckBox Content="Activo"
                                      IsChecked="{Binding IsActive}"
                                      Style="{StaticResource CheckStyle}"/>
                            <CheckBox Content="Fiscal"
                                      IsChecked="{Binding IsFiscal}"
                                      Style="{StaticResource CheckStyle}"/>
                            <CheckBox Content="Temperatura controlada"
                                      IsChecked="{Binding HasControlledTemperature}"
                                      Style="{StaticResource CheckStyle}"/>
                        </StackPanel>

                        <!-- Dimensiones -->
                        <Border BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceCard}"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Dimensiones"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <controls:LDInput Label="Alto (cm.)"
                                                  Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,10"/>
                                <controls:LDInput Label="Ancho (cm.)"
                                                  Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,10"/>
                                <controls:LDInput Label="Profundidad (cm.)"
                                                  Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Columna derecha -->
                    <StackPanel Grid.Column="2">
                        <Border BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceCard}"
                                Padding="16"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Tipo de ubicación"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            BorderBrush="{StaticResource BorderSoft}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,12,0"
                                            Background="{StaticResource SurfaceCard}">
                                        <StackPanel>
                                            <RadioButton Content="Rack"
                                                         IsChecked="{Binding IsRack}"
                                                         Style="{StaticResource RadioStyle}"
                                                         GroupName="TipoUbicacion"/>
                                            <RadioButton Content="Compartido"
                                                         IsChecked="{Binding IsCompartidoType}"
                                                         Style="{StaticResource RadioStyle}"
                                                         GroupName="TipoUbicacion"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <RadioButton Content="General"
                                                     IsChecked="{Binding IsGeneral}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="SubTipo"/>
                                        <RadioButton Content="Compartido"
                                                     IsChecked="{Binding IsCompartido}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="SubTipo"/>
                                        <RadioButton Content="Recibo y embarque"
                                                     IsChecked="{Binding IsReciboYEmbarque}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="SubTipo"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <RadioButton Content="Cuarentena"
                                                     IsChecked="{Binding IsCuarentena}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="SubTipo"/>
                                        <RadioButton Content="Embarque"
                                                     IsChecked="{Binding IsEmbarque}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="SubTipo"/>
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,16,0,0"
                                        Background="{StaticResource SurfaceCard}"
                                        Width="210"
                                        HorizontalAlignment="Left">
                                    <StackPanel>
                                        <RadioButton Content="Doble"
                                                     IsChecked="{Binding IsDoble}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="Tamano"/>
                                        <RadioButton Content="Sencillo"
                                                     IsChecked="{Binding IsSencillo}"
                                                     Style="{StaticResource RadioStyle}"
                                                     GroupName="Tamano"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Background="{StaticResource SurfaceCard}"
                                Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Paso"
                                          IsChecked="{Binding HasPaso}"
                                          Style="{StaticResource CheckStyle}"
                                          Margin="0,0,26,0"/>
                                <CheckBox Content="Cortina"
                                          IsChecked="{Binding HasCortina}"
                                          Style="{StaticResource CheckStyle}"
                                          Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
