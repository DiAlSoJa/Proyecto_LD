<UserControl x:Class="LD.FormsX.Views.UbicacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LD.FormsX.Controls"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="12"
                Padding="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Ubicaciones"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Consulta, crea y edita ubicaciones"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <controls:LDSelector x:Name="cmbAlmacen"
                                     Grid.Column="1"
                                     Label="Almacén:"
                                     DisplayMemberPath="Value"
                                     SelectedValuePath="Key"
                                     VerticalAlignment="Center"/>

                <Button x:Name="btnNuevo"
                        Grid.Column="3"
                        Height="38"
                        Padding="12,0"
                        Click="BtnNuevo_Click"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE710;"
                                   Foreground="{StaticResource AccentAction}"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Nuevo"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnNuevoMasivo"
                        Grid.Column="5"
                        Height="38"
                        Padding="12,0"
                        Click="BtnNuevoMasivo_Click"
                        Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE710;"
                                   Foreground="{StaticResource AccentAction}"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Nueva ubicación masiva"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnEditar"
                        Grid.Column="7"
                        Height="38"
                        Padding="12,0"
                        Click="BtnEditar_Click"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding CanExecuteEdit}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE70F;"
                                   Foreground="{StaticResource AccentWarning}"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Editar"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnActualizar"
                        Grid.Column="9"
                        Height="38"
                        Padding="12,0"
                        Command="{Binding CargarDatosCommand}"
                        Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource SurfaceSubtle}"
                        Foreground="{StaticResource TextSubtle}"
                        BorderBrush="{StaticResource BorderInput}"
                        BorderThickness="1"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE895;"
                                   Foreground="{StaticResource AccentSuccess}"
                                   Margin="0,0,6,0"
                                   FontSize="14"/>
                        <TextBlock Text="Actualizar"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="1"
                        BorderBrush="{StaticResource BorderMuted}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{StaticResource SurfaceCard}">
                    <Grid>
                        <DataGrid x:Name="dg"
                                  AutoGenerateColumns="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                                  SelectionChanged="dg_SelectionChanged"
                                  Visibility="{Binding CanView, Converter={StaticResource BoolToVis}}"
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  AlternatingRowBackground="{StaticResource DataGridAltRow}"
                                  AlternationCount="2"
                                  FontSize="12"
                                  VerticalGridLinesBrush="{StaticResource BorderGrid}"
                                  Margin="0">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource DataGridHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{StaticResource DataGridHeaderFg}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderMuted}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="9,6"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderRow}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <!-- Loader -->
                        <Border Background="{StaticResource LoadingOverlayBg}"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="18"/>
                                <TextBlock Text="{Binding LoadingMessage}"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextOnLoading}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
