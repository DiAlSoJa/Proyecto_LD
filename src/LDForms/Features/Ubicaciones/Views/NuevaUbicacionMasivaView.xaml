<Window x:Class="LD.FormsX.Views.Ubicaciones.NuevaUbicacionMasivaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LD.FormsX.Controls"
        mc:Ignorable="d"
        Title="Nueva ubicación masiva"
        Width="980"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Controls/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="CheckStyle" TargetType="CheckBox">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RadioStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border Width="950"
                MinHeight="660"
                Background="{StaticResource SurfaceCard}"
                CornerRadius="16"
                BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource AppPrimary}"
                        CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="16,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nueva ubicación masiva"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextOnPrimary}"
                                   FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Width="30" Height="30"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextOnPrimary}"
                                FontSize="18" FontWeight="Bold"
                                Cursor="Hand" Click="BtnCerrar_Click" Content="×"/>
                    </Grid>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1" Margin="28,24,28,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="390"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <controls:LDSelector x:Name="cmbAlmacenN"
                                                     Label="Almacén"
                                                     Margin="0,0,0,14"/>

                                <controls:LDInput x:Name="txtRack"
                                                  Label="Rack"
                                                  Margin="0,0,0,14"/>

                                <controls:LDInput x:Name="txtAisle"
                                                  Label="Pasillo"
                                                  Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:LDInput x:Name="txtDesde"
                                                      Grid.Column="0"
                                                      Label="Posición desde:"/>
                                    <controls:LDInput x:Name="txtHasta"
                                                      Grid.Column="2"
                                                      Label="Posición hasta:"/>
                                </Grid>

                                <controls:LDInput x:Name="txtNiveles"
                                                  Label="Niveles (1 a 36)"
                                                  Margin="0,0,0,18"/>

                                <StackPanel Margin="0,0,0,18">
                                    <CheckBox x:Name="checkIsActive"
                                              Content="Activo"
                                              IsChecked="True"
                                              Style="{StaticResource CheckStyle}"/>
                                    <CheckBox x:Name="checkIsFiscal"
                                              Content="Fiscal"
                                              Style="{StaticResource CheckStyle}"/>
                                    <CheckBox x:Name="checkTemperatura"
                                              Content="Temperatura controlada"
                                              Style="{StaticResource CheckStyle}"/>
                                </StackPanel>

                                <Border BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceCard}"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Dimensiones"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <controls:LDInput x:Name="txtAltoCm"
                                                          Label="Alto (cm.)"
                                                          Margin="0,0,0,10"/>
                                        <controls:LDInput x:Name="txtAnchoCm"
                                                          Label="Ancho (cm.)"
                                                          Margin="0,0,0,10"/>
                                        <controls:LDInput x:Name="txtProfundidadCm"
                                                          Label="Profundidad (cm.)"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceCard}"
                                        Padding="16"
                                        Margin="0,218,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Tipo de ubicación"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    BorderBrush="{StaticResource BorderSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    Margin="0,0,12,0"
                                                    Background="{StaticResource SurfaceCard}">
                                                <StackPanel>
                                                    <RadioButton x:Name="radioRack"
                                                                 Content="Rack"
                                                                 IsChecked="True"
                                                                 Style="{StaticResource RadioStyle}"/>
                                                    <RadioButton x:Name="radioCompartidoType"
                                                                 Content="Compartido"
                                                                 Style="{StaticResource RadioStyle}"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <RadioButton x:Name="radioGeneral"
                                                             Content="General"
                                                             IsChecked="True"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioCompartido"
                                                             Content="Compartido"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioReciboEmbarque"
                                                             Content="Recibo y embarque"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <RadioButton x:Name="radioCuarentena"
                                                             Content="Cuarentena"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioEmbarque"
                                                             Content="Embarque"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,16,0,0"
                                                Background="{StaticResource SurfaceCard}"
                                                Width="210"
                                                HorizontalAlignment="Left">
                                            <StackPanel>
                                                <RadioButton x:Name="radioDoble"
                                                             Content="Doble"
                                                             Style="{StaticResource RadioStyle}"/>
                                                <RadioButton x:Name="radioSencillo"
                                                             Content="Sencillo"
                                                             IsChecked="True"
                                                             Style="{StaticResource RadioStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="0,16,0,0"
                                                Background="{StaticResource SurfaceCard}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="checkPaso"
                                                          Content="Paso"
                                                          Style="{StaticResource CheckStyle}"
                                                          Margin="0,0,26,0"/>
                                                <CheckBox x:Name="checkCortina"
                                                          Content="Cortina"
                                                          Style="{StaticResource CheckStyle}"
                                                          Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceInput}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <Button x:Name="btnSave"
                                Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="btnSave_Click"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnCerrar_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
