<UserControl x:Class="LD.FormsX.Movimientos.MovimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:LD.FormsX.Features.Common"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <Grid Background="#F8FAFC" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <StackPanel Grid.Row="0"
                            Orientation="Vertical">
                    <TextBlock Text="Movimientos"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"/>
                    <TextBlock Text="Consulta de movimientos por filtros"
                               FontSize="13"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Fila 1 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Cliente:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#374151"/>

                    <common:InlineLookupEditor x:Name="lookupCliente"
                                               Grid.Column="1"
                                               Height="38"
                                               Tag="Cliente|Clave"
                                               ItemsSource="{Binding ClientLookupItems}"
                                               DisplayMemberPath="Code"
                                               SearchMemberPaths="Code,Description"
                                               SelectedCode="{Binding SelectedClientText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               SelectedId="{Binding SelectedClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               EditorCornerRadius="10"
                                               EditorPadding="14,6,8,6"
                                               EditorBorderBrush="#D1D5DB"
                                               EditorBorderThickness="1.2"
                                               EditorForeground="#1F2937"
                                               EditorFontSize="13"
                                               GlyphBrush="#94A3B8"
                                               RequireSelectionMatch="True"
                                               MaxResults="12"
                                               OpenDropDownOnLoad="False"
                                               SelectAllTextOnLoad="False"
                                               SelectionConfirmed="LookupCliente_SelectionConfirmed"/>

                    <TextBlock Grid.Column="3"
                               Text="Proyecto:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#374151"/>

                    <common:InlineLookupEditor x:Name="lookupProyecto"
                                               Grid.Column="4"
                                               Height="38"
                                               Tag="Proyecto|Clave"
                                               ItemsSource="{Binding ProjectLookupItems}"
                                               DisplayMemberPath="Code"
                                               SearchMemberPaths="Code,Description"
                                               SelectedCode="{Binding SelectedProjectText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               SelectedId="{Binding SelectedProjectId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               EditorCornerRadius="10"
                                               EditorPadding="14,6,8,6"
                                               EditorBorderBrush="#D1D5DB"
                                               EditorBorderThickness="1.2"
                                               EditorForeground="#1F2937"
                                               EditorFontSize="13"
                                               GlyphBrush="#94A3B8"
                                               RequireSelectionMatch="True"
                                               MaxResults="12"
                                               OpenDropDownOnLoad="False"
                                               SelectAllTextOnLoad="False"
                                               SelectionConfirmed="LookupProyecto_SelectionConfirmed"/>
                </Grid>

                <!-- Fila 2 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Número de Parte:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#374151"/>

                    <TextBox x:Name="txtNumeroParte"
                             Grid.Column="1"
                             Height="38"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             BorderBrush="#D1D5DB"
                             Background="White"
                             TextChanged="Filtro_Changed"/>

                    <TextBlock Grid.Column="3"
                               Text="StandardId:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#374151"/>

                    <TextBox x:Name="txtStandardId"
                             Grid.Column="4"
                             Height="38"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             BorderBrush="#D1D5DB"
                             Background="White"
                             TextChanged="Filtro_Changed"/>
                </Grid>

                <!-- Fila 3 -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Fecha Inicio:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#374151"/>

                    <DatePicker x:Name="dpFechaInicio"
                                Grid.Column="1"
                                Height="38"
                                FontSize="13"
                                SelectedDateFormat="Short"
                                VerticalContentAlignment="Center"
                                BorderBrush="#D1D5DB"
                                Background="White"
                                SelectedDateChanged="FiltroFecha_Changed"/>

                    <TextBlock Grid.Column="3"
                               Text="Fecha Fin:"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="#374151"/>

                    <DatePicker x:Name="dpFechaFin"
                                Grid.Column="4"
                                Height="38"
                                FontSize="13"
                                SelectedDateFormat="Short"
                                VerticalContentAlignment="Center"
                                BorderBrush="#D1D5DB"
                                Background="White"
                                SelectedDateChanged="FiltroFecha_Changed"/>

                   <Button x:Name="btnNuevo"
	                    Grid.Column="6"
	                    Height="38"
	                    Padding="12,0"
	                   
	                    Background="#F3F4F6"
	                    Foreground="#374151"
	                    BorderBrush="#D1D5DB"
	                    BorderThickness="1"
	                    Cursor="Hand"
                        Click="BtnBuscar_Click">

	                    <Button.Resources>
		                    <Style TargetType="Border">
			                    <Setter Property="CornerRadius" Value="6"/>
		                    </Style>
	                    </Button.Resources>

	                    <StackPanel Orientation="Horizontal"
		                    VerticalAlignment="Center"
		                    HorizontalAlignment="Center">

		                    <TextBlock FontFamily="Segoe MDL2 Assets"
		                       Text="&#xE721;"
		                       Foreground="#2563EB"
		                       Margin="0,0,6,0"
		                       FontSize="14"/>

		                    <TextBlock Text="Buscar"/>
	                    </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Grid principal -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtStatus"
                           Grid.Row="0"
                           Text="Sin datos para mostrar"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="4,0,0,8"/>

                <Border Grid.Row="2"
                        BorderBrush="#D9DEE7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <Grid>
                        <DataGrid x:Name="dg"
                                  ItemsSource="{Binding MovementsView}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Vertical"
                              
                                  RowHeight="28"
                                  ColumnHeaderHeight="40"
                                  FontSize="12"
                                  VerticalGridLinesBrush="#D9D9D9"
                                  HorizontalGridLinesBrush="#E4E8EE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="160"/>
                                <DataGridTextColumn Header="Proyecto" Binding="{Binding Proyecto}" Width="160"/>
                                <DataGridTextColumn Header="No. Parte" Binding="{Binding PartNumber}" Width="120"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="180"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd-MM-yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Hora" Binding="{Binding Hora, StringFormat={}{0:hh\\:mm\\:ss}}" Width="90"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding UserId}" Width="120"/>
                                <DataGridTextColumn Header="Documento" Binding="{Binding DocumentId}" Width="100"/>
                                <DataGridTextColumn Header="Tipo de documento" Binding="{Binding DocumentType}" Width="140"/>
                                <DataGridTextColumn Header="Tipo de movimiento" Binding="{Binding MovementType}" Width="140"/>
                                <DataGridTextColumn Header="Lote" Binding="{Binding LotNumber}" Width="110"/>
                                <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="120"/>
                                <DataGridTextColumn Header="Orden compra" Binding="{Binding PurchaseOrder}" Width="120"/>
                                <DataGridTextColumn Header="Pedimento" Binding="{Binding CustomsDeclarationNumber}" Width="120"/>
                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusId}" Width="100"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Qty}" Width="90"/>
                                <DataGridTextColumn Header="StandardId" Binding="{Binding StandardIdStr}" Width="120"/>
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF1F5"/>
                                    <Setter Property="Foreground" Value="#16263D"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>

                        <!-- Loader -->
                        <Border x:Name="LoadingOverlay"
                                Background="#80FFFFFF"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True"
                                             Width="220"
                                             Height="18"/>
                                <TextBlock x:Name="TxtLoading"
                                           Text="Cargando movimientos..."
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#24344D"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
