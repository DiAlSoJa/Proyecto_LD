<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	 <AssemblyName>LD</AssemblyName>
	 <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="X\**" />
    <EmbeddedResource Remove="X\**" />
    <None Remove="X\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LD.Client\LD.Client.csproj" />
    <ProjectReference Include="..\LD.Contracts\LD.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\Dialogs\FrmRoles.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmParametersQuery.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmChooseUser.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmDocumentos.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmNuevoRol.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmNuevoMontacargas.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmNuevoAleatorio.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmVehiculosRegistrados.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmNuevoASNEscaneo.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\FrmNuevoASN.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Forms\FrmReportes.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Forms\FrmControlPatio.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Forms\FrmCatalogos.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Forms\FrmCheckListMontacargas.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\Forms\FrmASN.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

</Project>