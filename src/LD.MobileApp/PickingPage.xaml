<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppLogin.PickingPage"
             Title="Lista de Surtido"
             BackgroundColor="#1F3A5F">


    <Grid RowDefinitions="Auto,*" Padding="16">
 
        <!-- Barra superior: filtro -->
        <Border Grid.Row="0"
              BackgroundColor="#F6F8FC"
              Stroke="#E2E8F0"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 24"
              Padding="14"
              Margin="0,10,0,12">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔎"
                     FontSize="18"
                     VerticalOptions="Center"/>

                <Entry x:Name="FiltroEntry"
                     Grid.Column="1"
                     Placeholder="Filtrar..."
                     TextChanged="OnFiltroChanged"
                     BackgroundColor="White"
                     TextColor="#1E293B"
                     PlaceholderColor="#94A3B8"
                     ClearButtonVisibility="WhileEditing"/>
            </Grid>
        </Border>
        <!-- CARD PRINCIPAL -->
        <Border Grid.Row="1" BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 25"
                    Padding="10">

                <VerticalStackLayout Spacing="10">

                   
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="15"
                                  BackgroundColor="#F8FAFC">

                                <Label Text="[1]"
                                       FontSize="20"
                                      TextColor="#FF0000"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                

                                <Label Grid.Column="1"
                                       Text="Folio: 1000060"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"
                                       VerticalOptions="Center"
                                        FontSize="18"
                                       Padding="10"/>

                                <Label Grid.Column="2"
                                       Text="⌄"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <!-- Fila: Surtido 1-->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid Padding="14,12"
                                       ColumnDefinitions="Auto,Auto,*"
                                       RowDefinitions="Auto,Auto">
                                        
                                        <!-- Título -->
                                        <Label Grid.Column="1"
                                            Text="202001012003 - G21A"
                                            FontAttributes="Bold"
                                            FontSize="20"
                                            TextColor="#1E293B"
                                            Margin="10,0,0,0"
                                            LineBreakMode="TailTruncation"/>
                                        <!-- Subtítulo -->
                                        <Label Grid.Row="1"
                                            Grid.Column="1"
                                            Text="03-03-2026 11:00 am"
                                            FontSize="12"
                                            TextColor="#64748B"
                                            Margin="10,2,0,0"
                                            LineBreakMode="TailTruncation"/>

                                    <Label Grid.Row="1"
                                         Grid.Column="2"
                                         Text="JABIL B2"
                                         FontSize="12"
                                         TextColor="#64748B"
                                         Margin="10,2,0,0"
                                         LineBreakMode="TailTruncation"/>
                                </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPickedClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                    
                    
                    <!-- Segundo ASN -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="15"
                                  BackgroundColor="#F8FAFC">

                                <Label Text="[3]"
                                   FontSize="20"
                                  TextColor="#FF0000"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>


                                <Label Grid.Column="1"
                                   Text="Folio: 1000061"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center"
                                    FontSize="18"
                                   Padding="10"/>

                                <Label Grid.Column="2"
                                   Text="⌄"
                                   TextColor="#64748B"
                                   VerticalOptions="Center"/>
                            </Grid>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <!-- Fila: Surtido 1-->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid Padding="14,12"
                                           ColumnDefinitions="Auto,Auto,*"
                                           RowDefinitions="Auto,Auto">

                                        <!-- Título -->
                                        <Label Grid.Column="1"
                                            Text="20200101255 - D01L"
                                            FontAttributes="Bold"
                                            FontSize="20"
                                            TextColor="#1E293B"
                                            Margin="10,0,0,0"
                                            LineBreakMode="TailTruncation"/>
                                        <!-- Subtítulo -->
                                        <Label Grid.Row="1"
                                            Grid.Column="1"
                                            Text="03-03-2026 11:00 am"
                                            FontSize="12"
                                            TextColor="#64748B"
                                            Margin="10,2,0,0"
                                            LineBreakMode="TailTruncation"/>
                                        <Label Grid.Row="1"
                                          Grid.Column="2"
                                          Text="JABIL B2"
                                          FontSize="12"
                                          TextColor="#64748B"
                                          Margin="10,2,0,0"
                                          LineBreakMode="TailTruncation"/>

                                </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPickedClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>



                                <!-- Fila: Surtido 1-->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid Padding="14,12"
                                        ColumnDefinitions="Auto,Auto,*"
                                        RowDefinitions="Auto,Auto">

                                        <!-- Título -->
                                        <Label Grid.Column="1"
                                             Text="20200155500 - J60E"
                                             FontAttributes="Bold"
                                             FontSize="20"
                                             TextColor="#1E293B"
                                             Margin="10,0,0,0"
                                             LineBreakMode="TailTruncation"/>
                                                                        <!-- Subtítulo -->
                                        <Label Grid.Row="1"
                                             Grid.Column="1"
                                             Text="03-03-2026 11:00 am"
                                             FontSize="12"
                                             TextColor="#64748B"
                                             Margin="10,2,0,0"
                                             LineBreakMode="TailTruncation"/>
                                    <Label Grid.Row="1"
                                           Grid.Column="2"
                                           Text="JABIL B2"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           Margin="10,2,0,0"
                                           LineBreakMode="TailTruncation"/>

                                </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPickedClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>





                                <!-- Fila: Surtido 1-->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid Padding="14,12"
                                        ColumnDefinitions="Auto,Auto,*"
                                        RowDefinitions="Auto,Auto">

                                        <!-- Título -->
                                        <Label Grid.Column="1"
                                             Text="20200185888 - ZD38A"
                                             FontAttributes="Bold"
                                             FontSize="20"
                                             TextColor="#1E293B"
                                             Margin="10,0,0,0"
                                             LineBreakMode="TailTruncation"/>
                                                                        <!-- Subtítulo -->
                                        <Label Grid.Row="1"
                                         Grid.Column="1"
                                         Text="03-03-2026 11:00 am"
                                         FontSize="12"
                                         TextColor="#64748B"
                                         Margin="10,2,0,0"
                                         LineBreakMode="TailTruncation"/>
                                    <Label Grid.Row="1"
                                       Grid.Column="2"
                                       Text="JABIL B2"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       Margin="10,2,0,0"
                                       LineBreakMode="TailTruncation"/>

                                </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPickedClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>

                                
                                
                                
                                
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
                    
                    





                </VerticalStackLayout>
            </Border>

    </Grid>
</ContentPage> 