<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppLogin.RegisterVehicule"
    Title="Licencia"
    BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Card superior con datos -->
        <Border Grid.Row="0"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="18"
                Margin="0,10,0,12">
            
            

            <VerticalStackLayout Spacing="12">

                <!-- Tipo -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tipo:"
                           TextColor="#64748B"
                           FontSize="14"/>

                    <HorizontalStackLayout Spacing="10">

                        <!-- Caja -->
                        <Border x:Name="CajaOption"
                                StrokeThickness="0"
                                BackgroundColor="#E5E7EB"
                                StrokeShape="RoundRectangle 25"
                                Padding="18,10">

                            <Label Text="Caja"
                               TextColor="#1E293B"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCajaTapped"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Tractor -->
                        <Border x:Name="TractorOption"
                            StrokeThickness="0"
                            BackgroundColor="#E5E7EB"
                            StrokeShape="RoundRectangle 25"
                            Padding="18,10">

                            <Label Text="Tractor"
                                   TextColor="#1E293B"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTractorTapped"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>
                </VerticalStackLayout>
                
                

                <VerticalStackLayout Spacing="6">
                    <Label Text="Linea:"
                 TextColor="#64748B"
                 FontSize="14"/>
                    <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="12,8">
                        <Entry Placeholder="Seleccione la linea"
                                   Keyboard="Text"
                                   TextColor="#1E293B"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Origen:"
                               TextColor="#64748B"
                               FontSize="14"/>
                    <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="12,8">
                        <Entry Placeholder="Ej. GDL"
                                   Keyboard="Text"
                                   TextColor="#1E293B"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Número:"
                               TextColor="#64748B"
                               FontSize="14"/>
                    <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="12,8">
                        <Entry Placeholder="Ej. XS225"
                                   Keyboard="Text"
                                   TextColor="#1E293B"/>
                    </Border>
                </VerticalStackLayout>
                <!-- Placa -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Placa:"
                               TextColor="#64748B"
                               FontSize="14"/>
                    <Border Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="12,8">
                        <Entry Placeholder="Ej. 123-ABC"
                                   Keyboard="Text"
                                   TextColor="#1E293B"/>
                    </Border>
                </VerticalStackLayout>


             

                <!-- Miniaturas -->
                <Border BackgroundColor="#EEF3FB"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 18"
                        Padding="10"
                        Margin="0,6,0,0">
                    <HorizontalStackLayout Spacing="10">
                        <Image x:Name="Thumb1" WidthRequest="90" HeightRequest="56" Aspect="AspectFill" BackgroundColor="White"/>
                        <Image x:Name="Thumb2" WidthRequest="90" HeightRequest="56" Aspect="AspectFill" BackgroundColor="White"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- Area tipo cámara -->
        <Border Grid.Row="1"
                BackgroundColor="#1B2A3A"
                Stroke="#0B1B2A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26"
                Padding="10">

            <Grid RowDefinitions="*,Auto" RowSpacing="12">

                <!-- Preview -->
                <Grid>
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeShape="RoundRectangle 22"
                            Padding="10">

                        <Grid>
                            <Image x:Name="PreviewImage" Aspect="AspectFit" />
                            <!-- Retícula / marco -->
                            <Grid Padding="14">
                                <Border Stroke="#FFFFFF"
                                        StrokeThickness="3"
                                        StrokeShape="RoundRectangle 24"
                                        BackgroundColor="Transparent"
                                        Opacity="0.35"/>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>

                <!-- Controles inferiores (Cancelar / Capturar) -->
                <Grid Row="1" ColumnDefinitions="*,Auto,*" Padding="6,0">
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#102A43"
                            Stroke="#FFFFFF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 999"
                            WidthRequest="86"
                            HeightRequest="86"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Padding="10">
                        <Button Text=""
                                Clicked="OnCapturarClicked"
                                BackgroundColor="White"
                                CornerRadius="999"
                                WidthRequest="60"
                                HeightRequest="60"/>
                    </Border>

                    <Button Grid.Column="2"
                            Text="Capturar"
                            Clicked="OnCapturarClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"
                            HorizontalOptions="End"/>
                </Grid>

            </Grid>
        </Border>



        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,14,0,6">

            <Button Text="Atrás"
                Clicked="OnAtrasClicked"
                HeightRequest="56"
                CornerRadius="18"
                BackgroundColor="#E5E7EB"
                TextColor="#1E293B"
                FontAttributes="Bold"
                FontSize="18"/>

            <Button Grid.Column="1"
                Text="Siguiente"
                Clicked="OnSiguienteClicked"
                HeightRequest="56"
                CornerRadius="18"
                BackgroundColor="#244A7C"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"/>
        </Grid>

    </Grid>
</ContentPage>