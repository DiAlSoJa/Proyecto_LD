<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppLogin.DashboardPage"
             Title="DashboardPage"
             BackgroundColor="#1F3A5F">

    <ScrollView>
        <VerticalStackLayout Padding="20,60,20,30"
                             Spacing="20"
                             Background="#F4F6F9">

            <!-- HEADER -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  BackgroundColor="#1F3A5F"
                  Padding="15"
                  Margin="-20,-60,-20,0">

                <Label Grid.Column="1"
                       Text="juanm.parvol"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <Border Grid.Column="2"
                        BackgroundColor="#2F5DA8"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        Padding="10,5"
                        VerticalOptions="Center">

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="🔔" TextColor="White"/>
                        <Label Text="Tareas (6)"
                               TextColor="White"
                               FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTaskListClicked"/>
                    </Border.GestureRecognizers>
                </Border>
                
                
            </Grid>

            <!-- CARD PRINCIPAL -->
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 25"
                    Padding="10">

                <VerticalStackLayout Spacing="10">

                    <!-- =========================
                         ALMACENISTA
                         ========================= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="15"
                                  BackgroundColor="#F8FAFC">

                                <Label Text="📦"
                                       FontSize="18"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="Almacenista"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"
                                       VerticalOptions="Center"
                                       Padding="10"/>

                                <Label Grid.Column="2"
                                       Text="⌄"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <!-- Fila: Cambio de ubicación -->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📍" FontSize="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Cambio de ubicación"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCambioUbicacionClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                <!-- Fila: Surtir mercancía -->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📦" FontSize="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Surtir Mercancía"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUbicacionPasoSurtidoClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                <!-- Fila: Recibir mercancía y ubicar -->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📥" FontSize="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="ASN Por Ubicar"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAsnPorUbicarClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                            
                                <!-- Task Manager dentro de Almacenista -->
                                <toolkit:Expander Margin="0,8,0,0">
                                    <toolkit:Expander.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              Padding="15"
                                              BackgroundColor="#F8FAFC">

                                            <Label Text="🕒"
                                                   FontSize="18"
                                                   VerticalOptions="Center"/>

                                            <Label Grid.Column="1"
                                                   Text="Task Manager"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E293B"
                                                   VerticalOptions="Center"
                                                   Padding="10,0"/>

                                            <Label Grid.Column="2"
                                                   Text="⌄"
                                                   TextColor="#64748B"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </toolkit:Expander.Header>

                                    <toolkit:Expander.Content>
                                        <VerticalStackLayout Padding="8,6" Spacing="0" BackgroundColor="White">

                                           
                                            <!-- TAREA 1 (VENCIDA) -->
                                            <Border Stroke="Transparent" BackgroundColor="White">

                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="!" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación A012 y tomar el pallet 2027020100001 y dejarlo en AX025"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#B91C1C"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaskManagerClicked"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                            <!-- TAREA 2 -->
                                            <Border Stroke="Transparent" BackgroundColor="White">

                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación A014 y tomar el pallet 2027020100004 y dejarlo en AX028"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#334155"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaskManagerClicked"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>
                                            
                                           

                                            <!-- TAREA 3 -->

                                            <Border Stroke="Transparent" BackgroundColor="White">

                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación B010 y tomar el pallet 2027020100007 y dejarlo en AX010"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#334155"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaskManagerClicked"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>
                                            
                                         
                                            <!-- TAREA 4 -->

                                            <Border Stroke="Transparent" BackgroundColor="White">

                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación C003 y tomar el pallet 2027020100012 y dejarlo en AX005"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#334155"
                                                         FontSize="15"/>
                                              </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaskManagerClicked"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>
                                            
                                           

                                        </VerticalStackLayout>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>

                    <!-- =========================
                         SEGURIDAD
                         ========================= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Padding="15"
                                  BackgroundColor="#F8FAFC">

                                <Label Text="👮‍♂️"
                                       FontSize="18"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="Seguridad"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"
                                       VerticalOptions="Center"
                                       Padding="10"/>

                                <Label Grid.Column="2"
                                       Text="⌄"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <!-- Fila: Registrar vehículo -->
                                <Border Stroke="Transparent" BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="🚗" FontSize="16" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Registrar Vehículo"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCasetaClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                <!-- Task Manager dentro de Seguridad -->
                                <toolkit:Expander Margin="0,0,0,0">
                                    <toolkit:Expander.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              Padding="15"
                                              BackgroundColor="#F8FAFC">

                                            <Label Text="🕒"
                                                   FontSize="18"
                                                   VerticalOptions="Center"/>

                                            <Label Grid.Column="1"
                                                   Text="Task Manager"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E293B"
                                                   VerticalOptions="Center"
                                                   Padding="10,0"/>

                                            <Label Grid.Column="2"
                                                   Text="⌄"
                                                   TextColor="#64748B"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </toolkit:Expander.Header>

                                    <toolkit:Expander.Content>
                                        <VerticalStackLayout Padding="8,6" Spacing="0" BackgroundColor="White">

                                            <!-- TAREA 1 (VENCIDA) -->
                                            <Border Stroke="Transparent" BackgroundColor="White">

                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="!" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                           Text="27 feb 08:50 am - Abrir Cortina 5"
                                                           Margin="10,0,0,0"
                                                           VerticalOptions="Center"
                                                           TextColor="#B91C1C"
                                                           FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaskManagerSecurityClicked"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                            <Border Stroke="Transparent" BackgroundColor="White">

                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                       Text="27 feb 09:00 am - Cerrar Cortina 6"
                                                       Margin="10,0,0,0"
                                                       VerticalOptions="Center"
                                                       TextColor="#334155"
                                                       FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTaskManagerClicked"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>
                                            
                                            
                                            

                                        </VerticalStackLayout>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>

                    <!-- =========================
                         CONSULTAS
                         ========================= -->
                    <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                        <Border Stroke="Transparent"
                            BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="15"
                              BackgroundColor="#F8FAFC">

                                <Label Text="🔍"
                                        FontSize="18"
                                        VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="Consultas"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"
                                       VerticalOptions="Center"
                                       Padding="10"/>

                                <Label Grid.Column="2"
                                       Text=">"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMovementClicked"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </VerticalStackLayout>



                    <!-- =========================
                          REPORTE DE DAÑOS
                          ========================= -->
                    <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                        <Border Stroke="Transparent"
                                BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                               Padding="15"
                               BackgroundColor="#F8FAFC">

                                <Label Text="📸"
                                 FontSize="18"
                                 VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                    Text="Reporte de Daños"
                                    FontAttributes="Bold"
                                    TextColor="#1E293B"
                                    VerticalOptions="Center"
                                    Padding="10"/>

                                <Label Grid.Column="2"
                                    Text=">"
                                    TextColor="#64748B"
                                    VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRDClicked"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>


                    <!-- =========================
                           OPERACIONES
                           ========================= -->
                    <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                        <Border Stroke="Transparent"
                                BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                Padding="15"
                                BackgroundColor="#F8FAFC">

                                <Label Text="🚚"
                                  FontSize="18"
                                  VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                     Text="Operaciones"
                                     FontAttributes="Bold"
                                     TextColor="#1E293B"
                                     VerticalOptions="Center"
                                     Padding="10"/>

                                <Label Grid.Column="2"
                                     Text=">"
                                     TextColor="#64748B"
                                     VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAuditClicked"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>








                    <!-- =========================
                        INVENTARIOS
                        ========================= -->
                    <toolkit:Expander>
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                 Padding="15"
                                 BackgroundColor="#F8FAFC">

                                <Label Text="🔀"
                                  FontSize="18"
                                  VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                      Text="Inventario"
                                      FontAttributes="Bold"
                                      TextColor="#1E293B"
                                      VerticalOptions="Center"
                                      Padding="10"/>

                                <Label Grid.Column="2"
                                  Text="⌄"
                                  TextColor="#64748B"
                                  VerticalOptions="Center"/>
                            </Grid>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <Border Stroke="Transparent"
                                        BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*"
                                            Padding="20,14">

                                        <Label Text="🔍"
                                          FontSize="16"
                                          VerticalOptions="Center"/>

                                        <Label Grid.Column="1"
                                           Text="Auditar"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center"
                                           TextColor="#1E293B"
                                           FontSize="15"/>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAuditClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border Stroke="Transparent"
                                        BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*"
                                            Padding="20,14">

                                        <Label Text="📋"
                                          FontSize="16"
                                          VerticalOptions="Center"/>

                                        <Label Grid.Column="1"
                                           Text="Listado"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center"
                                           TextColor="#1E293B"
                                           FontSize="15"/>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnInventoryListClicked"/>
                                    </Border.GestureRecognizers>
                                </Border>

                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>

                    <!-- =========================
                            CHECLIST DE MONTACARGAS
                            ========================= -->
                    <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                        <Border Stroke="Transparent"
                                BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                 Padding="15"
                                 BackgroundColor="#F8FAFC">

                                <Label Text="🚚"
                                   FontSize="18"
                                   VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                      Text="Checklist de Montacargas"
                                      FontAttributes="Bold"
                                      TextColor="#1E293B"
                                      VerticalOptions="Center"
                                      Padding="10"/>

                                <Label Grid.Column="2"
                                  Text=">"
                                  TextColor="#64748B"
                                  VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChecklistClicked"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>




                </VerticalStackLayout>
            </Border>

            <!-- BANNER -->
            <Button Text="Cerrar sesión" Command="{Binding Logout}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage> 