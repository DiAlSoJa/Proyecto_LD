<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppLogin.PickingPage"
             Title="Lista de Surtido"
             BackgroundColor="#1F3A5F">

    <Grid RowDefinitions="Auto,*" Padding="16">

        <!-- Filtro -->
        <Border Grid.Row="0"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14"
                Margin="0,10,0,12">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="🔎"
                       FontSize="18"
                       VerticalOptions="Center" />

                <Entry x:Name="FiltroEntry"
                       Grid.Column="1"
                       Placeholder="Filtrar..."
                       TextChanged="OnFiltroChanged"
                       BackgroundColor="Transparent"
                       TextColor="#1E293B"
                       PlaceholderColor="#94A3B8"
                       ClearButtonVisibility="WhileEditing" />
            </Grid>
        </Border>

        <!-- Contenedor principal -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 25"
                Padding="10">

            <CollectionView x:Name="PickingCollection"
                            SelectionMode="None"
                            ItemsLayout="VerticalList">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <toolkit:Expander>
                            <toolkit:Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Padding="15"
                                      BackgroundColor="#F8FAFC"
                                      Margin="0,0,0,8">

                                    <Label Text="{Binding Cantidad, StringFormat='[{0}]'}"
                                           FontSize="20"
                                           TextColor="#FF0000"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1"
                                           Text="{Binding Folio, StringFormat='Folio: {0}'}"
                                           FontAttributes="Bold"
                                           TextColor="#1E293B"
                                           VerticalOptions="Center"
                                           FontSize="18"
                                           Padding="10,0" />

                                    <Label Grid.Column="2"
                                           Text="⌄"
                                           TextColor="#64748B"
                                           VerticalOptions="Center" />
                                </Grid>
                            </toolkit:Expander.Header>

                            <toolkit:Expander.Content>
                                <CollectionView ItemsSource="{Binding Detalles}"
                                                SelectionMode="None">

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="0">

                                                <Border Stroke="Transparent"
                                                        BackgroundColor="White"
                                                        Padding="0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            CommandParameter="{Binding .}"
                                                            Tapped="OnPickedClicked" />
                                                    </Border.GestureRecognizers>

                                                    <Grid Padding="14,12"
                                                          ColumnDefinitions="*,Auto"
                                                          RowDefinitions="Auto,Auto">

                                                        <Label Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{Binding Pedido}"
                                                               FontAttributes="Bold"
                                                               FontSize="18"
                                                               TextColor="#1E293B"
                                                               LineBreakMode="TailTruncation" />

                                                        <Label Grid.Row="1"
                                                               Grid.Column="0"
                                                               Text="{Binding Fecha, StringFormat='{0:dd-MM-yyyy hh:mm tt}'}"
                                                               FontSize="12"
                                                               TextColor="#64748B" />

                                                        <Label Grid.Row="1"
                                                               Grid.Column="1"
                                                               Text="{Binding Ubicacion}"
                                                               FontSize="12"
                                                               TextColor="#64748B"
                                                               HorizontalTextAlignment="End" />
                                                    </Grid>
                                                </Border>

                                                <BoxView HeightRequest="1"
                                                         BackgroundColor="#EEF2F7" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </toolkit:Expander.Content>
                        </toolkit:Expander>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>