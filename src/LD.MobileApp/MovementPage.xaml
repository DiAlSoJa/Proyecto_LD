<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppLogin.MovementPage"
    Title="Cambio de Ubicación"
    BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Card superior con datos -->
        <Border Grid.Row="0"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="18"
                Margin="0,10,0,12">

            <VerticalStackLayout Spacing="12">

               
                <VerticalStackLayout Spacing="6">
                    <Label Text="Standar ID" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Entry x:Name="EstandarIdEntry"  Keyboard="Numeric"  Placeholder="" TextColor="#0F172A"/>
                    </Border>
                </VerticalStackLayout>
               
            </VerticalStackLayout>
        </Border>

        <!-- Area tipo cámara -->
        <Border Grid.Row="1"
                BackgroundColor="#1B2A3A"
                Stroke="#0B1B2A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26"
                Padding="10">

            <Grid RowDefinitions="*,Auto" RowSpacing="12">

                <!-- Preview -->
                <Grid>
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeShape="RoundRectangle 22"
                            Padding="10">

                        <Grid>
                            <Image x:Name="PreviewImage" Aspect="AspectFit" />
                            <!-- Retícula / marco -->
                            <Grid Padding="14">
                                <Border Stroke="#FFFFFF"
                                        StrokeThickness="3"
                                        StrokeShape="RoundRectangle 24"
                                        BackgroundColor="Transparent"
                                        Opacity="0.35"/>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>

                <!-- Controles inferiores (Cancelar / Capturar) -->
                <Grid Row="1" ColumnDefinitions="*,Auto,*" Padding="6,0">
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#102A43"
                            Stroke="#FFFFFF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 999"
                            WidthRequest="86"
                            HeightRequest="86"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Padding="10">
                        <Button Text=""
                                Clicked="OnCapturarClicked"
                                BackgroundColor="White"
                                CornerRadius="999"
                                WidthRequest="60"
                                HeightRequest="60"/>
                    </Border>

                    <Button Grid.Column="2"
                            Text="Capturar"
                            Clicked="OnCapturarClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"
                            HorizontalOptions="End"/>
                </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="2"
        ColumnDefinitions="*,*"
        ColumnSpacing="12"
        Margin="0,14,0,6">

            <Button Text="Atrás"
          Clicked="OnAtrasClicked"
          HeightRequest="56"
          CornerRadius="18"
          BackgroundColor="#E5E7EB"
          TextColor="#1E293B"
          FontAttributes="Bold"
          FontSize="18"/>

            <Button Grid.Column="1"
          Text="Siguiente"
          Clicked="OnSiguienteClicked"
          HeightRequest="56"
          CornerRadius="18"
          BackgroundColor="#244A7C"
          TextColor="White"
          FontAttributes="Bold"
          FontSize="18"/>
        </Grid>

    </Grid>
</ContentPage>