<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppLogin.DamageReportDetailPage"
    Title="Licencia"
    BackgroundColor="#0F2E4F">
    <ScrollView>
    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Card superior con datos -->
        <Border Grid.Row="0"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="18"
                Margin="0,10,0,12">
        
            <VerticalStackLayout Spacing="12">
                <Border BackgroundColor="#102A43"
                       StrokeThickness="0"
                       StrokeShape="RoundRectangle 16"
                       Padding="12,8">               
                    <Label x:Name="HintLabel"
                          Text="Estandar ID: 20260201000001"
                          TextColor="White"
                          FontSize="15"/>
                </Border>


                <VerticalStackLayout Spacing="6">
                    <Label Text="Número de Parte: LX522250 -S2DS22DS2" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Ubicación: A00253" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Status: A" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Cantidad Recibida: 52" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Almacén: B1" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Proyecto: JABIL" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Cliente: JABIL" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Descripción: SP-1-0225-2201" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="ASN: ASN5522255" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Fecha de Recepción: 01-01-2026" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Disponible: 20" TextColor="#64748B" FontSize="14"/>                    
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Estado: OK" TextColor="#64748B" FontSize="14"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="120,*"
                      RowSpacing="14"
                      ColumnSpacing="12">

                    <!-- Fila 2 -->
                    <Label Text="Tipo de Daño:"
                       Grid.Row="1"
                       Grid.Column="0"
                       VerticalOptions="Center"
                       TextColor="#64748B"
                       FontSize="14"/>

                    <Border Grid.Row="1"
                        Grid.Column="1"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="White"
                        Padding="12,4">

                        <Picker x:Name="EstadoPicker"
                            Title="Selecciona"
                            TextColor="#1E293B">

                            <Picker.Items>
                                <x:String>Sin Daño</x:String>
                                <x:String>Empaque Dañado</x:String>
                                <x:String>Tarima Dañada</x:String>
                                <x:String>Material con Daño</x:String>
                                <x:String>Material Mojado</x:String>
                                <x:String>Material Contaminado</x:String>                                
                            </Picker.Items>

                        </Picker>

                    </Border>

                </Grid>



                <Grid ColumnDefinitions="120,*"
                   RowSpacing="14"
                   ColumnSpacing="12">

                    <!-- Fila 2 -->
                    <Label Text="Categoría:"
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalOptions="Center"
                        TextColor="#64748B"
                        FontSize="14"/>

                    <Border Grid.Row="1"
                         Grid.Column="1"
                         Stroke="#E2E8F0"
                         StrokeThickness="1"
                         StrokeShape="RoundRectangle 12"
                         BackgroundColor="White"
                         Padding="12,4">

                        <Picker x:Name="EstadoPickewr"
                             Title="Selecciona"
                             TextColor="#1E293B">

                            <Picker.Items>
                                <x:String>Bajo</x:String>
                                <x:String>Medio</x:String>
                                <x:String>Alto</x:String>
                                <x:String>Muy Alto</x:String>
                            </Picker.Items>

                        </Picker>

                    </Border>

                </Grid>



                <Grid ColumnDefinitions="120,*"
                    RowSpacing="14"
                    ColumnSpacing="12">

                    <!-- Fila 2 -->
                    <Label Text="Nuevo Estatus:"
                         Grid.Row="1"
                         Grid.Column="0"
                         VerticalOptions="Center"
                         TextColor="#64748B"
                         FontSize="14"/>

                    <Border Grid.Row="1"
                          Grid.Column="1"
                          Stroke="#E2E8F0"
                          StrokeThickness="1"
                          StrokeShape="RoundRectangle 12"
                          BackgroundColor="White"
                          Padding="12,4">

                        <Picker x:Name="EstadoPickewsr"
                              Title="Selecciona"
                              TextColor="#1E293B">

                            <Picker.Items>
                                <x:String>Bajo</x:String>
                                <x:String>Medio</x:String>
                                <x:String>Alto</x:String>
                                <x:String>Muy Alto</x:String>
                            </Picker.Items>

                        </Picker>

                    </Border>

                </Grid>
                
                
                
                




                <VerticalStackLayout Spacing="6">
                    <Label Text="Comentarios:" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Editor x:Name="LicenciaEntry"  HeightRequest="100" TextColor="#0F172A"/>
                    </Border>
                </VerticalStackLayout>

               

                <!-- Miniaturas -->
                <Border BackgroundColor="#EEF3FB"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 18"
                        Padding="10"
                        Margin="0,6,0,0">
                    <HorizontalStackLayout Spacing="10">
                        <Image x:Name="Thumb1" WidthRequest="90" HeightRequest="56" Aspect="AspectFill" BackgroundColor="White"/>
                        <Image x:Name="Thumb2" WidthRequest="90" HeightRequest="56" Aspect="AspectFill" BackgroundColor="White"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- Area tipo cámara -->
        <Border Grid.Row="1"
                BackgroundColor="#1B2A3A"
                Stroke="#0B1B2A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26"
                Padding="10">

            <Grid RowDefinitions="*,Auto" RowSpacing="12">

                <!-- Preview -->
                <Grid>
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeShape="RoundRectangle 22"
                            Padding="10">

                        <Grid>
                            <Image x:Name="PreviewImage" Aspect="AspectFit" />
                            <!-- Retícula / marco -->
                            <Grid Padding="14">
                                <Border Stroke="#FFFFFF"
                                        StrokeThickness="3"
                                        StrokeShape="RoundRectangle 24"
                                        BackgroundColor="Transparent"
                                        Opacity="0.35"/>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>

                <!-- Controles inferiores (Cancelar / Capturar) -->
                <Grid Row="1" ColumnDefinitions="*,Auto,*" Padding="6,0">
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"/>

                    <Border Grid.Column="1"
                            BackgroundColor="#102A43"
                            Stroke="#FFFFFF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 999"
                            WidthRequest="86"
                            HeightRequest="86"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Padding="10">
                        <Button Text=""
                                Clicked="OnCapturarClicked"
                                BackgroundColor="White"
                                CornerRadius="999"
                                WidthRequest="60"
                                HeightRequest="60"/>
                    </Border>

                    <Button Grid.Column="2"
                            Text="Capturar"
                            Clicked="OnCapturarClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="18"
                            HorizontalOptions="End"/>
                </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="2"
        ColumnDefinitions="*"
        ColumnSpacing="12"
        Margin="0,14,0,6">

        

            <Button Grid.Column="1"
          Text="Guardar"
          Clicked="OnSiguienteClicked"
          HeightRequest="56"
          CornerRadius="18"
          BackgroundColor="#244A7C"
          TextColor="White"
          FontAttributes="Bold"
          FontSize="18"/>
        </Grid>

    </Grid>
    </ScrollView>
</ContentPage>