<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppLogin.InventoryList"
             Title="Inventario"
             BackgroundColor="#1F3A5F">

    <Grid Padding="16">

        <Border BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 28"
                Padding="12"
                Margin="0,10,0,0">

            <VerticalStackLayout Spacing="12">

                <!-- Tabs -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                    <Border x:Name="TabPrimera"
                            Grid.Column="0"
                            BackgroundColor="#1F3A5F"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrimeraTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout x:Name="LayoutPrimera"
                                               HorizontalOptions="Center"
                                               Spacing="6">
                            <Label x:Name="LblPrimeraText"
                                   Text="1ra Toma"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label x:Name="LblCountPrimera"
                                   Text="0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border x:Name="TabSegunda"
                            Grid.Column="1"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSegundaTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout x:Name="LayoutSegunda"
                                               HorizontalOptions="Center"
                                               Spacing="6">
                            <Label x:Name="LblSegundaText"
                                   Text="2da Toma"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                            <Label x:Name="LblCountSegunda"
                                   Text="0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border x:Name="TabTercera"
                            Grid.Column="2"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTerceraTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout x:Name="LayoutTercera"
                                               HorizontalOptions="Center"
                                               Spacing="6">
                            <Label x:Name="LblTerceraText"
                                   Text="3ra Toma"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                            <Label x:Name="LblCountTercera"
                                   Text="0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                        </HorizontalStackLayout>
                    </Border>

                </Grid>

                <!-- Interior -->
                <Border BackgroundColor="#F8FAFC"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="10"
                        VerticalOptions="FillAndExpand">

                    <CollectionView x:Name="InventoryCollection"
                                    SelectionMode="None"
                                    VerticalOptions="FillAndExpand">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="6">
                                <Label Text="📦"
                                       FontSize="40"
                                       HorizontalOptions="Center"/>
                                <Label Text="No hay registros"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#334155"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <toolkit:Expander>
                                    <toolkit:Expander.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              Padding="15"
                                              BackgroundColor="#F1F5F9"
                                              Margin="0,0,0,8">

                                            <Label Text="{Binding Cantidad, StringFormat='{0}'}"
                                                   FontSize="20"
                                                   TextColor="#FF0000"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Folio, StringFormat='Folio: {0}'}"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E293B"
                                                   VerticalOptions="Center"
                                                   FontSize="18"
                                                   Padding="10,0,0,0"/>

                                            <Label Grid.Column="2"
                                                   Text="˅"
                                                   TextColor="#94A3B8"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </toolkit:Expander.Header>

                                    <toolkit:Expander.Content>
                                        <VerticalStackLayout Padding="0"
                                                             Spacing="0"
                                                             BackgroundColor="White"
                                                             Margin="0,0,0,10">

                                            <BindableLayout.ItemsSource>
                                                <Binding Path="Detalles"/>
                                            </BindableLayout.ItemsSource>

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <VerticalStackLayout Spacing="0">

                                                        <Border Stroke="Transparent"
                                                                BackgroundColor="White">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Tapped="OnDetailTapped"
                                                                    CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>

                                                            <Grid Padding="14,12" 
                                                                  BackgroundColor="{Binding Color}"
                                                                  ColumnDefinitions="*,Auto"
                                                                  RowDefinitions="Auto,Auto">

                                                                <Label Grid.Row="0"
                                                                       Grid.Column="0"
                                                                       Text="{Binding Pedido}"
                                                                       FontAttributes="Bold"
                                                                       FontSize="20"
                                                                       TextColor="#1E293B"
                                                                       LineBreakMode="TailTruncation"/>

                                                                <Label Grid.Row="1"
                                                                       Grid.Column="0"
                                                                       Text="{Binding Fecha, StringFormat='{0:dd-MM-yyyy hh:mm tt}'}"
                                                                       FontSize="12"
                                                                       TextColor="#94A3B8"/>

                                                                <Label Grid.Row="1"
                                                                       Grid.Column="1"
                                                                       Text="{Binding Ubicacion}"
                                                                       FontSize="12"
                                                                       TextColor="#94A3B8"
                                                                       HorizontalTextAlignment="End"/>
                                                            </Grid>
                                                        </Border>

                                                        <BoxView HeightRequest="1"
                                                                 BackgroundColor="#E2E8F0"
                                                                 Margin="0,0,0,6"/>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>