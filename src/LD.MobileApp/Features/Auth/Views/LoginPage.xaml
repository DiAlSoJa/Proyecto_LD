<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1F3A5F">

    <!-- Grid externo: separa el loader del card con elevation de Android -->
    <Grid>

        <Grid RowDefinitions="300,*">

            <!-- HEADER -->
            <Grid BackgroundColor="#1F3A5F"
                  Padding="30,60,30,40">
                <VerticalStackLayout Spacing="10">
                    <Image Source="logo.png"
                           HeightRequest="150"
                           Aspect="AspectFit"
                           HorizontalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowIpConfigCommand}" NumberOfTapsRequired="1"/>
                        </Image.GestureRecognizers>
                    </Image>
                </VerticalStackLayout>
            </Grid>

            <!-- CARD — sin márgenes laterales; padding interno provee la separación visual -->
            <Border Grid.Row="1"
                    Margin="0,-60,0,0"
                    BackgroundColor="White"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    Padding="25">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="35,35,0,0"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,4"
                            Radius="16"
                            Opacity="0.15"/>
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout Spacing="20">

                        <!-- Título -->
                        <Label Text="Iniciar Sesión"
                               FontAttributes="Bold"
                               FontSize="24"
                               TextColor="#1F3A5F"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- Username -->
                        <controls:LabeledEntry
                            LabelText="Usuario"
                            Placeholder="Ingresa tu usuario"
                            Text="{Binding Username}"
                            IconSource="user.png"/>

                        <!-- Password -->
                        <controls:PasswordEntry
                            LabelText="Contraseña"
                            Placeholder="Ingresa tu contraseña"
                            Password="{Binding Password}"
                            IconSource="lock.png"/>

                        <!-- LOGIN BUTTON -->
                        <Button Text="Ingresar"
                                Command="{Binding LoginCommand}"
                                HeightRequest="55"
                                CornerRadius="8"
                                BackgroundColor="#1F3A5F"
                                TextColor="White"
                                FontAttributes="Bold"/>

                    </VerticalStackLayout>
                </ScrollView>

            </Border>

        </Grid>

        <!-- LOADER — en Grid externo, por encima de la elevation del card -->
        <controls:LoaderSpinner BindingContext="{Binding Loader}" />

    </Grid>
</ContentPage>
