<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.MovementDetail"
             Title="Movimientos"
             BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">

        <Border Grid.Row="0"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="16"
                Margin="0,10,0,12">

            <VerticalStackLayout Spacing="8">
                <Label Text="StandardId"
                       FontSize="14"
                       TextColor="#64748B"/>

                <Border BackgroundColor="#102A43"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="12,10">
                    <Label Text="{Binding StandardIdText}"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"/>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#244A7C"
                                   HorizontalOptions="Start"/>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="10"
                Margin="0,0,0,8">

            <VerticalStackLayout Spacing="4">
                <Label Text="Inventario por StandardId"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#1E293B"/>

                <Label Text="{Binding InventoryStatus}"
                       FontSize="12"
                       TextColor="#64748B"/>

                <CollectionView ItemsSource="{Binding InventoryItems}"
                                SelectionMode="None"
                                HeightRequest="78">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  Padding="0,3"
                                  ColumnSpacing="10"
                                  RowSpacing="1">
                                <Label Text="{Binding Ubicacion, StringFormat='Ubicacion: {0}'}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"/>
                                <Label Grid.Column="1"
                                       Text="{Binding Qty, StringFormat='Cantidad: {0}'}"
                                       FontSize="13"
                                       TextColor="#334155"
                                       HorizontalTextAlignment="End"/>
                                <Label Grid.Row="1"
                                       Text="{Binding Cliente, StringFormat='Cliente: {0}'}"
                                       FontSize="12"
                                       TextColor="#334155"
                                       LineBreakMode="TailTruncation"/>
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding Proyecto, StringFormat='Proyecto: {0}'}"
                                       FontSize="12"
                                       TextColor="#334155"
                                       LineBreakMode="TailTruncation"/>
                                <Label Grid.Row="2"
                                       Text="{Binding PartNumber, StringFormat='Parte: {0}'}"
                                       FontSize="12"
                                       TextColor="#334155"
                                       LineBreakMode="TailTruncation"/>
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding LotNumber, StringFormat='Lote: {0}'}"
                                       FontSize="12"
                                       TextColor="#334155"
                                       LineBreakMode="TailTruncation"/>
                                <BoxView Grid.Row="2"
                                         Grid.ColumnSpan="2"
                                         HeightRequest="1"
                                         BackgroundColor="#EEF2F7"
                                         VerticalOptions="End"
                                         Margin="0,8,0,-8"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14">

            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Label Text="Historial de movimientos"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1E293B"/>

                <Label Grid.Row="1"
                       Text="{Binding MovementStatus}"
                       FontSize="12"
                       TextColor="#64748B"/>

                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding Movements}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="104,*,78"
                                  Padding="0,8"
                                  ColumnSpacing="8"
                                  RowSpacing="2">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="11"
                                           TextColor="#64748B"/>
                                    <Label Text="{Binding Hora, StringFormat='{0:hh\\:mm}'}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#334155"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="1">
                                    <Label Text="{Binding MovementType}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding UserName, StringFormat='Usuario: {0}'}"
                                           FontSize="11"
                                           TextColor="#475569"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding Qty, StringFormat='Cant: {0}'}"
                                       FontSize="11"
                                       TextColor="#334155"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center"/>

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Ubicacion, StringFormat='Ubicacion: {0}'}"
                                       FontSize="11"
                                       TextColor="#64748B"
                                       LineBreakMode="TailTruncation"/>

                                <BoxView Grid.Row="1"
                                         Grid.ColumnSpan="3"
                                         HeightRequest="1"
                                         BackgroundColor="#EEF2F7"
                                         VerticalOptions="End"
                                         Margin="0,8,0,-8"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
