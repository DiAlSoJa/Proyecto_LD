<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.DashboardPage"
             Title="DashboardPage"
             BackgroundColor="#1F3A5F">

    <ScrollView>
        <VerticalStackLayout Padding="20,60,20,30"
                             Spacing="5"
                             Background="#F4F6F9">

            <!-- HEADER -->
            <controls:DashboardHeader
                Username="{Binding Username}"
                TaskBadgeText="{Binding OperationalTasksHeaderText}"
                ShowTaskBadge="True"
                NavigateToTasksCommand="{Binding NavigateToTaskListCommand}"
                Margin="-20,-60,-20,0"/>

            <!-- ALMACENISTA -->
            <controls:Card IsVisible="{Binding ShowAlmacenista}">
                    <toolkit:Expander x:Name="ExpanderAlmacenista">
                        <toolkit:Expander.Header>
                            <controls:SectionHeader Icon="📦" Title="Almacenista"
                                IsExpanded="{Binding IsExpanded, Source={x:Reference ExpanderAlmacenista}}"/>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <!-- Fila: Cambio de ubicación -->
                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanChangeLocation}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📍" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Cambio de ubicación"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToChangeLocationCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanChangeLocation}"/>

                                <!-- Fila: Surtir mercancía -->
                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanSupply}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📦" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Surtir Mercancía"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToPickingCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanSupply}"/>

                                <!-- Fila: Validar embarque -->
                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanSupply}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="✅" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Validar embarque"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToValidarEmbarqueCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanSupply}"/>

                                <!-- Fila: ASN Por Ubicar -->
                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanViewAsn}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📥" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="ASN Por Ubicar"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToReceptionCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanViewAsn}"/>

                                <!-- Task Manager dentro de Almacenista -->
                                <toolkit:Expander x:Name="ExpanderTaskManager"
                                                  Margin="0,8,0,0"
                                                  IsVisible="{Binding CanViewWarehouseTasks}">
                                    <toolkit:Expander.Header>
                                        <controls:SectionHeader Icon="🕒" Title="Task Manager"
                                            IsExpanded="{Binding IsExpanded, Source={x:Reference ExpanderTaskManager}}"/>
                                    </toolkit:Expander.Header>

                                    <toolkit:Expander.Content>
                                        <VerticalStackLayout Padding="8,6" Spacing="0" BackgroundColor="White">

                                            <Border Stroke="Transparent" BackgroundColor="White">
                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="!" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación A012 y tomar el pallet 2027020100001 y dejarlo en AX025"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#B91C1C"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding NavigateToTaskManagerCommand}" CommandParameter="27 feb - Ir a la ubicación A012 y tomar el pallet 2027020100001 y dejarlo en AX025"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                            <Border Stroke="Transparent" BackgroundColor="White">
                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación A014 y tomar el pallet 2027020100004 y dejarlo en AX028"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#334155"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding NavigateToTaskManagerCommand}" CommandParameter="27 feb - Ir a la ubicación A014 y tomar el pallet 2027020100004 y dejarlo en AX028"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                            <Border Stroke="Transparent" BackgroundColor="White">
                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación B010 y tomar el pallet 2027020100007 y dejarlo en AX010"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#334155"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding NavigateToTaskManagerCommand}" CommandParameter="27 feb - Ir a la ubicación B010 y tomar el pallet 2027020100007 y dejarlo en AX010"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                            <Border Stroke="Transparent" BackgroundColor="White">
                                                <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                                    <Label Text="" FontSize="16" VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                         Text="27 feb - Ir a la ubicación C003 y tomar el pallet 2027020100012 y dejarlo en AX005"
                                                         Margin="10,0,0,0"
                                                         VerticalOptions="Center"
                                                         TextColor="#334155"
                                                         FontSize="15"/>
                                                </Grid>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding NavigateToTaskManagerCommand}" CommandParameter="27 feb - Ir a la ubicación C003 y tomar el pallet 2027020100012 y dejarlo en AX005"/>
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7"/>

                                        </VerticalStackLayout>
                                    </toolkit:Expander.Content>
                                </toolkit:Expander>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
            </controls:Card>

            <!-- SEGURIDAD -->
            <controls:Card IsVisible="{Binding ShowSecurity}">
                    <toolkit:Expander x:Name="ExpanderSeguridad">
                        <toolkit:Expander.Header>
                            <controls:SectionHeader Icon="👮‍♂️" Title="Seguridad"
                                IsExpanded="{Binding IsExpanded, Source={x:Reference ExpanderSeguridad}}"/>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <!-- Fila: Registrar vehículo -->
                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanRegisterVehicle}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="🚗" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Registrar Vehículo"
                                               Margin="10,0,0,0"
                                               VerticalOptions="Center"
                                               TextColor="#1E293B"
                                               FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToCasetaCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanRegisterVehicle}"/>

                                <!-- Task Manager dentro de Seguridad -->
                                <Border Stroke="Transparent" BackgroundColor="White"
                                        IsVisible="{Binding CanViewSecurityTasks}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,14">
                                        <Label Text="📋" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="Task Manager"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B"
                                               VerticalOptions="Center"
                                               Margin="10,0,0,0"
                                               FontSize="15"/>
                                        <Border Grid.Column="2"
                                                BackgroundColor="#DC2626"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="8,4"
                                                IsVisible="{Binding HasTareasPendientes}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding TareasPendientesCount}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToTaskManagerSecurityCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
            </controls:Card>

            <!-- CONSULTAS -->
            <controls:Card IsVisible="{Binding ShowConsultas}">
                    <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                        <Border Stroke="Transparent" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="15"
                              BackgroundColor="#F8FAFC">

                                <Label Text="🔍" FontSize="18" TextColor="#2F5DA8" VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="Consultas"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"
                                       VerticalOptions="Center"
                                       Padding="10"/>

                                <Label Grid.Column="2" Text=">" TextColor="#64748B" VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToMovementCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
            </controls:Card>

            <!-- REPORTE DE DAÑOS -->
            <controls:Card IsVisible="{Binding ShowDamageReport}">
                <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                    <Border Stroke="Transparent" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                            Padding="15"
                            BackgroundColor="#F8FAFC">

                            <Label Text="📸" FontSize="18" TextColor="#2F5DA8" VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                Text="Reporte de Daños"
                                FontAttributes="Bold"
                                TextColor="#1E293B"
                                VerticalOptions="Center"
                                Padding="10"/>

                            <Label Grid.Column="2" Text=">" TextColor="#64748B" VerticalOptions="Center"/>
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToDamageReportCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </controls:Card>

            <!-- OPERACIONES -->
            <controls:Card IsVisible="{Binding ShowOperations}">
                <toolkit:Expander x:Name="ExpanderOperaciones">
                    <toolkit:Expander.Header>
                        <controls:SectionHeader Icon="🚚" Title="Operaciones"
                            IsExpanded="{Binding IsExpanded, Source={x:Reference ExpanderOperaciones}}"/>
                    </toolkit:Expander.Header>

                    <toolkit:Expander.Content>
                        <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                            <!-- Fila: Control de Patio -->
                            <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanViewPatioPendientes}">
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,14">
                                    <Label Text="🚛" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="Control de Patio"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center"
                                           TextColor="#1E293B"
                                           FontSize="15"/>
                                    <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToPatioPendientesCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanViewPatioPendientes}"/>

                        </VerticalStackLayout>
                    </toolkit:Expander.Content>
                </toolkit:Expander>
            </controls:Card>

            <!-- INVENTARIOS -->
            <controls:Card IsVisible="{Binding ShowInventory}">
                    <toolkit:Expander x:Name="ExpanderInventario">
                        <toolkit:Expander.Header>
                            <controls:SectionHeader Icon="🔀" Title="Inventario"
                                IsExpanded="{Binding IsExpanded, Source={x:Reference ExpanderInventario}}"/>
                        </toolkit:Expander.Header>

                        <toolkit:Expander.Content>
                            <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">

                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanAudit}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="🔍" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                           Text="Auditar"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center"
                                           TextColor="#1E293B"
                                           FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToAuditCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanAudit}"/>

                                <Border Stroke="Transparent" BackgroundColor="White" IsVisible="{Binding CanViewInventoryList}">
                                    <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                        <Label Text="📋" FontSize="16" TextColor="#2F5DA8" VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                           Text="Listado"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center"
                                           TextColor="#1E293B"
                                           FontSize="15"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NavigateToInventoryListCommand}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                                <BoxView HeightRequest="1" BackgroundColor="#EEF2F7" IsVisible="{Binding CanViewInventoryList}"/>

                            </VerticalStackLayout>
                        </toolkit:Expander.Content>
                    </toolkit:Expander>
            </controls:Card>

            <!-- CHECKLIST DE MONTACARGAS -->
            <controls:Card IsVisible="{Binding ShowChecklist}">
                    <VerticalStackLayout Padding="0" Spacing="0" BackgroundColor="White">
                        <Border Stroke="Transparent" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                 Padding="15"
                                 BackgroundColor="#F8FAFC">

                                <Label Text="🚚" FontSize="18" TextColor="#2F5DA8" VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                      Text="Checklist de Montacargas"
                                      FontAttributes="Bold"
                                      TextColor="#1E293B"
                                      VerticalOptions="Center"
                                      Padding="10"/>

                                <Label Grid.Column="2" Text=">" TextColor="#64748B" VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToChecklistCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
            </controls:Card>

            <!-- CERRAR SESIÓN -->
            <Button Text="Cerrar sesión"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="#1F3A5F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
