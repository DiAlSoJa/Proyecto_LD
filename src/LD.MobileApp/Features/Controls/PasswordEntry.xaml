<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.Views.Controls.PasswordEntry"
             x:Name="root">
    <VerticalStackLayout Spacing="5">

        <Label Text="{Binding LabelText, Source={x:Reference root}}"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="#1F3A5F"/>

        <Grid ColumnDefinitions="Auto,*,40" Padding="5,0">

            <Image x:Name="IconImage"
                   Grid.Column="0"
                   Source="{Binding IconSource, Source={x:Reference root}}"
                   HeightRequest="20"
                   WidthRequest="20"
                   VerticalOptions="Center"
                   IsVisible="False"
                   Margin="0,0,8,0"/>

            <Entry x:Name="PasswordField"
                   Grid.Column="1"
                   Placeholder="{Binding Placeholder, Source={x:Reference root}}"
                   IsPassword="True"
                   BackgroundColor="Transparent"
                   HeightRequest="50"
                   TextColor="Black"/>

            <ImageButton x:Name="ToggleButton"
                         Grid.Column="2"
                         Source="eye.png"
                         BackgroundColor="Transparent"
                         HeightRequest="15"
                         WidthRequest="15"
                         Padding="5"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"/>

        </Grid>
        <BoxView x:Name="Underline"
                 HeightRequest="2"
                 BackgroundColor="#1F3A5F"
                 Margin="5,0"
                 Opacity="0.25"/>

    </VerticalStackLayout>
</ContentView>
