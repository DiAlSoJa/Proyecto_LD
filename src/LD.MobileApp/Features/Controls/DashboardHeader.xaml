<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.Views.Controls.DashboardHeader"
             x:Name="root">

    <Grid ColumnDefinitions="Auto,*,Auto"
          BackgroundColor="#1F3A5F"
          Padding="15">

        <!-- Icono de usuario con fondo blanco -->
        <Border Grid.Column="0"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="Ellipse"
                WidthRequest="44"
                HeightRequest="44"
                VerticalOptions="Center">
            <Image Source="user_circle.png"
                   HeightRequest="44"
                   WidthRequest="44"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUserTapped"/>
            </Border.GestureRecognizers>
        </Border>

        <!-- Username -->
        <Label Grid.Column="1"
               Text="{Binding Username, Source={x:Reference root}}"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="White"
               VerticalOptions="Center"
               Margin="12,0,0,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUserTapped"/>
            </Label.GestureRecognizers>
        </Label>

        <!-- Badge de tareas -->
        <Border Grid.Column="2"
                BackgroundColor="#2F5DA8"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 15"
                Padding="10,5"
                VerticalOptions="Center"
                IsVisible="{Binding ShowTaskBadge, Source={x:Reference root}}">
            <HorizontalStackLayout Spacing="5">
                <Label Text="🔔" TextColor="White"/>
                <Label Text="{Binding TaskBadgeText, Source={x:Reference root}}"
                       TextColor="White"
                       FontAttributes="Bold"/>
            </HorizontalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateToTasksCommand, Source={x:Reference root}}"/>
            </Border.GestureRecognizers>
        </Border>

    </Grid>
</ContentView>
