<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.Views.Controls.PhotoGallery"
             x:Name="root">

    <ScrollView Orientation="Horizontal">
        <HorizontalStackLayout Spacing="8"
            BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <controls:PhotoThumb
                        PhotoSource="{Binding Source}"
                        BadgeText="{Binding Title}"
                        DeleteCommand="{Binding DeleteCommand, Source={x:Reference root}}"
                        DeleteCommandParameter="{Binding .}"
                        ViewCommand="{Binding ViewCommand, Source={x:Reference root}}"
                        ViewCommandParameter="{Binding .}"/>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
    </ScrollView>

</ContentView>
