<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppLogin.DamageReportPrintPage"
    Title="Resumen"
    BackgroundColor="#0F2E4F">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Padding="16">
            <Border Grid.Row="0"
                    BackgroundColor="#F6F8FC"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="18"
                    Margin="0,10,0,12">

                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#102A43"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding StandardIdText}"
                                   TextColor="White"
                                   FontSize="15"/>
                            <Label Text="{Binding DamageReportCodeText}"
                                   TextColor="#D1D5DB"
                                   FontSize="12"/>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding PartNumberText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding UbicacionText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding StatusText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding CantidadRecibidaText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding AlmacenText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding ProyectoText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding ClienteText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding DescripcionText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding AsnText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding FechaRecepcionText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding DisponibleText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding EstadoText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding TipoDanoText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding CategoriaText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding NuevoEstatusText}" TextColor="#64748B" FontSize="14"/>
                    <Label Text="{Binding FechaReporteText}" TextColor="#64748B" FontSize="14"/>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Comentarios:" TextColor="#64748B" FontSize="14"/>
                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,10">
                            <Editor Text="{Binding Comments}"
                                    IsReadOnly="True"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="100"
                                    TextColor="#0F172A"/>
                        </Border>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#EEF3FB"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 18"
                            Padding="10"
                            Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="110,110"
                              ColumnSpacing="10"
                              RowSpacing="10">
                            <Image Source="{Binding Photo1Source}" Aspect="AspectFill" BackgroundColor="White"/>
                            <Image Grid.Column="1" Source="{Binding Photo2Source}" Aspect="AspectFill" BackgroundColor="White"/>
                            <Image Grid.Row="1" Source="{Binding Photo3Source}" Aspect="AspectFill" BackgroundColor="White"/>
                            <Image Grid.Row="1" Grid.Column="1" Source="{Binding Photo4Source}" Aspect="AspectFill" BackgroundColor="White"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Button Grid.Row="1"
                    Text="Imprimir"
                    Clicked="OnPrintClicked"
                    HeightRequest="56"
                    CornerRadius="18"
                    BackgroundColor="#244A7C"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    Margin="0,14,0,6"/>

            <Button Grid.Row="2"
                    Text="Configurar impresora Bluetooth"
                    Clicked="OnConfigurePrinterClicked"
                    HeightRequest="56"
                    CornerRadius="18"
                    BackgroundColor="#E5E7EB"
                    TextColor="#1E293B"
                    FontAttributes="Bold"
                    FontSize="17"
                    Margin="0,8,0,6"/>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Margin="0,8,0,6">

                <Button Text="PDF"
                        Clicked="OnPDFClicked"
                        HeightRequest="56"
                        CornerRadius="18"
                        BackgroundColor="#E5E7EB"
                        TextColor="#1E293B"
                        FontAttributes="Bold"
                        FontSize="18"/>

                <Button Grid.Column="1"
                        Text="Excel"
                        Clicked="OnExcelClicked"
                        HeightRequest="56"
                        CornerRadius="18"
                        BackgroundColor="#244A7C"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"/>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
