<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:services="clr-namespace:MauiAppLogin.Services"
    x:Class="MauiAppLogin.BluetoothPrinterSettingsPage"
    Title="Impresora Bluetooth"
    BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,10,0,14">
            <Label Text="Impresora Bluetooth"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"/>
            <Label Text="Detecta una sola vez, guardala y luego imprimira sin volver a buscarla."
                   FontSize="13"
                   TextColor="#94A3B8"/>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="4">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Impresora guardada"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#64748B"/>
                    <Label Text="{Binding SavedPrinterText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           LineBreakMode="TailTruncation"/>
                    <Label Text="{Binding HintText}"
                           FontSize="12"
                           TextColor="#64748B"/>
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#244A7C"
                                       HorizontalOptions="Start"/>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Detectar"
                        Clicked="OnDetectPrintersClicked"
                        IsEnabled="{Binding CanDetectPrinters}"
                        HeightRequest="54"
                        CornerRadius="18"
                        BackgroundColor="#244A7C"
                        TextColor="White"
                        FontAttributes="Bold"
                        HorizontalOptions="End"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Label Text="Dispositivos detectados"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       Margin="16,16,16,8"/>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding Printers}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                                Margin="12,0,12,12">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="10"
                                             Margin="20">
                            <Label Text="No hay impresoras detectadas"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                            <Label Text="Pulsa Detectar para buscar impresoras Bluetooth cercanas."
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:BluetoothPrinterDeviceInfo">
                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#F8FAFC"/>
                                                <Setter Property="Stroke" Value="#E2E8F0"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#EEF3FB"/>
                                                <Setter Property="Stroke" Value="#244A7C"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeThickness="0"
                                            BackgroundColor="#DDEAFE"
                                            StrokeShape="RoundRectangle 14"
                                            VerticalOptions="Center">
                                        <Label Text="PR"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               TextColor="#244A7C"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"/>
                                        <Label Text="{Binding DisplayAddress}"
                                               FontSize="12"
                                               TextColor="#64748B"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="4"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Border BackgroundColor="#E2E8F0"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999"
                                                Padding="10,4">
                                            <Label Text="{Binding BadgeText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A"
                                                   HorizontalOptions="Center"/>
                                        </Border>

                                        <Label Text="{Binding StatusText}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,12,0,6">
            <Button Text="Olvidar"
                    Clicked="OnClearPrinterClicked"
                    IsEnabled="{Binding CanClearPrinter}"
                    HeightRequest="54"
                    CornerRadius="18"
                    BackgroundColor="#334155"
                    TextColor="White"
                    FontAttributes="Bold"/>
            <Button Grid.Column="1"
                    Text="Guardar"
                    Clicked="OnSavePrinterClicked"
                    IsEnabled="{Binding CanSaveSelection}"
                    HeightRequest="54"
                    CornerRadius="18"
                    BackgroundColor="#244A7C"
                    TextColor="White"
                    FontAttributes="Bold"/>
        </Grid>
    </Grid>
</ContentPage>
