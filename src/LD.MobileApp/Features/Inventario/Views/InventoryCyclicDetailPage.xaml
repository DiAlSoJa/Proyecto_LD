<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.InventoryCyclicDetailPage"
             Title=""
             BackgroundColor="#1F3A5F">

    <Grid Padding="16,18,16,28"
          RowDefinitions="Auto,*"
          RowSpacing="14">

        <Border Grid.Row="0"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 24"
                Padding="14">
            <VerticalStackLayout Spacing="10">
                <Label Text="Escanear ubicación"
                       FontAttributes="Bold"
                       FontSize="17"
                       TextColor="#0F172A" />

                <Button x:Name="BtnEscanearUbicacion"
                        Text="Abrir captura de ubicación"
                        ImageSource="scan.svg"
                        ContentLayout="Left,10"
                        Clicked="OnScanLocationClicked"
                        BackgroundColor="#EEF4FF"
                        TextColor="#2F5DA8"
                        BorderColor="#BFDBFE"
                        CornerRadius="18"
                        Padding="14,12"
                        FontAttributes="Bold" />

                <Label Text="Se validará la ubicación antes de escanear el StandardId."
                       FontSize="12"
                       TextColor="#64748B"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 24"
                Padding="14"
                VerticalOptions="FillAndExpand">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="12">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <Label Text="Detalles"
                           FontAttributes="Bold"
                           FontSize="17"
                           TextColor="#0F172A" />
                    <Label Grid.Column="1"
                           Text="{Binding FilteredCountText, StringFormat='{0} ubicacion(es)'}"
                           FontSize="13"
                           TextColor="#64748B"
                           VerticalOptions="Center" />
                </Grid>

                <CollectionView Grid.Row="1"
                                x:Name="DetailsCollection"
                                SelectionMode="None"
                                ItemsLayout="VerticalList"
                                VerticalOptions="FillAndExpand">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#F0F9FF"
                                Stroke="#BAE6FD"
                                StrokeShape="RoundRectangle 18"
                                Padding="16">
                            <VerticalStackLayout Spacing="6"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="[]"
                                       FontSize="28"
                                       TextColor="#0284C7"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding EmptyTitleText}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#075985"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding EmptySubtitleText}"
                                       FontSize="12"
                                       TextColor="#475569"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding Color}"
                                    Stroke="#D7E5FF"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Ubicacion}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="#0F172A"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DetailSummary}"
                                           FontSize="12"
                                           TextColor="#475569"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
