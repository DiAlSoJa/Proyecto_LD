<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.InventoryList"
             Title="Inventario"
             BackgroundColor="#1F3A5F">

    <Grid Padding="16">

        <Border BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 28"
                Padding="12"
                Margin="0,10,0,0">

            <VerticalStackLayout Spacing="12">

                <Grid ColumnDefinitions="*,Auto"
                      Padding="4,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Inventario"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#0F172A"/>
                        <Label Text="Listado de tomas"
                               FontSize="13"
                               TextColor="#64748B"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Cerrar"
                            Clicked="OnCloseClicked"
                            BackgroundColor="#E2E8F0"
                            TextColor="#0F172A"
                            CornerRadius="14"
                            Padding="14,10"
                            VerticalOptions="Center"/>
                </Grid>

                <!-- Tabs -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                    <Border x:Name="TabPrimera"
                            Grid.Column="0"
                            BackgroundColor="#1F3A5F"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPrimeraTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout x:Name="LayoutPrimera"
                                               HorizontalOptions="Center"
                                               Spacing="6">
                            <Label x:Name="LblPrimeraText"
                                   Text="1ra Toma"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label x:Name="LblCountPrimera"
                                   Text="0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border x:Name="TabSegunda"
                            Grid.Column="1"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSegundaTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout x:Name="LayoutSegunda"
                                               HorizontalOptions="Center"
                                               Spacing="6">
                            <Label x:Name="LblSegundaText"
                                   Text="2da Toma"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                            <Label x:Name="LblCountSegunda"
                                   Text="0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border x:Name="TabTercera"
                            Grid.Column="2"
                            BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTerceraTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout x:Name="LayoutTercera"
                                               HorizontalOptions="Center"
                                               Spacing="6">
                            <Label x:Name="LblTerceraText"
                                   Text="3ra Toma"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                            <Label x:Name="LblCountTercera"
                                   Text="0"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#334155"/>
                        </HorizontalStackLayout>
                    </Border>

                </Grid>

                <!-- Inventory list -->
                <Border BackgroundColor="#F8FAFC"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="10"
                        VerticalOptions="FillAndExpand">

                    <CollectionView x:Name="InventoryCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnInventorySelected"
                                    VerticalOptions="FillAndExpand"
                                    ItemsLayout="VerticalList">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="6">
                                <Label Text="[]"
                                       FontSize="40"
                                       HorizontalOptions="Center"/>
                                <Label Text="No hay registros"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#334155"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#D7E5FF"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="44"
                                                HeightRequest="44"
                                                BackgroundColor="#EEF4FF"
                                                Stroke="#D7E5FF"
                                                StrokeShape="RoundRectangle 16"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Cantidad}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="#2F5DA8"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Folio, StringFormat='Folio: {0}'}"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   TextColor="#0F172A"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Almacen}"
                                                   FontSize="13"
                                                   TextColor="#64748B"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Auditor}"
                                                   FontSize="12"
                                                   TextColor="#94A3B8"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Estatus, StringFormat='Estatus: {0}'}"
                                                   FontSize="12"
                                                   TextColor="#0F766E"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="2"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="End">
                                            <Label Text="{Binding Fecha, StringFormat='{0:dd-MM-yyyy}'}"
                                                   FontSize="12"
                                                   TextColor="#64748B"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding Fecha, StringFormat='{0:hh:mm tt}'}"
                                                   FontSize="12"
                                                   TextColor="#94A3B8"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text=">"
                                                   FontSize="22"
                                                   TextColor="#94A3B8"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
