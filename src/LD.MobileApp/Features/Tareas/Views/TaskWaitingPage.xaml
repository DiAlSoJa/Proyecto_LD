<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.TaskWaitingPage"
             BackgroundColor="#1A1A2E"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Fondo oscuro full-screen -->
        <BoxView BackgroundColor="#1A1A2E" />

        <!-- Tarjeta central -->
        <Border 
                StrokeShape="RoundRectangle 16"
                Stroke="Transparent"
                Padding="32,28"
                MinimumWidthRequest="280">

            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                <Label Text="Esperando asignación de tarea..."
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" 
                       Margin="0,20,0,0"/>
                
                <ActivityIndicator IsRunning="True"
                                   Color="#E76F51"
                                   WidthRequest="150"
                                   HeightRequest="150"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,20"/>


                <Label Text="El sistema te asignará la próxima tarea disponible."
                       FontSize="16"
                       TextColor="#6B7280"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" 
                       Margin="0,30,0,0"/>

                <Button Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="44"
                        HorizontalOptions="Fill"
                        FontSize="18"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
