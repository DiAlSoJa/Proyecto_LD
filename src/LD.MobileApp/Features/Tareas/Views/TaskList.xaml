<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.TaskList"
             Title="Listado de Tareas"
             BackgroundColor="#0F2E4F">
    

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">





        <Grid  Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#0F2E4F"
              Padding="15"
              Margin="0,0,0,0">

          
            <Border Grid.Column="2"
            BackgroundColor="#2F5DA8"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 15"
            Padding="10,5"
            VerticalOptions="Center">

                <HorizontalStackLayout Spacing="5">
                    <Label Text="🔔" TextColor="White"/>
                    <Label Text="Nueva Tarea"
                   TextColor="White"
                   FontAttributes="Bold"/>
                </HorizontalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTaskNewClicked"/>
                </Border.GestureRecognizers>
            </Border>


        </Grid>
        
        
        

        <!-- Barra superior: filtro -->
        <Border Grid.Row="1"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14"
                Margin="0,10,0,12">

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="10">
                <Label Text="🔎"
                       FontSize="18"
                       VerticalOptions="Center"/>

                <Entry x:Name="FiltroEntry"
                       Grid.Column="1"
                       Placeholder="Filtrar..."
                       TextChanged="OnFiltroChanged"
                       BackgroundColor="White"
                       TextColor="#1E293B"
                       PlaceholderColor="#94A3B8"
                       ClearButtonVisibility="WhileEditing"/>

                <Label x:Name="WarehouseFilterLabel"
                       Grid.Row="1"
                       Text="Almacen"
                       TextColor="#64748B"
                       FontSize="14"
                       VerticalOptions="Center"
                       IsVisible="False"/>

                <Picker x:Name="WarehouseFilterPicker"
                        Grid.Row="1"
                        Grid.Column="1"
                        Title="Todos los almacenes"
                        ItemDisplayBinding="{Binding Value}"
                        SelectedIndexChanged="OnWarehouseFilterChanged"
                        TextColor="#1E293B"
                        BackgroundColor="White"
                        IsVisible="False"/>
            </Grid>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="0">

            <CollectionView x:Name="ItemsList"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,12"
                              ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto">

                            <!-- Icono -->
                            <Border WidthRequest="34"
                                    HeightRequest="34"
                                    BackgroundColor="#EEF2FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Label Text="📦"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Border>

                            <!-- Título -->
                            <Label Grid.Column="1"
                                   Text="{Binding Titulo}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#1E293B"
                                   Margin="10,0,0,0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Subtítulo -->
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Subtitulo}"
                                   FontSize="15"
                                   TextColor="#64748B"
                                   Margin="10,2,0,0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Línea -->
                            <BoxView Grid.Row="2"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     BackgroundColor="#EEF2F7"
                                     VerticalOptions="End"
                                     Margin="0,12,0,-12"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Border>

    </Grid>
</ContentPage>
