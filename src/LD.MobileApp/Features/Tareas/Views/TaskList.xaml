<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MauiAppLogin.Features.Seguridad.Models"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.TaskList"
             x:Name="Root"
             Title="Tareas Operativas"
             BackgroundColor="#0F2E4F">

    <Grid>

        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

            <!-- ═══ Encabezado ═══ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,16">

                <Border BackgroundColor="#1E3A5F" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="48" HeightRequest="48"
                        VerticalOptions="Center">
                    <Label Text="📋" FontSize="24"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="12,0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Tareas Operativas"
                           FontSize="20" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Tareas pendientes asignadas"
                           FontSize="12" TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="#244A7C" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,8" VerticalOptions="Center">
                    <Label Text="↺  Actualizar" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

            <!-- ═══ Barra de búsqueda y filtros ═══ -->
            <Border Grid.Row="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="18,14"
                    Margin="0,0,0,12">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="10">

                    <controls:LabeledEntry
                        x:Name="BuscadorEntry"
                        LabelText="Buscar"
                        Placeholder="Filtrar tareas..."
                        IconSource="search.svg"/>

                    <Label x:Name="WarehouseFilterLabel"
                           Text="Almacén"
                           TextColor="#64748B"
                           FontSize="14"
                           IsVisible="False"/>

                    <Picker x:Name="WarehouseFilterPicker"
                            Title="Todos los almacenes"
                            ItemDisplayBinding="{Binding Value}"
                            SelectedIndexChanged="OnWarehouseFilterChanged"
                            TextColor="#1E293B"
                            BackgroundColor="White"
                            IsVisible="False"/>

                </VerticalStackLayout>
            </Border>

            <!-- ═══ Lista de tareas ═══ -->
            <CollectionView x:Name="ItemsList"
                            Grid.Row="2"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="✅" FontSize="52" HorizontalOptions="Center"/>
                        <Label Text="Sin tareas pendientes"
                               TextColor="#94A3B8" FontSize="16"
                               HorizontalOptions="Center"/>
                        <Label Text="No hay tareas asignadas por el momento."
                               TextColor="#64748B" FontSize="13"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ListItemTask">
                        <Border BackgroundColor="#F6F8FC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="0,0,0,10">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <Border WidthRequest="46" HeightRequest="46"
                                        BackgroundColor="#EFF6FF" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center">
                                    <Label Text="📦"
                                           FontSize="22"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Titulo}"
                                           FontSize="15" FontAttributes="Bold" TextColor="#0F172A"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Subtitulo}"
                                           FontSize="12" TextColor="#64748B"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›" FontSize="32"
                                       TextColor="#94A3B8"
                                       VerticalOptions="Center"/>

                            </Grid>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- ═══ Botones inferiores ═══ -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,6">

                <Button Text="← Atrás"
                        Clicked="OnAtrasClicked"
                        HeightRequest="52" CornerRadius="18"
                        BackgroundColor="#334155" TextColor="White"
                        FontAttributes="Bold"/>

                <Border Grid.Column="1"
                        BackgroundColor="#244A7C" StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        HeightRequest="52">
                    <Label Text="＋  Nueva Tarea" TextColor="White"
                           FontAttributes="Bold" FontSize="15"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTaskNewClicked"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

        </Grid>

        <!-- Loader con spinner GIF -->
        <controls:LoaderSpinner x:Name="Loader" />

    </Grid>

</ContentPage>
