<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppLogin.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1F3A5F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
        <Grid RowDefinitions="300,*">

            <!-- HEADER ORANGE -->
        <Grid BackgroundColor="#1F3A5F"
              Padding="30,60,30,40">

                <VerticalStackLayout Spacing="10">
                
                <Image Source="logo.png"
                   HeightRequest="150"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"  />

                </VerticalStackLayout>
            </Grid>

            <!-- CARD -->
            <Frame Grid.Row="1"
               Margin="20,-60,20,20"
               CornerRadius="35"
               BackgroundColor="White"
               HasShadow="True"
               Padding="25">

                <ScrollView>
                    <VerticalStackLayout Spacing="20">

                   
                    <!-- Username -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Username"
                               FontAttributes="Bold"
                               FontSize="14"/>

                            <Frame CornerRadius="15"
                               BackgroundColor="#F7F7F7"
                               HasShadow="False"
                               Padding="15,10">
                                <Entry Placeholder="Enter your username"                               
                                   Text="{Binding Username}"
                                   BackgroundColor="#F9FAFB"
                                   HeightRequest="50"
                                   TextColor="Black"/>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- PASSWORD -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Password"
                               FontAttributes="Bold"
                               FontSize="14"/>

                            <Frame CornerRadius="15"
                               BackgroundColor="#F7F7F7"
                               HasShadow="False"
                               Padding="15,10">
                                <Grid ColumnDefinitions="*,40">
                                    <Entry Grid.Column="0"
                                           Placeholder="Enter your password"
                                           Text="{Binding Password}"
                                           IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                                           BackgroundColor="Transparent"
                                           HeightRequest="50"
                                           TextColor="Black"/>
                                    <ImageButton Grid.Column="1"
                                                 Source="eye.png"
                                                 Command="{Binding TogglePasswordVisibilityCommand}"
                                                 BackgroundColor="Transparent"
                                                 HeightRequest="15"
                                                 WidthRequest="15"
                                                 Padding="5"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center">
                                        <ImageButton.Triggers>
                                            <DataTrigger TargetType="ImageButton"
                                                         Binding="{Binding IsPasswordVisible}"
                                                         Value="True">
                                                <Setter Property="Source" Value="hidden.png"/>
                                            </DataTrigger>
                                        </ImageButton.Triggers>
                                    </ImageButton>
                                </Grid>
                            </Frame>
                        </VerticalStackLayout>


                        <!-- LOGIN BUTTON -->
                        <Button Text="Login"
                            Command="{Binding LoginCommand}"
                            HeightRequest="55"
                            CornerRadius="15"
                            BackgroundColor="#1F3A5F"
                            TextColor="White"
                            FontAttributes="Bold"/>

                    </VerticalStackLayout>
                </ScrollView>

            </Frame>

        </Grid>
    </ContentPage>