<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppLogin.WarehouseOperations"
             Title="Control de Patio"
             BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">

        <Label Text="Tipo de Daño:"
            Grid.Row="0"
            Grid.Column="0"
            VerticalOptions="Center"
            TextColor="#64748B"
            FontSize="14"/>

        <Border Grid.Row="0"
             Grid.Column="1"
             Stroke="#E2E8F0"
             StrokeThickness="1"
             StrokeShape="RoundRectangle 12"
             BackgroundColor="White"
             Padding="12,4">

            

        </Border>
        <!-- Barra superior: filtro -->
        <Border Grid.Row="1"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="14"
                Margin="0,10,0,12">

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto, Auto" ColumnSpacing="10">
                
                <Picker x:Name="EstadoPickerx"
                     Title="Selecciona"
                          Grid.Row="0"
                          Grid.Column="2"
                     TextColor="#1E293B">

                    <Picker.Items>
                        <x:String>Ultimas 24 hrs de llegada</x:String>
                        <x:String>En espera de asignar cortina</x:String>
                        <x:String>En espera de iniciar descarga</x:String>
                        <x:String>Descargando</x:String>
                        <x:String>Cargando</x:String>                        
                        <x:String>Ultimos 2 días desde llegada</x:String>
                        <x:String>Ultimos 5 días desde llegada</x:String>
                    </Picker.Items>

                </Picker>

                <Label Text="🔎"
                        Grid.Row="1"
                         Grid.Column="0"
                       FontSize="18"
                       VerticalOptions="Center"/>

                    <Entry x:Name="FiltroEntry"
                            Grid.Row="1"
                       Grid.Column="1"
                       Placeholder="Escribe para filtrar..."
                       TextChanged="OnFiltroChanged"
                       BackgroundColor="White"
                       TextColor="#1E293B"
                       PlaceholderColor="#94A3B8"
                       ClearButtonVisibility="WhileEditing"/>
                
                
                
            </Grid>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="0">

            <CollectionView x:Name="ItemsList"
                            SelectionMode="Single"
                            SelectionChanged="OnItemSelected">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,12"
                              ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto">

                            <!-- Icono -->
                            <Border WidthRequest="34"
                                    HeightRequest="34"
                                    BackgroundColor="#EEF2FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Label Text="📦"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Border>

                            <!-- Título -->
                            <Label Grid.Column="1"
                                   Text="{Binding Titulo}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#1E293B"
                                   Margin="10,0,0,0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Subtítulo -->
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Subtitulo}"
                                   FontSize="15"
                                   TextColor="#64748B"
                                   Margin="10,2,0,0"
                                   LineBreakMode="TailTruncation"/>

                            <!-- Subtítulo -->
                            <Label Grid.Row="2"
                                Grid.Column="2"
                                Text="{Binding Subtitulo2}"
                                FontSize="15"
                                TextColor="#64748B"
                                Margin="10,2,0,0"
                                LineBreakMode="TailTruncation"/>
                            

                            <!-- Línea -->
                            <BoxView Grid.Row="3"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     BackgroundColor="#EEF2F7"
                                     VerticalOptions="End"
                                     Margin="0,12,0,-12"/>

                            
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Border>

    </Grid>
</ContentPage>