<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppLogin.ChangeLocationPage"
    Title="Cambio de Ubicación"
    BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <Border Grid.Row="0"
                BackgroundColor="#E0F2FE"
                Stroke="#7DD3FC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="14,12"
                Margin="0,10,0,12"
                IsVisible="{Binding HasInstructionText}">
            <Label Text="{Binding InstructionText}"
                   TextColor="#0F172A"
                   FontAttributes="Bold"
                   FontSize="16"
                   LineBreakMode="WordWrap"/>
        </Border>

        <!-- Card superior con datos -->
        <Border Grid.Row="1"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="18"
                Margin="0,0,0,12">

            <VerticalStackLayout Spacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Standar ID" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Entry x:Name="EstandarIdEntry" Keyboard="Numeric" Placeholder="" TextColor="#0F172A" Text="{Binding EstandarId}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Rack:" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Entry x:Name="RackEntry" Placeholder="" TextColor="#0F172A" Text="{Binding Rack}"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Nivel:" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Entry x:Name="PosicionEntry" Placeholder="" TextColor="#0F172A" Text="{Binding Posicion}"/>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Icono de escaneo -->
        <Grid Grid.Row="2">
            <Border BackgroundColor="#0B2138"
                    Stroke="#163B63"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="10">

                <VerticalStackLayout Spacing="16"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 999"
                            WidthRequest="128"
                            HeightRequest="128"
                            Padding="22">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCapturarClicked"/>
                        </Border.GestureRecognizers>

                        <Grid WidthRequest="74"
                              HeightRequest="56"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <BoxView WidthRequest="3" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="5" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="2" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="4" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="6" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="3" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="5" HeightRequest="27" Color="#0F2E4F"/>
                                <BoxView WidthRequest="2" HeightRequest="27" Color="#0F2E4F"/>
                            </HorizontalStackLayout>

                            <Grid>
                                <BoxView Color="#0F2E4F" WidthRequest="14" HeightRequest="3" HorizontalOptions="Start" VerticalOptions="Start"/>
                                <BoxView Color="#0F2E4F" WidthRequest="3" HeightRequest="14" HorizontalOptions="Start" VerticalOptions="Start"/>

                                <BoxView Color="#0F2E4F" WidthRequest="14" HeightRequest="3" HorizontalOptions="End" VerticalOptions="Start"/>
                                <BoxView Color="#0F2E4F" WidthRequest="3" HeightRequest="14" HorizontalOptions="End" VerticalOptions="Start"/>

                                <BoxView Color="#0F2E4F" WidthRequest="14" HeightRequest="3" HorizontalOptions="Start" VerticalOptions="End"/>
                                <BoxView Color="#0F2E4F" WidthRequest="3" HeightRequest="14" HorizontalOptions="Start" VerticalOptions="End"/>

                                <BoxView Color="#0F2E4F" WidthRequest="14" HeightRequest="3" HorizontalOptions="End" VerticalOptions="End"/>
                                <BoxView Color="#0F2E4F" WidthRequest="3" HeightRequest="14" HorizontalOptions="End" VerticalOptions="End"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Text="Escanear"
                            Clicked="OnCapturarClicked"
                            HeightRequest="52"
                            CornerRadius="18"
                            BackgroundColor="#FFFFFF"
                            TextColor="#0F2E4F"
                            FontAttributes="Bold"
                            FontSize="18"
                            Padding="28,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,14,0,6">

            <Button Text="Atrás"
                    Clicked="OnAtrasClicked"
                    HeightRequest="56"
                    CornerRadius="18"
                    BackgroundColor="#E5E7EB"
                    TextColor="#1E293B"
                    FontAttributes="Bold"
                    FontSize="18"/>

            <Button Grid.Column="1"
                    Text="Siguiente"
                    Clicked="OnSiguienteClicked"
                    HeightRequest="56"
                    CornerRadius="18"
                    BackgroundColor="#244A7C"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding IsBusy}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <Border Grid.RowSpan="4"
                BackgroundColor="#AAFFFFFF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                IsVisible="{Binding IsBusy}">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="#244A7C"
                                   WidthRequest="42"
                                   HeightRequest="42"/>
                <Label Text="Transfiriendo ubicacion..."
                       HorizontalOptions="Center"
                       TextColor="#244A7C"
                       FontAttributes="Bold"
                       FontSize="16"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
