<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
             xmlns:dto="clr-namespace:LD.Contracts.DTOs.Security;assembly=LD.Contracts"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.PatioPendientesPage"
             x:DataType="vm:PatioPendientesViewModel"
             x:Name="Root"
             Title="Control de Patio"
             BackgroundColor="#1F3A5F">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="16">

            <Border Grid.Row="0"
                    BackgroundColor="#F6F8FC"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="14"
                    Margin="0,10,0,12">

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="#EEF2FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AtrasCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="←"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="0"
                                             VerticalOptions="Center">
                            <Label Text="Control de Patio"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#1E293B" />
                            <Label Text="Vehículos actualmente en patio"
                                   FontSize="13"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="#EEF2FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CargarCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="↻"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#D9E2F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="🔎"
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   TextColor="#64748B" />

                            <Entry Grid.Column="1"
                                   Text="{Binding FiltroTexto, Mode=TwoWay}"
                                   Placeholder="Filtrar por placa, nombre, tipo o línea..."
                                   BackgroundColor="Transparent"
                                   TextColor="#1E293B"
                                   PlaceholderColor="#94A3B8"
                                   ClearButtonVisibility="WhileEditing"
                                   Keyboard="Text" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 25"
                    Padding="10">

                <CollectionView ItemsSource="{Binding Vehiculos}"
                                SelectionMode="None"
                                ItemsLayout="VerticalList">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24"
                                             Spacing="8"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Label Text="{Binding EmptyTitle}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding EmptyMessage}"
                                   FontSize="13"
                                   TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:SecurityRegistrationDto">
                            <VerticalStackLayout Spacing="0">
                                <Border Stroke="Transparent"
                                        BackgroundColor="White"
                                        Padding="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SeleccionarCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid Padding="14,12"
                                          ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto">
                                        <Border WidthRequest="34"
                                                HeightRequest="34"
                                                BackgroundColor="#EEF2FF"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                VerticalOptions="Center">
                                            <Label Text="🚚"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding Placa}"
                                               FontAttributes="Bold"
                                               FontSize="18"
                                               TextColor="#1E293B"
                                               Margin="10,0,0,0"
                                               LineBreakMode="TailTruncation" />

                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Nombre}"
                                               FontSize="14"
                                               TextColor="#64748B"
                                               Margin="10,2,0,0"
                                               LineBreakMode="TailTruncation" />

                                        <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding CreatedAt, StringFormat='Entrada: {0:HH:mm}'}"
                                               FontSize="12"
                                               TextColor="#0F766E"
                                               Margin="10,4,0,0"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>
                                </Border>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="#EEF2F7" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>

        <controls:LoaderSpinner BindingContext="{Binding Loader}" />
    </Grid>
</ContentPage>
