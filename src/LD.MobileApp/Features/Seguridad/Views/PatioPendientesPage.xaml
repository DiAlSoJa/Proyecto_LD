<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
             xmlns:dto="clr-namespace:LD.Contracts.DTOs.Security;assembly=LD.Contracts"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.PatioPendientesPage"
             x:DataType="vm:PatioPendientesViewModel"
             x:Name="Root"
             Title="Control de Patio"
             BackgroundColor="#0F2E4F">

    <Grid>

        <Grid RowDefinitions="Auto,*,Auto" Padding="16">


            <!-- ═══ Encabezado ═══ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,16">

                <Border BackgroundColor="#1E3A5F" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="48" HeightRequest="48"
                        VerticalOptions="Center">
                    <Label Text="🚛" FontSize="24"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Margin="12,0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Control de Patio"
                           FontSize="20" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Vehículos actualmente en patio"
                           FontSize="12" TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="#244A7C" StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,8" VerticalOptions="Center">
                    <Label Text="↺  Actualizar" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CargarCommand}"/>
                    </Border.GestureRecognizers>
                </Border>

            </Grid>

            <!-- ═══ Lista de vehículos ═══ -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Vehiculos}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="🚫" FontSize="52" HorizontalOptions="Center"/>
                        <Label Text="Sin vehículos en patio"
                               TextColor="#94A3B8" FontSize="16"
                               HorizontalOptions="Center"/>
                        <Label Text="Registra un vehículo para comenzar."
                               TextColor="#64748B" FontSize="13"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:SecurityRegistrationDto">
                        <Border BackgroundColor="#F6F8FC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                Margin="0,0,0,10">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Ícono tipo vehículo -->
                                <Border WidthRequest="46" HeightRequest="46"
                                        BackgroundColor="#DCFCE7" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        VerticalOptions="Center">
                                    <Label Text="🚛"
                                           FontSize="22"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <!-- Datos del registro -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Placa}"
                                           FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Label Text="{Binding Nombre}"
                                           FontSize="13" TextColor="#374151"/>
                                    <Label Text="{Binding CreatedAt, StringFormat='Entrada: {0:HH:mm}'}"
                                           FontSize="12" TextColor="#94A3B8"/>
                                    <Label Text="{Binding TipoVehiculo}"
                                           FontSize="11" TextColor="#64748B"/>
                                </VerticalStackLayout>

                                <!-- Flecha de detalle -->
                                <Label Grid.Column="2"
                                       Text="›" FontSize="32"
                                       TextColor="#94A3B8"
                                       VerticalOptions="Center"/>

                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SeleccionarCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- ═══ Botón panel ═══ -->
            <Button Grid.Row="2"
                    Text="← Ir al Panel"
                    Command="{Binding AtrasCommand}"
                    HeightRequest="52" CornerRadius="18"
                    BackgroundColor="#334155" TextColor="White"
                    FontAttributes="Bold" Margin="0,12,0,6"/>

        </Grid>

        <!-- Loader con spinner GIF sobre todo el contenido -->
        <controls:LoaderSpinner BindingContext="{Binding Loader}" />

    </Grid>
</ContentPage>
