<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.PatioDetallePage"
             x:DataType="vm:PatioDetalleViewModel"
             Title="Control de patio"
             BackgroundColor="#0F2E4F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBool"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border BackgroundColor="#F6F8FC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Vehículo en patio"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                            <Label Text="{Binding Vehiculo.Placa}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                            <Label Text="{Binding Vehiculo.TipoOperacion}"
                                   FontSize="13"
                                   TextColor="#244A7C"/>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E2E8F0"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="14">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Operador" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.Operador}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Hora de entrada" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.HoraEntrada, StringFormat='{0:HH:mm}'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Spacing="3">
                                <Label Text="Tipo vehículo" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.TipoVehiculo}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="Línea" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.Linea}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#F6F8FC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="20"
                        IsVisible="{Binding Vehiculo.TieneCaja}">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Caja"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                            <Label Text="{Binding Vehiculo.NumeroCaja}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="14">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Placa caja" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.PlacaCaja}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Sello" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.Sello}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#F6F8FC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Cortina"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                            <Label Text="{Binding CortinaTexto}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                        </VerticalStackLayout>

                        <Button Text="Asignar cortina"
                                Command="{Binding AsignarCortinaCommand}"
                                IsVisible="{Binding TieneCortina, Converter={StaticResource InvertedBool}}"
                                HeightRequest="54"
                                CornerRadius="18"
                                BackgroundColor="#244A7C"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"/>

                        <Border BackgroundColor="#DCFCE7"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                IsVisible="{Binding TieneCortina}"
                                Padding="14,8"
                                HorizontalOptions="Start">
                            <Label Text="Cortina asignada correctamente"
                                   TextColor="#166534"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>

                        <Button Text="{Binding IniciarOperacionTexto}"
                                Command="{Binding IniciarOperacionCommand}"
                                IsVisible="{Binding PuedeIniciarOperacion}"
                                HeightRequest="54"
                                CornerRadius="18"
                                BackgroundColor="#244A7C"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"/>

                        <Button Text="Finalizar operación"
                                Command="{Binding FinalizarOperacionCommand}"
                                IsVisible="{Binding PuedeFinalizarOperacion}"
                                HeightRequest="54"
                                CornerRadius="18"
                                BackgroundColor="#7C2D12"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"/>

                        <Button Text="Cerrar cortina"
                                Command="{Binding CerrarCortinaCommand}"
                                IsVisible="{Binding PuedeCerrarCortina}"
                                HeightRequest="54"
                                CornerRadius="18"
                                BackgroundColor="#0F766E"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="← Regresar"
                        Command="{Binding AtrasCommand}"
                        HeightRequest="52"
                        CornerRadius="18"
                        BackgroundColor="#334155"
                        TextColor="White"
                        FontAttributes="Bold"
                        Margin="0,4,0,16"/>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LoaderSpinner BindingContext="{Binding Loader}" />
    </Grid>
</ContentPage>
