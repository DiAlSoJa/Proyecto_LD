<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.PatioDetallePage"
             x:DataType="vm:PatioDetalleViewModel"
             Title="Detalle del Vehículo"
             BackgroundColor="#0F2E4F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBool"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- ═══ Tarjeta del vehículo ═══ -->
                <Border BackgroundColor="#F6F8FC"
                        Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">

                        <HorizontalStackLayout Spacing="10">
                            <Border BackgroundColor="#DBEAFE" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="42" HeightRequest="42">
                                <Label Text="🚛" FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Vehículo registrado"
                                       FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.Placa}"
                                       FontSize="28" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="#E2E8F0"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                              ColumnSpacing="16" RowSpacing="14">

                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Operador" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.Operador}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Hora de entrada" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.HoraEntrada, StringFormat='{0:HH:mm}'}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="Tipo vehículo" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.TipoVehiculo}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1E293B"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="Línea" FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding Vehiculo.Linea}"
                                       FontSize="15" FontAttributes="Bold" TextColor="#1E293B"/>
                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ═══ Tarjeta de cortina ═══ -->
                <Border BackgroundColor="#F6F8FC"
                        Stroke="#E2E8F0" StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="20">
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="10">
                            <Border BackgroundColor="#FEF9C3" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="42" HeightRequest="42">
                                <Label Text="🏭" FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Cortina asignada"
                                       FontSize="12" TextColor="#64748B"/>
                                <Label Text="{Binding CortinaTexto}"
                                       FontSize="22" FontAttributes="Bold" TextColor="#1E293B"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Botón: visible solo si NO tiene cortina -->
                        <Button Text="🔗  Asignar Cortina"
                                Command="{Binding AsignarCortinaCommand}"
                                IsVisible="{Binding TieneCortina, Converter={StaticResource InvertedBool}}"
                                HeightRequest="54" CornerRadius="18"
                                BackgroundColor="#244A7C" TextColor="White"
                                FontAttributes="Bold" FontSize="16"/>

                        <!-- Chip: visible cuando ya tiene cortina -->
                        <Border BackgroundColor="#DCFCE7" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                IsVisible="{Binding TieneCortina}"
                                Padding="14,8" HorizontalOptions="Start">
                            <Label Text="✔  Cortina asignada correctamente"
                                   TextColor="#166534" FontSize="13" FontAttributes="Bold"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ═══ Botón Atrás ═══ -->
                <Button Text="← Regresar"
                        Command="{Binding AtrasCommand}"
                        HeightRequest="52" CornerRadius="18"
                        BackgroundColor="#334155" TextColor="White"
                        FontAttributes="Bold" Margin="0,4,0,16"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- LOADER -->
        <controls:LoaderSpinner BindingContext="{Binding Loader}"/>

    </Grid>
</ContentPage>
