<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
    xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
    x:Class="MauiAppLogin.RegisterVehicule"
    x:DataType="vm:RegisterVehiculeViewModel"
    Title="Vehículo"
    BackgroundColor="#0F2E4F">

    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#0F172A" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SectionSubtitleStyle" TargetType="Label">
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PhotoActionButtonStyle" TargetType="Button">
            <Setter Property="WidthRequest" Value="44" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="BackgroundColor" Value="#EAF2FF" />
            <Setter Property="TextColor" Value="#1F3A5F" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="*,Auto" Padding="16">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="0">

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,8">
                        <Border BackgroundColor="#334155"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,6"
                                StrokeThickness="0">
                            <Label Text="1 Licencia" TextColor="#94A3B8" FontSize="13" />
                        </Border>
                        <Border BackgroundColor="#244A7C"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,6"
                                StrokeThickness="0">
                            <Label Text="2 Vehículo"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="13" />
                        </Border>
                        <Border BackgroundColor="#334155"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,6"
                                StrokeThickness="0">
                            <Label Text="3 Firma" TextColor="#94A3B8" FontSize="13" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- 1. Información general -->
                    <Border BackgroundColor="#F6F8FC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            Padding="18"
                            Margin="0,4,0,12">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#244A7C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">
                                    <Label Text="1"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Datos del camión" Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="Selecciona el tipo y captura sus datos generales."
                                           Style="{StaticResource SectionSubtitleStyle}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="7">
                                <Label Text="Tipo de camión:"
                                       TextColor="#475569"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                <Border BackgroundColor="White"
                                        Stroke="#CBD5E1"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="8,2">
                                    <Picker ItemsSource="{Binding TruckTypes}"
                                            SelectedItem="{Binding SelectedTruckType, Mode=TwoWay}"
                                            ItemDisplayBinding="{Binding Name}"
                                            Title="Selecciona un tipo de camión"
                                            TextColor="#0F172A"
                                            BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <controls:LabeledEntry
                                LabelText="Línea:"
                                Text="{Binding Linea}"
                                Placeholder="Seleccione la línea" />

                            <controls:LabeledEntry
                                LabelText="Origen:"
                                Text="{Binding Origen}"
                                Placeholder="Ej. GDL" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. Identificación y fotos del camión -->
                    <Border BackgroundColor="#F6F8FC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            Padding="18"
                            Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#244A7C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">
                                    <Label Text="2"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Identificación del camión"
                                           Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="Usa 📷 para tomar la foto o 🖼 para elegirla."
                                           Style="{StaticResource SectionSubtitleStyle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="#EAF2FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8,5"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding VehiclePhotoStatusText}"
                                           TextColor="#1F3A5F"
                                           FontAttributes="Bold"
                                           FontSize="11" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <controls:LabeledEntry
                                    LabelText="Número del camión:"
                                    Text="{Binding Numero}"
                                    Placeholder="Ej. XS225"
                                    ShowClearButton="True" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="End"
                                                     Margin="0,0,0,1">
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="📷"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding CapturarSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.NumeroVehiculo}"
                                                SemanticProperties.Description="Tomar foto del número del camión">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding HasNumeroVehiculoPhoto}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="🖼"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding GaleriaSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.NumeroVehiculo}"
                                                SemanticProperties.Description="Elegir foto del número del camión" />
                                    </HorizontalStackLayout>
                                    <Label Text="Foto lista"
                                           IsVisible="{Binding HasNumeroVehiculoPhoto}"
                                           TextColor="#15803D"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <controls:LabeledEntry
                                    LabelText="Placas del camión:"
                                    Text="{Binding Placa}"
                                    Placeholder="Ej. 123-ABC"
                                    ShowClearButton="True" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="End"
                                                     Margin="0,0,0,1">
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="📷"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding CapturarSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.PlacaVehiculo}"
                                                SemanticProperties.Description="Tomar foto de las placas del camión">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding HasPlacaVehiculoPhoto}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="🖼"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding GaleriaSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.PlacaVehiculo}"
                                                SemanticProperties.Description="Elegir foto de las placas del camión" />
                                    </HorizontalStackLayout>
                                    <Label Text="Foto lista"
                                           IsVisible="{Binding HasPlacaVehiculoPhoto}"
                                           TextColor="#15803D"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <controls:PhotoGallery
                                ItemsSource="{Binding VehiclePhotos}"
                                DeleteCommand="{Binding RemovePhotoCommand}"
                                ViewCommand="{Binding ViewPhotoCommand}"
                                IsVisible="{Binding HasVehiclePhotos}"
                                MinimumHeightRequest="90" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Caja o remolque, sólo cuando el tipo seleccionado la requiere -->
                    <Border BackgroundColor="#FFF8ED"
                            Stroke="#F5D8A8"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            Padding="18"
                            Margin="0,0,0,12"
                            IsVisible="{Binding TieneCaja}">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#B45309"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">
                                    <Label Text="3"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Caja / remolque"
                                           Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="Registra cada dato con su fotografía."
                                           Style="{StaticResource SectionSubtitleStyle}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="#FEF3C7"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8,5"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding BoxPhotoStatusText}"
                                           TextColor="#92400E"
                                           FontAttributes="Bold"
                                           FontSize="11" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <controls:LabeledEntry
                                    LabelText="Número de caja:"
                                    Text="{Binding NumeroCaja}"
                                    Placeholder="Ej. CAX-001"
                                    ShowClearButton="True" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="End"
                                                     Margin="0,0,0,1">
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="📷"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding CapturarSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.NumeroCaja}"
                                                SemanticProperties.Description="Tomar foto del número de la caja">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding HasNumeroCajaPhoto}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="🖼"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding GaleriaSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.NumeroCaja}"
                                                SemanticProperties.Description="Elegir foto del número de la caja" />
                                    </HorizontalStackLayout>
                                    <Label Text="Foto lista"
                                           IsVisible="{Binding HasNumeroCajaPhoto}"
                                           TextColor="#15803D"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <controls:LabeledEntry
                                    LabelText="Placas de la caja:"
                                    Text="{Binding PlacaCaja}"
                                    Placeholder="Ej. 123-XYZ"
                                    ShowClearButton="True" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="End"
                                                     Margin="0,0,0,1">
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="📷"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding CapturarSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.PlacaCaja}"
                                                SemanticProperties.Description="Tomar foto de las placas de la caja">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding HasPlacaCajaPhoto}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="🖼"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding GaleriaSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.PlacaCaja}"
                                                SemanticProperties.Description="Elegir foto de las placas de la caja" />
                                    </HorizontalStackLayout>
                                    <Label Text="Foto lista"
                                           IsVisible="{Binding HasPlacaCajaPhoto}"
                                           TextColor="#15803D"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <controls:LabeledEntry
                                    LabelText="Sello:"
                                    Text="{Binding Sello}"
                                    Placeholder="Ej. SELLO-01"
                                    ShowClearButton="True" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     VerticalOptions="End"
                                                     Margin="0,0,0,1">
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="📷"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding CapturarSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.Sello}"
                                                SemanticProperties.Description="Tomar foto del sello de la caja">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding HasSelloPhoto}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <Button Text="🖼"
                                                Style="{StaticResource PhotoActionButtonStyle}"
                                                Command="{Binding GaleriaSlotCommand}"
                                                CommandParameter="{x:Static vm:VehiclePhotoSlot.Sello}"
                                                SemanticProperties.Description="Elegir foto del sello de la caja" />
                                    </HorizontalStackLayout>
                                    <Label Text="Foto lista"
                                           IsVisible="{Binding HasSelloPhoto}"
                                           TextColor="#15803D"
                                           FontAttributes="Bold"
                                           FontSize="10"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>

                            <controls:PhotoGallery
                                ItemsSource="{Binding BoxPhotos}"
                                DeleteCommand="{Binding RemovePhotoCommand}"
                                ViewCommand="{Binding ViewPhotoCommand}"
                                IsVisible="{Binding HasBoxPhotos}"
                                MinimumHeightRequest="90" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Documentos, siempre al final de la seccion de vehiculo -->
                    <Border BackgroundColor="#F6F8FC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 22"
                            Padding="18"
                            Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="#244A7C"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12">
                                    <Label Text="{Binding DocumentSectionNumber}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Documentos"
                                           Style="{StaticResource SectionTitleStyle}" />
                                    <Label Text="Captura la referencia documental del transporte."
                                           Style="{StaticResource SectionSubtitleStyle}" />
                                </VerticalStackLayout>
                            </Grid>

                            <controls:LabeledEntry
                                LabelText="Documento:"
                                Text="{Binding Documento}"
                                Placeholder="Ej. Carta porte, folio o referencia"
                                ShowClearButton="True" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  Margin="0,14,0,6">
                <Button Text="Atrás"
                        Command="{Binding AtrasCommand}"
                        HeightRequest="56"
                        CornerRadius="18"
                        BackgroundColor="#334155"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18" />

                <Button Grid.Column="1"
                        Text="Siguiente"
                        Command="{Binding SiguienteCommand}"
                        HeightRequest="56"
                        CornerRadius="18"
                        BackgroundColor="#244A7C"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18" />
            </Grid>

        </Grid>

        <controls:LoaderSpinner BindingContext="{Binding Loader}" />
    </Grid>
</ContentPage>
