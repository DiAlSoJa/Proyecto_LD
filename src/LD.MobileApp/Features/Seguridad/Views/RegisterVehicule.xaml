<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
    xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
    x:Class="MauiAppLogin.RegisterVehicule"
    x:DataType="vm:RegisterVehiculeViewModel"
    Title="Vehículo"
    BackgroundColor="#0F2E4F">

    <!-- Grid externo: aísla el loader de la elevation nativa de Android -->
    <Grid>

        <Grid RowDefinitions="*,Auto" Padding="16">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="0">

                    <!-- Stepper -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,6">
                        <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                            <Label Text="1 Licencia" TextColor="#94A3B8" FontSize="13"/>
                        </Border>
                        <Border BackgroundColor="#244A7C" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                            <Label Text="2 Vehículo" TextColor="White" FontAttributes="Bold" FontSize="13"/>
                        </Border>
                        <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                            <Label Text="3 Firma" TextColor="#94A3B8" FontSize="13"/>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Card con datos del vehículo -->
                    <Border BackgroundColor="#F6F8FC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            Padding="18"
                            Margin="0,4,0,12">

                        <VerticalStackLayout Spacing="12">

                            <!-- Tipo selector -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tipo:" TextColor="#64748B" FontSize="14"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Border BackgroundColor="{Binding IsCajaSelected, Converter={StaticResource BoolToColorConverter}}"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 25"
                                            Padding="18,10">
                                        <Label Text="Caja" TextColor="#0F172A" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectCajaCommand}"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <Border BackgroundColor="{Binding IsTractorSelected, Converter={StaticResource BoolToColorConverter}}"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 25"
                                            Padding="18,10">
                                        <Label Text="Tractor" TextColor="#0F172A" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SelectTractorCommand}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <controls:LabeledEntry
                                LabelText="Línea:"
                                Text="{Binding Linea}"
                                Placeholder="Seleccione la línea"/>

                            <controls:LabeledEntry
                                LabelText="Origen:"
                                Text="{Binding Origen}"
                                Placeholder="Ej. GDL"/>

                            <controls:LabeledEntry
                                LabelText="Número:"
                                Text="{Binding Numero}"
                                Placeholder="Ej. XS225"/>

                            <controls:LabeledEntry
                                LabelText="Placa:"
                                Text="{Binding Placa}"
                                Placeholder="Ej. 123-ABC"/>

                            <!-- Galería de fotos -->
                            <controls:PhotoGallery
                                ItemsSource="{Binding Photos}"
                                DeleteCommand="{Binding RemovePhotoCommand}"
                                ViewCommand="{Binding ViewPhotoCommand}"
                                Margin="0,6,0,0"
                                MinimumHeightRequest="90"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- Área de cámara -->
                    <Border BackgroundColor="#1B2A3A"
                            Stroke="#0B1B2A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="10"
                            Margin="0,0,0,12">

                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                            <Grid HeightRequest="78">
                                <Border BackgroundColor="#0F172A" Stroke="#334155"
                                        StrokeShape="RoundRectangle 22" Padding="10">
                                    <Grid>
                                        <Grid Padding="16,10">
                                            <Border Stroke="#FFFFFF" StrokeThickness="3"
                                                    StrokeShape="RoundRectangle 22"
                                                    BackgroundColor="Transparent" Opacity="0.35"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Row="1" ColumnDefinitions="*,Auto,*" Padding="6,0">
                                <Border Grid.Column="1" BackgroundColor="#102A43"
                                        Stroke="#FFFFFF" StrokeThickness="2"
                                        StrokeShape="RoundRectangle 999"
                                        WidthRequest="86" HeightRequest="86"
                                        VerticalOptions="Center" HorizontalOptions="Center" Padding="10">
                                    <Button Text="" Command="{Binding CapturarCommand}"
                                            BackgroundColor="White" CornerRadius="999"
                                            WidthRequest="60" HeightRequest="60"/>
                                </Border>

                                <Border Grid.Column="2"
                                        BackgroundColor="#102A43"
                                        Stroke="#1E3A5F"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8,7"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GaleriaCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="#1B2A3A"
                                                Stroke="#DDE8F4"
                                                StrokeThickness="1.5"
                                                StrokeShape="RoundRectangle 6"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                Padding="0">
                                            <Label Text="🖼"
                                                   TextColor="White"
                                                   FontSize="15"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="Galería"
                                               TextColor="White"
                                               FontSize="13"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Navigation -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,14,0,6">
                <Button Text="Atrás"
                        Command="{Binding AtrasCommand}"
                        HeightRequest="56" CornerRadius="18"
                        BackgroundColor="#334155" TextColor="White"
                        FontAttributes="Bold" FontSize="18"/>

                <Button Grid.Column="1" Text="Siguiente"
                        Command="{Binding SiguienteCommand}"
                        HeightRequest="56" CornerRadius="18"
                        BackgroundColor="#244A7C" TextColor="White"
                        FontAttributes="Bold" FontSize="18"/>
            </Grid>

        </Grid>

        <!-- LOADER — en Grid externo, encima de todo en Android -->
        <controls:LoaderSpinner BindingContext="{Binding Loader}" />

    </Grid>
</ContentPage>
