<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
    xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
    x:Class="MauiAppLogin.RegisterVehicule"
    x:DataType="vm:RegisterVehiculeViewModel"
    Title="Vehiculo"
    BackgroundColor="#0F2E4F">

    <Grid>
        <Grid RowDefinitions="*,Auto" Padding="16">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="0">

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,6">
                        <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                            <Label Text="1 Licencia" TextColor="#94A3B8" FontSize="13"/>
                        </Border>
                        <Border BackgroundColor="#244A7C" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                            <Label Text="2 Vehiculo" TextColor="White" FontAttributes="Bold" FontSize="13"/>
                        </Border>
                        <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                            <Label Text="3 Firma" TextColor="#94A3B8" FontSize="13"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="#F6F8FC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            Padding="18"
                            Margin="0,4,0,12">

                        <VerticalStackLayout Spacing="12">

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tipo de camion:" TextColor="#64748B" FontSize="14"/>
                                <Border BackgroundColor="White"
                                        Stroke="#CBD5E1"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="8,2">
                                    <Picker ItemsSource="{Binding TruckTypes}"
                                            SelectedItem="{Binding SelectedTruckType, Mode=TwoWay}"
                                            ItemDisplayBinding="{Binding Name}"
                                            Title="Selecciona un tipo de camion"
                                            TextColor="#0F172A"
                                            BackgroundColor="Transparent"/>
                                </Border>
                            </VerticalStackLayout>

                            <controls:LabeledEntry
                                LabelText="Linea:"
                                Text="{Binding Linea}"
                                Placeholder="Seleccione la linea"/>

                            <controls:LabeledEntry
                                LabelText="Origen:"
                                Text="{Binding Origen}"
                                Placeholder="Ej. GDL"/>

                            <controls:LabeledEntry
                                LabelText="Numero:"
                                Text="{Binding Numero}"
                                Placeholder="Ej. XS225"/>

                            <controls:LabeledEntry
                                LabelText="Placa:"
                                Text="{Binding Placa}"
                                Placeholder="Ej. 123-ABC"/>

                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding TieneCaja}">
                                <controls:LabeledEntry
                                    LabelText="Numero de caja:"
                                    Text="{Binding NumeroCaja}"
                                    Placeholder="Ej. CAX-001"/>

                                <controls:LabeledEntry
                                    LabelText="Placa de la caja:"
                                    Text="{Binding PlacaCaja}"
                                    Placeholder="Ej. 123-XYZ"/>

                                <controls:LabeledEntry
                                    LabelText="Sello:"
                                    Text="{Binding Sello}"
                                    Placeholder="Ej. SELLO-01"/>
                            </VerticalStackLayout>

                            <Border BackgroundColor="#EAF2FF"
                                    Stroke="#C7DBFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14"
                                    Margin="0,2,0,0">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding PhotoInstruction}"
                                           TextColor="#0F172A"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>

                                    <Label Text="{Binding PhotoStatusText}"
                                           TextColor="#475569"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>

                            <controls:PhotoGallery
                                ItemsSource="{Binding Photos}"
                                DeleteCommand="{Binding RemovePhotoCommand}"
                                ViewCommand="{Binding ViewPhotoCommand}"
                                Margin="0,6,0,0"
                                MinimumHeightRequest="90"/>

                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="#1B2A3A"
                            Stroke="#0B1B2A"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 26"
                            Padding="14"
                            Margin="0,0,0,12">

                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding PhotoInstruction}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"/>

                                <Label Text="{Binding PhotoStatusText}"
                                       TextColor="#94A3B8"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Text="{Binding CaptureButtonText}"
                                        Command="{Binding CapturarCommand}"
                                        HeightRequest="56"
                                        CornerRadius="18"
                                        BackgroundColor="White"
                                        TextColor="#0F172A"
                                        FontAttributes="Bold"
                                        FontSize="15"/>

                                <Border Grid.Column="1"
                                        BackgroundColor="#102A43"
                                        Stroke="#1E3A5F"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8,7"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GaleriaCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="#1B2A3A"
                                                Stroke="#DDE8F4"
                                                StrokeThickness="1.5"
                                                StrokeShape="RoundRectangle 6"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                Padding="0">
                                            <Label Text="&#x1F5BC;"
                                                   TextColor="White"
                                                   FontSize="15"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="Galeria"
                                               TextColor="White"
                                               FontSize="13"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,14,0,6">
                <Button Text="Atras"
                        Command="{Binding AtrasCommand}"
                        HeightRequest="56" CornerRadius="18"
                        BackgroundColor="#334155" TextColor="White"
                        FontAttributes="Bold" FontSize="18"/>

                <Button Grid.Column="1" Text="Siguiente"
                        Command="{Binding SiguienteCommand}"
                        HeightRequest="56" CornerRadius="18"
                        BackgroundColor="#244A7C" TextColor="White"
                        FontAttributes="Bold" FontSize="18"/>
            </Grid>

        </Grid>

        <controls:LoaderSpinner BindingContext="{Binding Loader}" />
    </Grid>
</ContentPage>
