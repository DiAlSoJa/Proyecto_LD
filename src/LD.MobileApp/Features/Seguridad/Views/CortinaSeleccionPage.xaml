<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
             xmlns:models="clr-namespace:MauiAppLogin.Models"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.CortinaSeleccionPage"
             x:DataType="vm:CortinaSeleccionViewModel"
             x:Name="Root"
             Title="Seleccionar Cortina"
             BackgroundColor="#0F2E4F">

    <Grid>

        <Grid RowDefinitions="Auto,*,Auto" Padding="16">

            <!-- ═══ Encabezado ═══ -->
            <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,10,0,16">
                <Label Text="Cortinas disponibles"
                       FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Selecciona una cortina para asignar al vehículo."
                       FontSize="13" TextColor="#94A3B8"/>
            </VerticalStackLayout>

            <!-- ═══ Lista de cortinas ═══ -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Cortinas}"
                            SelectionMode="Single"
                            SelectedItem="{Binding CortinaSeleccionada, Mode=TwoWay}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="🚫" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="No hay cortinas disponibles"
                               TextColor="#94A3B8" FontSize="15" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Cortina">
                        <Border Stroke="#E2E8F0" StrokeThickness="1"
                                StrokeShape="RoundRectangle 20"
                                Padding="16" Margin="0,0,0,10">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#F6F8FC"/>
                                            <Setter Property="Stroke" Value="#E2E8F0"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}"/>
                                            <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <Border BackgroundColor="#EFF6FF" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="46" HeightRequest="46"
                                        VerticalOptions="Center">
                                    <Label Text="🏭" FontSize="22"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Numero}"
                                           FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Label Text="{Binding Descripcion}"
                                           FontSize="13" TextColor="#64748B"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›" FontSize="32"
                                       TextColor="#244A7C"
                                       VerticalOptions="Center"/>

                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.SeleccionarCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- ═══ Botones ═══ -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,6">

                <Button Text="Cancelar"
                        Command="{Binding CancelarCommand}"
                        HeightRequest="52" CornerRadius="18"
                        BackgroundColor="#334155" TextColor="White"
                        FontAttributes="Bold"/>

                <Button Grid.Column="1"
                        Text="Confirmar"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PuedeConfirmar}"
                        HeightRequest="52" CornerRadius="18"
                        BackgroundColor="#244A7C" TextColor="White"
                        FontAttributes="Bold"/>

            </Grid>

        </Grid>

        <!-- LOADER -->
        <controls:LoaderSpinner BindingContext="{Binding Loader}"/>

    </Grid>
</ContentPage>
