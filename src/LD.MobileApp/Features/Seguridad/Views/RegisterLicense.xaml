<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
    xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
    x:Class="MauiAppLogin.RegisterLicense"
    x:DataType="vm:RegisterLicenseViewModel"
    Title="Licencia"
    BackgroundColor="#0F2E4F">

    <Grid>
        <ScrollView>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" Padding="16">

                <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="6" Margin="0,10,0,6">
                    <Border BackgroundColor="#244A7C" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                        <Label Text="1 Licencia" TextColor="White" FontAttributes="Bold" FontSize="13" />
                    </Border>
                    <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                        <Label Text="2 Vehículo" TextColor="#94A3B8" FontSize="13" />
                    </Border>
                    <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                        <Label Text="3 Firma" TextColor="#94A3B8" FontSize="13" />
                    </Border>
                </HorizontalStackLayout>

                <Border Grid.Row="1"
                        BackgroundColor="#F6F8FC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="18"
                        Margin="0,4,0,12">

                    <VerticalStackLayout Spacing="12">
                        <FlexLayout>
                            <Label TextColor="#64748B" FontSize="18">Tipo: </Label>
                            <Label TextColor="Red" FontSize="18" Text="{Binding Tipo}" Margin="5,0,0,0" />
                        </FlexLayout>

                        <FlexLayout>
                            <Label TextColor="#64748B" FontSize="18">Almacén: </Label>
                            <Label TextColor="#0F172A"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   Text="{Binding WarehouseName}"
                                   Margin="5,0,0,0" />
                        </FlexLayout>

                        <controls:LabeledEntry
                            LabelText="Nombre:"
                            Text="{Binding Nombre}"
                            Placeholder="Ej. Carlos Ramírez"
                            ShowClearButton="True" />

                        <controls:LabeledEntry
                            LabelText="Número de Licencia:"
                            Text="{Binding Licencia}"
                            Placeholder="Ej. 1234567890"
                            ShowClearButton="True" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <controls:LabeledEntry Grid.Column="0"
                                                   LabelText="Vigencia:"
                                                   Text="{Binding VencimientoTexto}"
                                                   Placeholder="dd/MM/yyyy"
                                                   Keyboard="Text"
                                                   ShowClearButton="True" />

                            <controls:LabeledEntry Grid.Column="1"
                                                   LabelText="Celular:"
                                                   Text="{Binding Celular}"
                                                   Placeholder="Ej. 55 1234 5678"
                                                   Keyboard="Telephone" />
                        </Grid>

                        <controls:PhotoGallery
                            ItemsSource="{Binding Photos}"
                            DeleteCommand="{Binding RemovePhotoCommand}"
                            ViewCommand="{Binding ViewPhotoCommand}"
                            Margin="0,6,0,0"
                            MinimumHeightRequest="90" />

                        <VerticalStackLayout Spacing="2" Margin="0,2,0,0">
                            <Label Text="{Binding PhotoInstruction}"
                                   TextColor="#0F172A"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />

                            <Label Text="Verifica que los datos coincidan con la licencia antes de continuar."
                                   TextColor="#64748B"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2"
                        BackgroundColor="#1B2A3A"
                        Stroke="#0B1B2A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="8"
                        Margin="0,0,0,12"
                        VerticalOptions="Start">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Text="Abrir cámara"
                                Command="{Binding CapturarCommand}"
                                IsEnabled="{Binding CanCapturePhoto}"
                                HeightRequest="48"
                                CornerRadius="14"
                                BackgroundColor="#FFFFFF"
                                TextColor="#0F172A"
                                FontAttributes="Bold"
                                FontSize="15" />

                        <Border Grid.Column="1"
                                BackgroundColor="#102A43"
                                Stroke="#DDE8F4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,0"
                                HeightRequest="48">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GaleriaCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="🖼"
                                       TextColor="White"
                                       FontSize="17"
                                       VerticalOptions="Center" />
                                <Label Text="Galería"
                                       TextColor="White"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12"
                      Margin="0,0,0,16">

                    <Button Text="Atrás"
                            Command="{Binding AtrasCommand}"
                            HeightRequest="56"
                            CornerRadius="18"
                            BackgroundColor="#E5E7EB"
                            TextColor="#1E293B"
                            FontAttributes="Bold"
                            FontSize="18" />

                    <Button Grid.Column="1"
                            Text="Siguiente"
                            Command="{Binding SiguienteCommand}"
                            HeightRequest="56"
                            CornerRadius="18"
                            BackgroundColor="#244A7C"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="18" />
                </Grid>

            </Grid>
        </ScrollView>

        <controls:LoaderSpinner BindingContext="{Binding Loader}" />
    </Grid>
</ContentPage>
