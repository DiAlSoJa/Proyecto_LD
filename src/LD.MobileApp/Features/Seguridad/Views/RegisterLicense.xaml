<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
    xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
    x:Class="MauiAppLogin.RegisterLicense"
    x:DataType="vm:RegisterLicenseViewModel"
    Title="Licencia"
    BackgroundColor="#0F2E4F">

    <!-- Grid externo: aísla el loader de la elevation nativa de Android -->
    <Grid>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <!-- ═══ Stepper ═══ -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="6" Margin="0,10,0,6">
            <Border BackgroundColor="#244A7C" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                <Label Text="1 Licencia" TextColor="White" FontAttributes="Bold" FontSize="13"/>
            </Border>
            <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                <Label Text="2 Vehículo" TextColor="#94A3B8" FontSize="13"/>
            </Border>
            <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 14" Padding="12,6" StrokeThickness="0">
                <Label Text="3 Firma" TextColor="#94A3B8" FontSize="13"/>
            </Border>
        </HorizontalStackLayout>

        <!-- Card superior con datos -->
        <Border Grid.Row="1"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="18"
                Margin="0,4,0,12">

            <VerticalStackLayout Spacing="12">
                <FlexLayout>
                    <Label TextColor="#64748B" FontSize="18">Tipo: </Label>
                    <Label TextColor="Red" FontSize="18" Text="{Binding Tipo}" Margin="5,0,0,0"/>
                </FlexLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nombre:" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Entry Text="{Binding Nombre}" Placeholder="Ej. Carlos Ramírez" TextColor="#0F172A"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Número de Licencia:" TextColor="#64748B" FontSize="14"/>
                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                        <Entry Text="{Binding Licencia}" Keyboard="Numeric" Placeholder="Ej. 1234567890" TextColor="#0F172A"/>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Vencimiento:" TextColor="#64748B" FontSize="14"/>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                            <DatePicker Date="{Binding Vencimiento}" TextColor="#0F172A"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Celular:" TextColor="#64748B" FontSize="14"/>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" Padding="12,10">
                            <Entry Text="{Binding Celular}" Keyboard="Telephone" Placeholder="Ej. 55 1234 5678" TextColor="#0F172A"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Miniaturas -->
                <Border BackgroundColor="#EEF3FB"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 18"
                        Padding="10"
                        Margin="0,6,0,0">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="{Binding Thumb1}" WidthRequest="90" HeightRequest="56" Aspect="AspectFill" BackgroundColor="White"/>
                        <Image Source="{Binding Thumb2}" WidthRequest="90" HeightRequest="56" Aspect="AspectFill" BackgroundColor="White"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- Area tipo cámara -->
        <Border Grid.Row="2"
                BackgroundColor="#1B2A3A"
                Stroke="#0B1B2A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26"
                Padding="10"
                VerticalOptions="Start">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

                <!-- Preview -->
                <Grid HeightRequest="78">
                    <Border BackgroundColor="#0F172A"
                            Stroke="#334155"
                            StrokeShape="RoundRectangle 22"
                            Padding="10">

                        <Grid>
                            <!-- Retícula / marco -->
                            <Grid Padding="16,10">
                                <Border Stroke="#FFFFFF"
                                        StrokeThickness="3"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="Transparent"
                                        Opacity="0.35"/>
                            </Grid>
                        </Grid>

                    </Border>
                </Grid>

                <!-- Controles inferiores (Capturar / Galería) -->
                <Grid Row="1" ColumnDefinitions="*,Auto,*" Padding="6,0">
                    <Border Grid.Column="1"
                            BackgroundColor="#102A43"
                            Stroke="#FFFFFF"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 999"
                            WidthRequest="86"
                            HeightRequest="86"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Padding="10">
                        <Button Text=""
                                Command="{Binding CapturarCommand}"
                                BackgroundColor="White"
                                CornerRadius="999"
                                WidthRequest="60"
                                HeightRequest="60"/>
                    </Border>

                    <Border Grid.Column="2"
                            BackgroundColor="#102A43"
                            Stroke="#1E3A5F"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="8,7"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GaleriaCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border BackgroundColor="#1B2A3A"
                                    Stroke="#DDE8F4"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 6"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0">
                                <Label Text="🖼"
                                       TextColor="White"
                                       FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Galería"
                                   TextColor="White"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Margin="0,14,0,6">

            <Button Text="Atrás"
                    Command="{Binding AtrasCommand}"
                    HeightRequest="56"
                    CornerRadius="18"
                    BackgroundColor="#E5E7EB"
                    TextColor="#1E293B"
                    FontAttributes="Bold"
                    FontSize="18"/>

            <Button Grid.Column="1"
                    Text="Siguiente"
                    Command="{Binding SiguienteCommand}"
                    HeightRequest="56"
                    CornerRadius="18"
                    BackgroundColor="#244A7C"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"/>
        </Grid>

    </Grid>

        <!-- LOADER — en Grid externo, encima de todo en Android -->
        <controls:LoaderSpinner BindingContext="{Binding Loader}" />

    </Grid>
</ContentPage>
