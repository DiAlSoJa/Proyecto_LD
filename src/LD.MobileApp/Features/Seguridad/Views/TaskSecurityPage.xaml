<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiAppLogin.ViewModels"
             xmlns:dto="clr-namespace:LD.Contracts.DTOs.Security;assembly=LD.Contracts"
             xmlns:controls="clr-namespace:MauiAppLogin.Views.Controls"
             x:Class="MauiAppLogin.TaskSecurityPage"
             x:DataType="vm:TaskSecurityViewModel"
             x:Name="Root"
             Title="Tareas de cortina"
             BackgroundColor="#0F2E4F">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,10,0,4">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Seguridad"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Solo aparecen tareas pendientes de abrir o cerrar cortina."
                           FontSize="12"
                           TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Actualizar"
                        Command="{Binding CargarCommand}"
                        HeightRequest="42"
                        CornerRadius="14"
                        BackgroundColor="#244A7C"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"/>
            </Grid>

            <Border Grid.Row="1"
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#7F1D1D"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,12">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FCA5A5"
                       FontSize="13"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Tareas}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="10"
                                         Padding="32">
                        <Label Text="Sin tareas pendientes"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"/>
                        <Label Text="Aquí solo verás abrir o cerrar cortina que todavía no se completan."
                               TextColor="#94A3B8"
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:SecurityTaskDto">
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1"
                                BackgroundColor="#F6F8FC"
                                Stroke="#D7E0EC">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Placa}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"/>
                                        <Label Text="{Binding Nombre}"
                                               FontSize="13"
                                               TextColor="#374151"/>
                                        <Label Text="{Binding FechaIniciada, StringFormat='Pendiente desde {0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="11"
                                               TextColor="#94A3B8"/>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="10,5"
                                            BackgroundColor="#FEF9C3"
                                            VerticalOptions="Start">
                                        <Label Text="Pendiente"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#854D0E"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Cortina"
                                               FontSize="11"
                                               TextColor="#64748B"/>
                                        <Label Text="{Binding CortinaNumero}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Tipo"
                                               FontSize="11"
                                               TextColor="#64748B"/>
                                        <Label Text="{Binding TipoVehiculo}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Grid.Row="2"
                                        Command="{Binding BindingContext.SelectTaskCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="52"
                                        CornerRadius="16"
                                        FontAttributes="Bold"
                                        TextColor="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="BackgroundColor" Value="#244A7C"/>
                                            <Setter Property="Text" Value="Abrir cortina"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding TipoAccion}" Value="CerrarRegistro">
                                                    <Setter Property="BackgroundColor" Value="#7C2D12"/>
                                                    <Setter Property="Text" Value="Cerrar cortina"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="3"
                    Text="← Regresar"
                    Command="{Binding AtrasCommand}"
                    HeightRequest="52"
                    CornerRadius="18"
                    BackgroundColor="#334155"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,12,0,6"/>
        </Grid>

        <controls:LoaderSpinner BindingContext="{Binding Loader}"/>
    </Grid>
</ContentPage>
