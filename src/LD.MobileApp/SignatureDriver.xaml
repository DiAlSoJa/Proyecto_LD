<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiAppLogin.SignatureDriver"
             Title="Firma"
             BackgroundColor="#0F2E4F">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Card superior -->
        <Border Grid.Row="0"
                BackgroundColor="#F6F8FC"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="18"
                Margin="0,10,0,12">

            <VerticalStackLayout Spacing="10">

                <Grid ColumnDefinitions="*,Auto,Auto" VerticalOptions="Center">
                    <Label Text="Firma del chofer"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="2"
                            Text="Borrar firma"
                            Clicked="OnClearClicked"
                            BackgroundColor="#E5E7EB"
                            TextColor="#1E293B"
                            CornerRadius="14"
                            HeightRequest="42"
                            Padding="14,0"
                            Margin="10,0,0,0"
                            FontAttributes="Bold"/>
                </Grid>

                <Label Text="Firme dentro del recuadro"
                       FontSize="13"
                       TextColor="#64748B"/>

            </VerticalStackLayout>
        </Border>

        <!-- Área de firma -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#CBD5E1"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 26"
                Padding="10">

            <Grid>

                <!-- DrawingView = pad de firma -->
                <toolkit:DrawingView x:Name="SignaturePad"
                                     BackgroundColor="White"
                                     LineColor="#0F2E4F"
                                     LineWidth="4"
                                     ShouldClearOnFinish="False" />

                <!-- Marco sutil -->
                <Border Stroke="#0F2E4F"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="Transparent"
                        Opacity="0.15" />

            </Grid>
        </Border>

        <!-- Botón Finalizar -->
        <Button Grid.Row="2"
                Text="Finalizar"
                Clicked="OnFinalizarClicked"
                HeightRequest="56"
                Margin="0,14,0,6"
                CornerRadius="18"
                BackgroundColor="#244A7C"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"/>
    </Grid>
</ContentPage>